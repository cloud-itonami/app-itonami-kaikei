(ns kaikei.core
  "kaikei の adapter と値モデル — guest（aiueos/kaikei_journal.cljk）と**同名・
  同引数順・同結果**の判定関数と、その上に建つ帳簿・帳票の純関数。

  ## guest と同じ判定

  `validate-entry` `entry-balanced?` `ledger-balanced?` `account-net`
  `class-valid?` `normal-sign` `period-net` `class-balance` `profit-stage`
  `unclassified-count` `bs-difference` `statement-balanced?`
  `statement-buffer-valid?` は guest の写し。請求書の `rate-base` `rate-tax`
  `invoice-tax` `invoice-total` `rate-net` `tax-share` `invoice-buffer-valid?`
  `registration-format?` `deduction-percent`（第 3 スライス、JUN-321）も同じ。
  明細・消込・仕訳の候補の `days-between` `consumption-rate` `aging-bucket`
  `running-break` `closing-gap` `line-buffer-valid?` `payment-kind`
  `cover-count` `allocate` `date-fit` `match-level` `suggestion-level`
  （第 4 スライス、JUN-327）も同じ。
  入力も出力も整数（vector-i64 は Clojure の vector）で、
  test/fixtures/parity.edn の全行を guest（3 target + wasm）とこちら（kbb）の
  両方が通す。

  ## 値モデル（db）

    {:version 1
     :currency \"JPY\"
     :accounts {\"普通預金\" {:name \"普通預金\" :class :current-asset
                             :class-source :default   ; :vendor :default :user :none
                             :code \"1110\" :qbo {…} :xero {…}}}
     :entries [{:id \"e1\" :date \"2026-04-01\" :number \"1\" :memo \"摘要\"
                :note \"仕訳メモ\" :adjustment? false
                :lines [{:account \"普通預金\" :debit 1000 :credit 0
                         :sub-account … :department … :partner … :description …
                         :tax {:scheme :mf :code \"課税売上 10%\"} :tax-amount 100
                         :invoice {:scheme :mf :code \"適格\"} :tracking [[name option] …]}]
                :origin {:format :mf :row 12}}]
     :invoices [{:id \"i1\" :kind :sales …}]    ; kaikei.invoice の docstring
     :business {:name … :registration …}         ; 自社（請求書の発行者）
     :invoice-settings {…}}

  金額は最小通貨単位の整数（JPY は 1 円、USD は 1 セント）。1 帳簿 1 通貨で、
  通貨の桁は ISO 4217 の小数桁（`currency-exponent`）。日付は \"YYYY-MM-DD\" の
  文字列で持ち、判定に渡すときだけ yyyymmdd の整数にする。

  この ns は I/O を持たない —— 取り込み・書き出しは kaikei.compat.*、保存は
  ブラウザ側の effect。

  ## 各社との関係

  勘定科目の区分への写し方（QBO の AccountType、Xero の Type、日本の勘定科目名）
  と、帳票の数え方（段階利益、繰越損益）は kaikei の規則で、各社の内部の計算の
  再現を主張しない。"
  (:require [kotoba.lang.text :as text]))

;; ───────── 区分 ─────────

(def classes
  "区分。並びは guest の符号（0..14）と同じ。"
  [:unclassified
   :current-asset :non-current-asset :deferred-asset
   :current-liability :non-current-liability :equity
   :revenue :cost-of-sales :operating-expense
   :non-operating-income :non-operating-expense
   :extraordinary-gain :extraordinary-loss :income-tax])

(def class-code (zipmap classes (range)))
(def code->class (zipmap (range) classes))

(def class-label
  {:unclassified "未分類"
   :current-asset "流動資産" :non-current-asset "固定資産" :deferred-asset "繰延資産"
   :current-liability "流動負債" :non-current-liability "固定負債" :equity "純資産"
   :revenue "売上高" :cost-of-sales "売上原価" :operating-expense "販売費及び一般管理費"
   :non-operating-income "営業外収益" :non-operating-expense "営業外費用"
   :extraordinary-gain "特別利益" :extraordinary-loss "特別損失" :income-tax "法人税等"})

(def class-label-en
  {:unclassified "Unclassified"
   :current-asset "Current assets" :non-current-asset "Non-current assets" :deferred-asset "Deferred assets"
   :current-liability "Current liabilities" :non-current-liability "Non-current liabilities" :equity "Equity"
   :revenue "Income" :cost-of-sales "Cost of sales" :operating-expense "Operating expenses"
   :non-operating-income "Other income" :non-operating-expense "Other expenses"
   :extraordinary-gain "Extraordinary gains" :extraordinary-loss "Extraordinary losses"
   :income-tax "Income taxes"})

(defn bs-class? [k] (<= 1 (class-code k 0) 6))
(defn pl-class? [k] (<= 7 (class-code k 0) 14))
(def bs-classes (filterv bs-class? classes))
(def pl-classes (filterv pl-class? classes))

;; ───────── guest と同じ判定（parity） ─────────

(defn- flag [b] (if b 1 0))

(defn validate-entry
  "buf = [debit credit] × n → エラービット（guest と同じ）。"
  [buf]
  (let [n (count buf)]
    (cond
      (zero? n) 1
      (odd? n) 2
      :else
      (loop [i 0 bad 0 total-d 0 total-c 0]
        (if (< i n)
          (let [d (nth buf i)
                c (nth buf (inc i))]
            (recur (+ i 2)
                   (cond
                     (or (neg? d) (neg? c)) (+ bad 4)
                     (and (zero? d) (zero? c)) (+ bad 8)
                     (and (pos? d) (pos? c)) (+ bad 16)
                     :else bad)
                   (+ total-d d)
                   (+ total-c c)))
          (if (= total-d total-c) bad (+ bad 32)))))))

(defn entry-balanced? [buf] (flag (zero? (validate-entry buf))))

(defn ledger-balanced?
  "buf = [account debit credit] × n。"
  [buf]
  (let [n (count buf)]
    (if (zero? (mod n 3))
      (flag (= (reduce + 0 (map #(nth buf %) (range 1 n 3)))
               (reduce + 0 (map #(nth buf %) (range 2 n 3)))))
      0)))

(defn account-net [buf account]
  (reduce + 0 (for [i (range 0 (count buf) 3)
                    :when (= (nth buf i) account)]
                (- (nth buf (+ i 1)) (nth buf (+ i 2))))))

(defn class-valid? [c] (flag (and (integer? c) (<= 1 c 14))))

(defn normal-sign [c]
  (cond
    (zero? (class-valid? c)) 0
    (<= c 3) 1
    (<= c 6) -1
    (#{7 10 12} c) -1
    :else 1))

(defn period-net
  "buf = [date class debit credit] × n。区分 c で from ≤ date ≤ to の
  借方 − 貸方。"
  [buf c from to]
  (let [n (count buf)]
    (loop [i 0 net 0]
      (if (< i n)
        (let [d (nth buf i)]
          (recur (+ i 4)
                 (if (and (= (nth buf (+ i 1)) c) (>= d from) (<= d to))
                   (+ net (- (nth buf (+ i 2)) (nth buf (+ i 3))))
                   net)))
        net))))

(defn class-balance [buf c from to]
  (* (normal-sign c) (period-net buf c from to)))

(defn profit-stages-from
  "区分コード → 正の側で見た残高 の関数から段階利益
  [売上総利益 営業利益 経常利益 税引前当期純利益 当期純利益]。guest の
  profit-stage と同じ式。"
  [bal]
  (let [gross (- (bal 7) (bal 8))
        operating (- gross (bal 9))
        ordinary (- (+ operating (bal 10)) (bal 11))
        pre-tax (- (+ ordinary (bal 12)) (bal 13))
        net (- pre-tax (bal 14))]
    [gross operating ordinary pre-tax net]))

(defn profit-stage [buf stage from to]
  (if (<= 1 stage 5)
    (nth (profit-stages-from #(class-balance buf % from to)) (dec stage))
    0))

(defn unclassified-count [buf]
  (count (for [i (range 0 (count buf) 4)
               :when (zero? (class-valid? (nth buf (+ i 1))))]
           i)))

(defn bs-difference [buf to]
  (reduce + 0 (for [i (range 0 (count buf) 4)
                    :when (and (= 1 (class-valid? (nth buf (+ i 1))))
                               (<= (nth buf i) to))]
                (- (nth buf (+ i 2)) (nth buf (+ i 3))))))

(defn statement-balanced? [buf to]
  (flag (and (zero? (unclassified-count buf)) (zero? (bs-difference buf to)))))

(defn statement-buffer-valid? [buf]
  (let [n (count buf)]
    (flag (and (zero? (mod n 4))
               (every? (fn [i]
                         (let [c (nth buf (+ i 1))]
                           (and (>= (nth buf i) 0)
                                (<= 0 c 14)
                                (>= (nth buf (+ i 2)) 0)
                                (>= (nth buf (+ i 3)) 0))))
                       (range 0 n 4))))))

;; ───────── 請求書の判定（parity。guest と同じ式） ─────────
;;
;; buffer は請求書 1 件 = [rate amount] × n（rate は basis points）。mode 0 税抜・
;; 1 税込・2 税なし、rounding 0 切捨て・1 四捨五入・2 切上げ。掛け算は
;; base = a·d + b に分けて a·rate + R(b·rate / d) にする —— JS の数（2^53 まで
;; 正確）でも guest の i64 でも、同じ値になる。

(defn- magnitude [x] (if (neg? x) (- x) x))

(defn- round-div [n d rounding]
  (let [q (quot n d)
        r (- n (* q d))]
    (case rounding
      0 q
      1 (if (>= (* 2 r) d) (inc q) q)
      (if (pos? r) (inc q) q))))

(defn- scaled [base rate d rounding]
  (let [m (magnitude base)
        a (quot m d)
        b (- m (* a d))
        v (+ (* a rate) (round-div (* b rate) d rounding))]
    (if (neg? base) (- v) v)))

(defn- denominator [mode rate] (if (= mode 0) 10000 (+ 10000 rate)))

(defn- invoice-pairs [buf] (partition 2 buf))

(defn rate-base [buf rate]
  (reduce + 0 (for [[r a] (invoice-pairs buf) :when (= r rate)] a)))

(defn rate-tax [buf rate mode rounding]
  (if (= mode 2)
    0
    (scaled (rate-base buf rate) rate (denominator mode rate) rounding)))

(defn invoice-tax [buf mode rounding]
  (reduce + 0 (map #(rate-tax buf % mode rounding) (distinct (map first (invoice-pairs buf))))))

(defn invoice-total [buf mode rounding]
  (let [sum (reduce + 0 (map second (invoice-pairs buf)))]
    (if (= mode 0) (+ sum (invoice-tax buf mode rounding)) sum)))

(defn rate-net [buf rate mode rounding]
  (if (= mode 1)
    (- (rate-base buf rate) (rate-tax buf rate mode rounding))
    (rate-base buf rate)))

(defn- anchor-line
  "税率 rate の行のうち、金額の絶対値がいちばん大きい行の番号（同じなら上の行）。"
  [buf rate]
  (first (reduce (fn [[best best-mag] [i [r a]]]
                   (if (and (= r rate) (> (magnitude a) best-mag)) [i (magnitude a)] [best best-mag]))
                 [-1 -1]
                 (map-indexed vector (invoice-pairs buf)))))

(defn tax-share [buf line mode rounding]
  (let [pairs (vec (invoice-pairs buf))
        [rate amount] (nth pairs line)
        d (denominator mode rate)]
    (cond
      (= mode 2) 0
      (= (anchor-line buf rate) line)
      (- (rate-tax buf rate mode rounding)
         (reduce + 0 (for [[i [r a]] (map-indexed vector pairs)
                           :when (and (= r rate) (not= i line))]
                       (scaled a rate d 0))))
      :else (scaled amount rate d 0))))

(defn invoice-buffer-valid? [buf]
  (flag (and (even? (count buf))
             (every? (fn [[r a]]
                       (and (<= 0 r 10000)
                            (<= (magnitude a) 900000000000000)
                            (>= (rate-base buf r) 0)))
                     (invoice-pairs buf)))))

(defn registration-format?
  "codes は文字の符号位置の列。「T」（84）＋数字 13 桁の 14 文字なら 1。"
  [codes]
  (flag (and (= 14 (count codes))
             (= 84 (first codes))
             (every? #(<= 48 % 57) (rest codes)))))

(defn deduction-percent
  "仕入税額控除の割合（%）。date は yyyymmdd、qualified は 1／0。国税庁 Q&A
  問 113（令和 8 年 5 月改訂）の経過措置。"
  [date qualified]
  (cond
    (= qualified 1) 100
    (< date 20231001) 100
    (< date 20261001) 80
    (< date 20281001) 70
    (< date 20301001) 50
    (< date 20311001) 30
    :else 0))

;; ───────── 明細・消込・仕訳の候補の判定（parity。guest と同じ式、JUN-327） ─────────
;;
;; 明細の buffer は [amount balance] × n（入金が正）、未消込の請求書の buffer は
;; [open] × n（同じ取引先の残額を期日の順に）。日付は yyyymmdd の整数。

(defn- days-from-civil
  "1970-01-01 からの日数（H. Hinnant の days_from_civil。年は 1 以上）。"
  [date]
  (let [y0 (quot date 10000)
        m (- (quot date 100) (* 100 y0))
        d (- date (* 100 (quot date 100)))
        y (if (<= m 2) (dec y0) y0)
        era (quot y 400)
        yoe (- y (* era 400))
        mp (if (> m 2) (- m 3) (+ m 9))
        doy (+ (quot (+ (* 153 mp) 2) 5) (dec d))
        doe (+ (* yoe 365) (quot yoe 4) (- (quot yoe 100)) doy)]
    (+ (* era 146097) doe -719468)))

(defn days-between [from to] (- (days-from-civil to) (days-from-civil from)))

(defn consumption-rate
  "消費税と地方消費税を合わせた税率（basis points）。kind 0 標準、1 飲食料品
  （軽減）、2 定期購読の新聞（軽減）。確かめた表の外（2014-04-01 より前）と、
  2027-04-01 からの飲食料品（1% にする法案の段階）は -1。"
  [date kind]
  (cond
    (< date 20140401) -1
    (< date 20191001) 800
    (= kind 0) 1000
    (= kind 2) 800
    (< date 20270401) 800
    :else -1))

(defn aging-bucket
  "0 期日前、1 期日から 1〜30 日、2 31〜60 日、3 61〜90 日、4 91 日〜。"
  [due as-of]
  (let [late (days-between due as-of)]
    (cond (<= late 0) 0 (<= late 30) 1 (<= late 60) 2 (<= late 90) 3 :else 4)))

(defn running-break
  "opening から amount を足していき、balance と食い違う最初の行の番号（合えば -1）。"
  [buf opening]
  (loop [i 0 balance opening pairs (partition 2 buf)]
    (if-let [[amount b] (first pairs)]
      (let [next (+ balance amount)]
        (if (= next b) (recur (inc i) next (rest pairs)) i))
      -1)))

(defn closing-gap [buf opening closing]
  (- (reduce + opening (map first (partition 2 buf))) closing))

(defn line-buffer-valid? [buf]
  (flag (and (even? (count buf))
             (every? #(<= (magnitude %) 900000000000000) buf))))

(defn payment-kind
  "0 なし、1 一致、2 手数料の分だけ少ない（0 < due − received ≤ max-fee）、3 一部、4 多い。"
  [due received max-fee]
  (cond
    (or (<= due 0) (<= received 0)) 0
    (= due received) 1
    (> received due) 4
    (<= (- due received) max-fee) 2
    :else 3))

(defn cover-count
  "期日の順の残額 buf の先頭 k 件の和が、received と一致するか手数料の分だけ
  多い最小の k（無ければ 0）。"
  [buf received max-fee]
  (if (<= received 0)
    0
    (loop [i 0 sum 0]
      (if (< i (count buf))
        (let [s (+ sum (nth buf i))
              gap (- s received)]
          (cond
            (<= 0 gap max-fee) (inc i)
            (> gap max-fee) 0
            :else (recur (inc i) s)))
        0))))

(defn allocate
  "期日の順に入金を割り当てたときの、i 件目への額。"
  [buf received i]
  (let [left (- received (reduce + 0 (take i buf)))
        due (nth buf i)]
    (cond (<= left 0) 0 (< left due) left :else due)))

(defn date-fit
  "0 発行日より前（前受）、1 発行日から 期日 + window 日まで、2 それより後。"
  [issue due paid window]
  (cond
    (neg? (days-between issue paid)) 0
    (<= (days-between due paid) window) 1
    :else 2))

(defn match-level
  "候補の強さ（段の順）。kind は payment-kind、ref は摘要に請求書番号があれば 1、
  name は 3 確かめた別名・2 正規化して一致・1 前方一致・0 なし。3 有力、2 中、
  1 弱い、0 出さない。"
  [kind ref name]
  (cond
    (= kind 0) 0
    (#{3 4} kind) (if (or (= ref 1) (>= name 2)) 1 0)
    (or (= ref 1) (>= name 2)) 3
    (= name 1) 2
    :else 1))

(defn suggestion-level
  "学んだ規則の強さ。0 なし、1 弱い（1 回だけ・割合が min-share（basis points）
  未満・金額が幅の外）、2 強い。"
  [hits total min-hits min-share in-range]
  (cond
    (or (<= hits 0) (<= total 0) (> hits total)) 0
    (and (>= hits min-hits) (>= (* hits 10000) (* min-share total)) (= in-range 1)) 2
    :else 1))

;; ───────── 金額 ─────────

(def currency-exponent
  "ISO 4217 の小数桁。ここに無い通貨は取り込まない（桁を推測しない）。"
  {"JPY" 0 "KRW" 0 "VND" 0 "CLP" 0 "ISK" 0 "UGX" 0 "PYG" 0
   "USD" 2 "EUR" 2 "GBP" 2 "AUD" 2 "NZD" 2 "CAD" 2 "SGD" 2 "HKD" 2 "CNY" 2
   "TWD" 2 "CHF" 2 "SEK" 2 "NOK" 2 "DKK" 2 "INR" 2 "THB" 2 "MYR" 2 "PHP" 2
   "IDR" 2 "ZAR" 2 "MXN" 2 "BRL" 2 "PLN" 2 "CZK" 2 "HUF" 2 "ILS" 2 "AED" 2
   "SAR" 2 "TRY" 2 "FJD" 2 "PGK" 2 "WST" 2 "TOP" 2
   "BHD" 3 "KWD" 3 "OMR" 3 "JOD" 3 "TND" 3 "IQD" 3 "LYD" 3})

(defn exponent [currency] (get currency-exponent currency))

(defn- pow10 [e] (reduce * 1 (repeat e 10)))

(def ^:private max-digits
  "整数部と小数部を合わせた桁の上限。JS の数が正確に持てる 2^53 未満に収める。"
  15)

(defn parse-amount
  "文字列か数 → {:amount 最小通貨単位の整数} か {:error :format|:precision|:range}。
  桁区切りのカンマ・空白・通貨記号（¥ ￥ $ € £）は読み飛ばす。先頭の - か ▲、
  または全体を囲む ( ) は負。小数部が通貨の桁より長いとき、余りが 0 で
  なければ :precision（丸めない）。空は {:amount 0}。"
  [x exp]
  (let [s (-> (if (number? x) (str x) (str (or x "")))
              text/trim
              (text/replace #"[,\s¥￥$€£]" ""))]
    (if (= s "")
      {:amount 0}
      (let [[_ open neg int-part frac close] (text/re-matches #"(\()?([-−▲])?(\d+)(?:\.(\d+))?(\))?" s)]
        (cond
          (nil? int-part) {:error :format}
          (not= (some? open) (some? close)) {:error :format}
          :else
          (let [frac (or frac "")
                extra (when (> (count frac) exp) (subs frac exp))
                frac (subs (str frac (apply str (repeat exp "0"))) 0 exp)
                digits (str (text/replace int-part #"^0+(?=\d)" "") frac)]
            (cond
              (and extra (text/re-find #"[1-9]" extra)) {:error :precision}
              (> (count digits) max-digits) {:error :range}
              :else (let [n (parse-long (if (= digits "") "0" digits))]
                      {:amount (if (or open neg) (- n) n)}))))))))

(defn format-amount
  "最小通貨単位 → 10 進の文字列（桁区切りなし）。例: 123456 2 → \"1234.56\"。"
  [n exp]
  (let [neg? (neg? n)
        a (if neg? (- n) n)]
    (str (when neg? "-")
         (if (zero? exp)
           (str a)
           (let [p (pow10 exp)]
             (str (quot a p) "." (text/pad-left (str (rem a p)) exp "0")))))))

(defn display-amount
  "画面用。桁区切りのカンマを入れる。"
  [n exp]
  (let [s (format-amount n exp)
        [_ sign int-part frac] (text/re-matches #"(-?)(\d+)(\.\d+)?" s)
        grouped (text/replace int-part #"\B(?=(\d{3})+(?!\d))" ",")]
    (str sign grouped frac)))

;; ───────── 日付 ─────────

(defn- leap? [y] (and (zero? (mod y 4)) (or (pos? (mod y 100)) (zero? (mod y 400)))))

(defn- days-in-month [y m]
  (case m
    2 (if (leap? y) 29 28)
    (4 6 9 11) 30
    31))

(defn- ymd [y m d]
  (when (and (<= 1900 y 2999) (<= 1 m 12) (<= 1 d (days-in-month y m)))
    (str y "-" (text/pad-left (str m) 2 "0") "-" (text/pad-left (str d) 2 "0"))))

(defn- civil-from-days
  "1970-01-01 からの日数 → [y m d]（H. Hinnant の civil_from_days）。"
  [z]
  (let [z (+ z 719468)
        era (quot (if (>= z 0) z (- z 146096)) 146097)
        doe (- z (* era 146097))
        yoe (quot (- doe (quot doe 1460) (- (quot doe 36524)) (quot doe 146096)) 365)
        y (+ yoe (* era 400))
        doy (- doe (- (+ (* 365 yoe) (quot yoe 4)) (quot yoe 100)))
        mp (quot (+ (* 5 doy) 2) 153)
        d (inc (- doy (quot (+ (* 153 mp) 2) 5)))
        m (if (< mp 10) (+ mp 3) (- mp 9))]
    [(if (<= m 2) (inc y) y) m d]))

(def ^:private era-base {"R" 2018 "H" 1988 "S" 1925 "令和" 2018 "平成" 1988 "昭和" 1925})

(defn parse-date
  "日付の文字列 → \"YYYY-MM-DD\"（読めなければ nil）。受ける形:
  2026-04-01 / 2026/04/01 / 2026/4/1 / 2026.04.01 / 20260401（時刻の後置は
  捨てる）、和暦 R08/04/01・R8.4.1・令和8年4月1日、Xero の MS date
  /Date(1775001600000+0000)/（UTC の日付）。"
  [s]
  (when-let [s (some-> s str text/trim not-empty)]
    (or (when-let [[_ ms] (text/re-matches #"/Date\((-?\d+)(?:[+-]\d{4})?\)/" s)]
          (let [ms (parse-long ms)
                days (quot (- ms (mod ms 86400000)) 86400000)
                [y m d] (civil-from-days days)]
            (ymd y m d)))
        (when-let [[_ y m d] (text/re-matches #"(\d{4})[-/.](\d{1,2})[-/.](\d{1,2})(?:[T ].*)?" s)]
          (ymd (parse-long y) (parse-long m) (parse-long d)))
        (when-let [[_ y m d] (text/re-matches #"(\d{4})(\d{2})(\d{2})" s)]
          (ymd (parse-long y) (parse-long m) (parse-long d)))
        (when-let [[_ e y m d] (text/re-matches #"(R|H|S|令和|平成|昭和)(\d{1,2})[/.年](\d{1,2})[/.月](\d{1,2})日?" s)]
          (ymd (+ (era-base e) (parse-long y)) (parse-long m) (parse-long d))))))

(defn date-int
  "\"2026-04-01\" → 20260401。"
  [date]
  (parse-long (text/replace date "-" "")))

(defn slash-date "\"2026-04-01\" → \"2026/04/01\"。" [date] (text/replace date "-" "/"))

;; ───────── 勘定科目名 → 区分（既定の対応表） ─────────

(def ^:private default-class-names
  "よく使う勘定科目名（MF・freee・弥生の既定の科目表にある名前）と区分。
  対応は kaikei の規則で、科目の性質に依って変えたいものは画面で直す。"
  {:current-asset
   ["現金" "小口現金" "当座預金" "普通預金" "定期預金" "通知預金" "別段預金" "その他預金"
