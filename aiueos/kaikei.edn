;; kaikei 会計 dapp — aiueos アプリ記述子（形は examples/apps/notes.edn に準拠）。
;; 実装の正本: kaikei_journal.cljk / docs/aiueos-dapp.md。
;;
;; 判断コア guest（:effects #{}）を指す。imports は今のところ無し——
;; 仕訳の検証・試算表・P/L・B/S・請求書の税額（税率ごとに 1 回の端数処理、
;; 第 3 スライス JUN-321）の判定は計算だけで、I/O（取り込み・保存・
;; 書き出し）はこの外の層が持つ。:limits の fuel は wasm にも焼き込む
;; （kaikei_journal.policy.edn。amu の既定 512 では帳票の判定が止まる）。
;; aiueos session/grant への配線は未実装（docs/aiueos-dapp.md の未実装境界を参照）。
{:aiueos/component :app/kaikei
 :aiueos/kind :app
 :aiueos/trust :untrusted
 :aiueos/source "kaikei_journal.cljk"
 :aiueos/wasm "kaikei_journal.wasm"
 :aiueos/entry "main"
 :aiueos/args []
 :aiueos/imports #{}
 :aiueos/exports #{:app/main
                   :app/validate-entry
                   :app/entry-balanced?
                   :app/ledger-balanced?
                   :app/account-net
                   :app/class-valid?
                   :app/normal-sign
                   :app/period-net
                   :app/class-balance
                   :app/profit-stage
                   :app/unclassified-count
                   :app/bs-difference
                   :app/statement-balanced?
                   :app/statement-buffer-valid?
                   :app/rate-base
                   :app/rate-tax
                   :app/invoice-tax
                   :app/invoice-total
                   :app/rate-net
                   :app/tax-share
                   :app/invoice-buffer-valid?
                   :app/registration-format?
                   :app/deduction-percent}
 :aiueos/effects #{}
 :aiueos/limits {:memory-pages 16 :fuel 5000000}}
