(ns kaikei.journal
  "kaikei 会計判断コア — aiueos guest（pure judgment, :effects #{}）。

  journal-entry（仕訳検証）と trial-balance（試算表照合）の判定だけを持つ。
  I/O・署名・複製・L2 anchor はこの guest の外（design 正本: docs/aiueos-dapp.md）。
  入力は i64 ベクトルの平坦布局（[debit credit] × n 等）。vector 型を
  使うため KIR v4 / kotoba.typed/externref-v1（typed-value ABI）であり、実行
  host は kototama-browser-host-v1（amu selfhost の typed ホスト）。
  金額は最小通貨単位（JPY は 1 円）の整数。

  バッファ布局:
  - 仕訳 1 件: [debit credit] × n 行
  - 帳簿:      [account debit credit] × n 行
  - 帳票:      [date class debit credit] × n 行（date は yyyymmdd の整数）

  validate-entry のエラービット（0 = 正常。条件は重複しうる）:
    1 :empty       行が無い
    2 :odd-buffer  長さが 2 の倍数でない（壊れた入力）
    4 :negative    金額が負
    8 :zero-line   借方・貸方がともに 0 の行
   16 :both-sides  1 行で借方・貸方がともに正
   32 :unbalanced  借方合計 ≠ 貸方合計

  区分（class）— 帳票の判定はこの符号だけを見る。勘定科目名・各社の型からの
  写し方は adapter（src/kaikei/core.cljk）が持つ:
    0 未分類          帳票に数えない（unclassified-count が数える）
    1 流動資産  2 固定資産  3 繰延資産                     借方が正（B/S）
    4 流動負債  5 固定負債  6 純資産                       貸方が正（B/S）
    7 売上高                10 営業外収益  12 特別利益      貸方が正（P/L）
    8 売上原価  9 販管費    11 営業外費用  13 特別損失
    14 法人税等                                            借方が正（P/L）

  段階利益（profit-stage の stage）:
    1 売上総利益 = 7 − 8      2 営業利益 = 1 − 9
    3 経常利益 = 2 + 10 − 11  4 税引前当期純利益 = 3 + 12 − 13
    5 当期純利益 = 4 − 14     （範囲外の stage は 0）

  B/S の照合は「資産 = 負債 + 純資産 + 損益の累計」。期間で切った損益
  （前期までの繰越分と当期分）の和は累計なので、bs-difference は date ≤ to の
  区分つき行の純額の総和になる（0 なら一致）。

  test-* は test/fixtures/parity.edn の帳票の行を関数ごとに 1 本へ写したもの
  （class-valid? 4 / normal-sign 4 / period-net 5 / class-balance 4 /
    profit-stage 8 / unclassified-count 3 / bs-difference 3 /
    statement-balanced? 3 / statement-buffer-valid? 6）。表を変えたらここも
  変える。test/kaikei/parity_test.cljk がこの関数別件数を表と照合する。
  仕訳 1 件の検証と帳簿の照合（test-valid-entry … test-account-net）も同じ表に
  載っている（validate-entry 7 / entry-balanced? 2 / ledger-balanced? 2 /
  account-net 1）。

  テストは export されたゼロ引数 `test-*`（戻り 1/0。実測で true 返しは
  通らない — and/or/= は整数を返す）。fuel は関数の入口ごとに 1 減る。
  profit-stage は 1 回で帳簿を 7 回なめるので、test-profit-stage（8 回呼ぶ）は
  amu test の既定 512 では足りない（実測: 1000 で不足、2000 で足りる）。
  記述子の実行時の上限は 5,000,000。実行:
  <kotoba-lang>/amu/bin/amu test aiueos/kaikei_journal.cljk --fuel 4096"
  (:export [main validate-entry entry-balanced? ledger-balanced? account-net
            class-valid? normal-sign period-net class-balance profit-stage
            unclassified-count bs-difference statement-balanced?
            statement-buffer-valid?
            test-valid-entry test-empty test-odd-buffer test-negative
            test-zero-line test-both-sides test-unbalanced
            test-entry-balanced test-ledger-balanced test-account-net
            test-class-valid test-normal-sign test-period-net
            test-class-balance test-profit-stage test-unclassified-count
            test-bs-difference test-statement-balanced
            test-statement-buffer-valid]))

(defn main [] :i64
  0)

;; --- 仕訳 1 件の検証: [debit credit] × n ---------------------------------

(defn validate-entry [buf :vector-i64] :i64
  (let [n (vector-count buf)]
    (if (= n 0)
      1
      (if (= n (* 2 (quot n 2)))
        (validate-entry-lines buf n 0 0 0 0)
        2))))

(defn- validate-entry-lines [buf :vector-i64 n :i64 i :i64 bad :i64 total-d :i64 total-c :i64] :i64
  (if (< i n)
    (let [d (vector-at buf i)
          c (vector-at buf (+ i 1))]
      (validate-entry-lines buf n (+ i 2)
                            (if (or (< d 0) (< c 0))
                              (+ bad 4)
                              (if (and (= d 0) (= c 0))
                                (+ bad 8)
                                (if (and (> d 0) (> c 0))
                                  (+ bad 16)
                                  bad)))
                            (+ total-d d)
                            (+ total-c c)))
    (if (= total-d total-c)
      bad
      (+ bad 32))))

(defn entry-balanced? [buf :vector-i64] :i64
  (if (= (validate-entry buf) 0) 1 0))

;; --- 帳簿: [account debit credit] × n ------------------------------------

(defn ledger-balanced? [buf :vector-i64] :i64
  (let [n (vector-count buf)]
    (if (= n (* 3 (quot n 3)))
      (ledger-totals buf n 0 0 0)
      0)))

(defn- ledger-totals [buf :vector-i64 n :i64 i :i64 total-d :i64 total-c :i64] :i64
  (if (< i n)
    (ledger-totals buf n (+ i 3)
                   (+ total-d (vector-at buf (+ i 1)))
                   (+ total-c (vector-at buf (+ i 2))))
    (if (= total-d total-c) 1 0)))

(defn account-net [buf :vector-i64 account :i64] :i64
  (account-net-at buf (vector-count buf) account 0 0))

(defn- account-net-at [buf :vector-i64 n :i64 account :i64 i :i64 net :i64] :i64
  (if (< i n)
    (account-net-at buf n account (+ i 3)
                    (if (= (vector-at buf i) account)
                      (+ net (- (vector-at buf (+ i 1)) (vector-at buf (+ i 2))))
                      net))
    net))

;; --- 帳票: [date class debit credit] × n --------------------------------

(defn class-valid? [c :i64] :i64
  (if (and (>= c 1) (<= c 14)) 1 0))

(defn normal-sign [c :i64] :i64
  (cond
    (= (class-valid? c) 0) 0
    (<= c 3) 1
    (<= c 6) -1
    (or (= c 7) (= c 10) (= c 12)) -1
    :else 1))

(defn period-net [buf :vector-i64 c :i64 from :i64 to :i64] :i64
  (period-net-at buf (vector-count buf) c from to 0 0))

(defn- period-net-at [buf :vector-i64 n :i64 c :i64 from :i64 to :i64 i :i64 net :i64] :i64
  (if (< i n)
    (let [d (vector-at buf i)]
      (period-net-at buf n c from to (+ i 4)
                     (if (and (= (vector-at buf (+ i 1)) c) (>= d from) (<= d to))
                       (+ net (- (vector-at buf (+ i 2)) (vector-at buf (+ i 3))))
                       net)))
    net))

(defn class-balance [buf :vector-i64 c :i64 from :i64 to :i64] :i64
  (* (normal-sign c) (period-net buf c from to)))

(defn profit-stage [buf :vector-i64 stage :i64 from :i64 to :i64] :i64
  (if (and (>= stage 1) (<= stage 5))
    (let [gross (- (class-balance buf 7 from to) (class-balance buf 8 from to))
          operating (- gross (class-balance buf 9 from to))
          ordinary (- (+ operating (class-balance buf 10 from to)) (class-balance buf 11 from to))
          pre-tax (- (+ ordinary (class-balance buf 12 from to)) (class-balance buf 13 from to))
          net (- pre-tax (class-balance buf 14 from to))]
      (cond
        (= stage 1) gross
        (= stage 2) operating
        (= stage 3) ordinary
        (= stage 4) pre-tax
        :else net))
    0))

(defn unclassified-count [buf :vector-i64] :i64
  (unclassified-at buf (vector-count buf) 0 0))

(defn- unclassified-at [buf :vector-i64 n :i64 i :i64 k :i64] :i64
  (if (< i n)
    (unclassified-at buf n (+ i 4) (+ k (- 1 (class-valid? (vector-at buf (+ i 1))))))
    k))

(defn bs-difference [buf :vector-i64 to :i64] :i64
  (bs-difference-at buf (vector-count buf) to 0 0))

(defn- bs-difference-at [buf :vector-i64 n :i64 to :i64 i :i64 net :i64] :i64
  (if (< i n)
    (bs-difference-at buf n to (+ i 4)
                      (if (and (= (class-valid? (vector-at buf (+ i 1))) 1) (<= (vector-at buf i) to))
                        (+ net (- (vector-at buf (+ i 2)) (vector-at buf (+ i 3))))
                        net))
    net))

(defn statement-balanced? [buf :vector-i64 to :i64] :i64
  (if (and (= (unclassified-count buf) 0) (= (bs-difference buf to) 0)) 1 0))

(defn statement-buffer-valid? [buf :vector-i64] :i64
  (let [n (vector-count buf)]
    (if (= n (* 4 (quot n 4)))
      (statement-buffer-at buf n 0)
      0)))

(defn- statement-buffer-at [buf :vector-i64 n :i64 i :i64] :i64
  (if (< i n)
    (let [c (vector-at buf (+ i 1))]
      (if (and (>= (vector-at buf i) 0)
               (>= c 0) (<= c 14)
               (>= (vector-at buf (+ i 2)) 0)
               (>= (vector-at buf (+ i 3)) 0))
        (statement-buffer-at buf n (+ i 4))
        0))
    1))

;; --- tests（戻り 1 = pass） ----------------------------------------------

(defn test-valid-entry [] :i64
  (if (= (validate-entry [100 0 0 100]) 0) 1 0))

(defn test-empty [] :i64
  (if (= (validate-entry []) 1) 1 0))

(defn test-odd-buffer [] :i64
  (if (= (validate-entry [100 0 50]) 2) 1 0))

(defn test-negative [] :i64
  (if (= (validate-entry [100 0 -100 0]) 4) 1 0))

(defn test-zero-line [] :i64
  (if (= (validate-entry [100 0 0 100 0 0]) 8) 1 0))

(defn test-both-sides [] :i64
  (if (= (validate-entry [100 0 50 100 0 50]) 16) 1 0))

(defn test-unbalanced [] :i64
  (if (= (validate-entry [100 0 0 90]) 32) 1 0))

(defn test-entry-balanced [] :i64
  (if (= (+ (entry-balanced? [300 0 0 200 0 100])
            (entry-balanced? [100 0 0 90]))
         1)
    1 0))

(defn test-ledger-balanced [] :i64
  (if (= (+ (ledger-balanced? [1 300 0 2 0 300])
            (ledger-balanced? [1 300 0 2 0 200]))
         1)
    1 0))

(defn test-account-net [] :i64
  (if (= (account-net [1 300 0 2 0 300 1 0 50] 1) 250) 1 0))

;; --- 帳票の tests（test/fixtures/parity.edn の :sample と同じ帳簿） --------
;; 会計年度 2026-04-01〜2027-03-31。期首 2026-03-31 に元入金 1,000,000。
;; 売上 330,000・仕入 110,000・家賃 80,000・受取利息 500・支払利息 2,000・
;; 特別利益 5,000・特別損失 10,000・法人税等 30,000・長期借入 200,000。

(defn- sample-ledger [] :vector-i64
  [20260331 1 1000000 0       20260331 6 0 1000000
   20260401 1 200000 0        20260401 5 0 200000
   20260410 1 330000 0        20260410 7 0 330000
   20260420 8 110000 0        20260420 1 0 110000
   20260525 9 80000 0         20260525 1 0 80000
   20260630 1 500 0           20260630 10 0 500
   20260715 11 2000 0         20260715 1 0 2000
   20260801 13 10000 0        20260801 1 0 10000
   20260901 1 5000 0          20260901 12 0 5000
   20270331 14 30000 0        20270331 4 0 30000])

(defn test-class-valid [] :i64
  (if (and (= (class-valid? 0) 0)
           (= (class-valid? 1) 1)
           (= (class-valid? 14) 1)
           (= (class-valid? 15) 0))
    1 0))

(defn test-normal-sign [] :i64
  (if (and (= (normal-sign 1) 1)
           (= (normal-sign 4) -1)
           (= (normal-sign 7) -1)
           (= (normal-sign 0) 0))
    1 0))

(defn test-period-net [] :i64
  (let [b (sample-ledger)]
    (if (and (= (period-net b 1 0 99991231) 1333500)
             (= (period-net b 1 20260401 20270331) 333500)
             (= (period-net b 7 20260401 20270331) -330000)
             (= (period-net b 6 0 20260331) -1000000)
             (= (period-net b 9 20260601 20260630) 0))
      1 0)))

(defn test-class-balance [] :i64
  (let [b (sample-ledger)]
    (if (and (= (class-balance b 7 20260401 20270331) 330000)
             (= (class-balance b 1 0 99991231) 1333500)
             (= (class-balance b 4 0 99991231) 30000)
             (= (class-balance b 8 20260401 20270331) 110000))
      1 0)))

(defn test-profit-stage [] :i64
  (let [b (sample-ledger)]
    (if (and (= (profit-stage b 1 20260401 20270331) 220000)
             (= (profit-stage b 2 20260401 20270331) 140000)
             (= (profit-stage b 3 20260401 20270331) 138500)
             (= (profit-stage b 4 20260401 20270331) 133500)
             (= (profit-stage b 5 20260401 20270331) 103500)
             (= (profit-stage b 0 20260401 20270331) 0)
             (= (profit-stage b 6 20260401 20270331) 0)
             (= (profit-stage b 5 20260401 20260630) 140500))
      1 0)))

(defn test-unclassified-count [] :i64
  (if (and (= (unclassified-count (sample-ledger)) 0)
           (= (unclassified-count [20260101 0 100 0 20260101 1 0 100]) 1)
           (= (unclassified-count []) 0))
    1 0))

(defn test-bs-difference [] :i64
  (if (and (= (bs-difference (sample-ledger) 20270331) 0)
           (= (bs-difference (sample-ledger) 20260331) 0)
           (= (bs-difference [20260101 0 100 0 20260101 1 0 100] 20261231) -100))
    1 0))

(defn test-statement-balanced [] :i64
  (if (and (= (statement-balanced? (sample-ledger) 20270331) 1)
           (= (statement-balanced? [20260101 0 100 0 20260101 1 0 100] 20261231) 0)
           (= (statement-balanced? [20260101 1 100 0 20260101 7 0 90] 20261231) 0))
    1 0))

(defn test-statement-buffer-valid [] :i64
  (if (and (= (statement-buffer-valid? (sample-ledger)) 1)
           (= (statement-buffer-valid? []) 1)
           (= (statement-buffer-valid? [20260101 1 100]) 0)
           (= (statement-buffer-valid? [20260101 15 100 0]) 0)
           (= (statement-buffer-valid? [20260101 1 -100 0]) 0)
           (= (statement-buffer-valid? [-1 1 100 0]) 0))
    1 0))
