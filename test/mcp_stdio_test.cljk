(ns mcp-stdio-test
  "bin/kaikei-mcp をプロセスとして起こし、itonami agent の MCP クライアント
  （kotoba-lang/itonami-agent の src/itonami/agent/mcp.cljk）と同じやり方で話す:
  initialize → notifications/initialized → 要求 の 3 行を stdin に書いて閉じ、
  stdout の id 2 の行を読む。終了コード 0 でなければ、agent はエラーとして扱う。"
  (:require [cljs.test :refer [deftest is testing]]
            ["child_process" :as cp]
            ["fs" :as fs]
            ["path" :as path]
            [kotoba.lang.text :as text]))

(def server (fs/realpathSync "bin/kaikei-mcp"))

(defn- line [m] (str (.stringify js/JSON (clj->js m)) "\n"))

(defn- exchange
  "agent と同じ 3 行を流して {:status :responses :stderr} を返す。"
  [cwd method params]
  (let [input (str (line {"jsonrpc" "2.0" "id" 1 "method" "initialize"
                          "params" {"protocolVersion" "2024-11-05" "capabilities" {}
                                    "clientInfo" {"name" "itonami-agent" "version" "0.1"}}})
                   (line {"jsonrpc" "2.0" "method" "notifications/initialized" "params" {}})
                   (line {"jsonrpc" "2.0" "id" 2 "method" method "params" params}))
        r (cp/spawnSync "kbb" #js [server]
                        #js {:cwd cwd :input input :encoding "utf8" :timeout 30000
                             :env (js/Object.assign #js {} js/process.env)})]
    {:status (.-status r)
     :stderr (str (.-stderr r))
     :responses (->> (text/split-lines (str (.-stdout r)))
                     (keep #(try (js->clj (.parse js/JSON %)) (catch :default _ nil)))
                     (filter map?)
                     vec)
     :stdout (str (.-stdout r))}))

(defn- by-id [{:keys [responses]} id]
  (first (filter #(= id (get % "id")) responses)))

(deftest lists-tools-from-any-cwd
  (doseq [cwd ["/" (path/dirname (path/dirname server))]]
    (testing (str "cwd " cwd)
      (let [r (exchange cwd "tools/list" {})]
        (is (= 0 (:status r)) (:stderr r))
        (is (= "kaikei" (get-in (by-id r 1) ["result" "serverInfo" "name"])))
        (is (= 11 (count (get-in (by-id r 2) ["result" "tools"]))))
        (testing "stdout は JSON-RPC の行だけ（通知への応答も無い）"
          (is (= 2 (count (:responses r))))
          (is (every? #(= "2.0" (get % "jsonrpc")) (:responses r))))))))

(deftest calls-a-tool-and-exits-zero
  (let [csv (str (fs/readFileSync "test/fixtures/mf.csv" "utf8"))
        r (exchange "/" "tools/call" {"name" "kaikei_import" "arguments" {"text" csv}})
        result (get (by-id r 2) "result")]
    (is (= 0 (:status r)) (:stderr r))
    (is (false? (get result "isError")))
    (is (= "mf" (get-in result ["structuredContent" "format"])))
    (is (= 4 (get-in result ["structuredContent" "entries"])))
    (testing "text と structuredContent は同じ値"
      (is (= (get result "structuredContent")
             (js->clj (.parse js/JSON (get-in result ["content" 0 "text"]))))))))

(deftest imports-into-the-ledger-a-previous-call-returned
  (testing "agent が前の call の帳簿 JSON を次の call に渡す形（プロセスは call ごとに別）"
    (let [first-r (exchange "/" "tools/call" {"name" "kaikei_import"
                                              "arguments" {"text" (str (fs/readFileSync "test/fixtures/mf.csv" "utf8"))}})
          ledger (get-in (by-id first-r 2) ["result" "structuredContent" "ledger"])
          r (exchange "/" "tools/call" {"name" "kaikei_import"
                                        "arguments" {"text" (str (fs/readFileSync "test/fixtures/ofx-bank.ofx" "utf8"))
                                                     "ledger" ledger}})
          out (get-in (by-id r 2) ["result" "structuredContent"])]
      (is (= 0 (:status r)) (:stderr r))
      (is (= [4 3 3] [(get out "entries") (get out "statement_lines") (get-in out ["added" "statement_lines"])])))))

(deftest invalid-input-is-a-tool-error
  (let [r (exchange "/" "tools/call" {"name" "kaikei_report" "arguments" {"report" "balance-sheet"}})
        result (get (by-id r 2) "result")]
    (is (= 0 (:status r)))
    (is (true? (get result "isError")))
    (is (= "invalid-argument" (get (js->clj (.parse js/JSON (get-in result ["content" 0 "text"]))) "error")))))
