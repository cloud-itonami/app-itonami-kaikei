(ns kaikei.compat.native
  "kaikei の帳簿 JSON（\"kaikei.ledger.v1\"）。kaikei の値モデルをそのまま書く、
  失う項目の無い形式。画面の「すべて書き出す」、MCP の tool 間の受け渡し、
  形式をまたぐ変換の中継に使う。

    {\"format\": \"kaikei.ledger.v1\",
     \"currency\": \"JPY\",
     \"accounts\": [{\"name\", \"class\", \"class_source\", \"code\", \"qbo\": {…}, \"xero\": {…}}],
     \"entries\": [{\"id\", \"date\", \"number\", \"memo\", \"note\", \"adjustment\",
                   \"lines\": [{\"account\", \"debit\", \"credit\", \"sub_account\", \"department\",
                              \"partner\", \"partner_type\", \"description\", \"tax\": {\"scheme\", \"code\"},
                              \"tax_amount\", \"invoice\": {\"scheme\", \"code\"},
                              \"tracking\": [[\"名前\", \"選択肢\"]]}],
                   \"origin\": {…}}],
     \"invoices\": [{\"id\", \"kind\", \"number\", \"date\", \"due_date\", \"status\",
                    \"partner\": {\"name\", \"registration\"}, \"subject\", \"tax_mode\", \"rounding\",
                    \"lines\": [{\"description\", \"quantity\", \"unit_price\", \"amount\", \"account\",
                               \"account_code\", \"category\", \"rate\", \"reduced\", \"tax\"}],
                    \"stated\": {\"tax_by_rate\": [{\"rate\", \"reduced\", \"category\", \"tax\"}], \"tax\", \"total\"},
                    \"amount_paid\", \"amount_due\", \"withholding\", \"origin\": {…}}],
     \"business\": {\"name\", \"registration\"},
     \"invoice_settings\": {\"accounting\", \"rounding\", \"accounts\": {\"receivable\", …}},
     \"statement_accounts\": [{\"id\", \"kind\", \"name\", \"ledger_account\", \"key\", \"currency\",
                              \"statement_balance\": {\"amount\", \"date\"}, \"origin\": {…}}],
     \"statement_lines\": [{\"id\", \"account_id\", \"seq\", \"date\", \"amount\", \"balance\",
                           \"description\", \"counterparty\", \"reference\", \"uid\", \"hints\": {…},
                           \"excluded\", \"match\": {\"entry_id\"}, \"origin\": {…}}],
     \"rules\": [{\"id\", \"when\": {\"direction\", \"text\", \"op\", \"min\", \"max\", \"account_id\"},
                \"then\": {\"account\", \"tax\": {\"category\", \"kind\", \"rate\"}, \"partner\", \"qualified\"},
                \"stats\": {\"suggested\", \"accepted\"}}],
     \"statement_settings\": {\"max_fee\", \"fee_treatment\", \"fee_by_partner\": {…}, \"match_window\",
                            \"entry_window\", \"transfer_window\", \"min_hits\", \"min_share\",
                            \"accounts\": {\"fee\", \"discount\"}, \"aliases\": {\"取引先\": […]}}}

  金額は最小通貨単位の整数、税率は basis points（1000 = 10%）。invoices・
  business・invoice_settings は第 3 スライス（JUN-321）、statement_accounts・
  statement_lines・rules・statement_settings は第 4 スライス（JUN-327）で足した
  任意のキーで、版は v1 のまま（無い JSON も読む）。"
  (:require [kotoba.lang.text :as text]
            [kaikei.core :as core]
            [kaikei.json :as json]))

(def format-id "kaikei.ledger.v1")

(defn- kw [s] (when (and (string? s) (not (text/blank? s))) (keyword s)))

(defn- scheme-code [m]
  (when (map? m)
    (let [scheme (kw (get m "scheme")) code (get m "code")]
      (when (and scheme (string? code)) {:scheme scheme :code code}))))

(defn- read-origin [m]
  (when (map? m)
    (into {} (for [[k v] m]
               [(keyword k)
                (cond
                  (and (#{"format" "kind"} k) (string? v)) (keyword v)
                  (= "allocations" k) (vec (for [a v :when (map? a)]
                                             {:invoice-id (get a "invoice-id") :amount (get a "amount" 0)}))
                  :else v)]))))

(defn- line-in [m]
  (cond-> {:account (str (get m "account" ""))
           :debit (get m "debit" 0)
           :credit (get m "credit" 0)}
    (get m "sub_account") (assoc :sub-account (get m "sub_account"))
    (get m "department") (assoc :department (get m "department"))
    (get m "partner") (assoc :partner (get m "partner"))
    (get m "partner_type") (assoc :partner-type (get m "partner_type"))
    (get m "description") (assoc :description (get m "description"))
    (scheme-code (get m "tax")) (assoc :tax (scheme-code (get m "tax")))
    (get m "tax_amount") (assoc :tax-amount (get m "tax_amount"))
    (scheme-code (get m "invoice")) (assoc :invoice (scheme-code (get m "invoice")))
    (seq (get m "tracking")) (assoc :tracking (mapv vec (get m "tracking")))))

(defn- integer-amounts? [m]
  (every? #(let [v (get m % 0)] (and (number? v) (integer? v))) ["debit" "credit"]))

(defn- read-entry [i m]
  (let [lines (get m "lines")]
    (cond
      (not (sequential? lines)) {:problem (str "仕訳 " (inc i) ": lines がありません")}
      (not (every? #(and (map? %) (integer-amounts? %)) lines))
      {:problem (str "仕訳 " (inc i) ": 金額は最小通貨単位の整数で書きます")}
      :else
      {:entry (cond-> {:date (or (core/parse-date (get m "date")) (str (get m "date" "")))
                       :lines (mapv line-in lines)}
                (get m "id") (assoc :id (get m "id"))
                (get m "number") (assoc :number (get m "number"))
                (get m "memo") (assoc :memo (get m "memo"))
                (get m "note") (assoc :note (get m "note"))
                (true? (get m "adjustment")) (assoc :adjustment? true)
                (read-origin (get m "origin")) (assoc :origin (read-origin (get m "origin"))))})))

(defn- read-account [m]
  (let [class (kw (get m "class"))]
    (cond-> {:name (str (get m "name"))}
      (contains? core/class-code class) (assoc :class class
                                               :class-source (or (kw (get m "class_source")) :vendor))
      (get m "code") (assoc :code (get m "code"))
      (map? (get m "qbo")) (assoc :qbo (into {} (for [[k v] (get m "qbo")] [(keyword k) v])))
      (map? (get m "xero")) (assoc :xero (into {} (for [[k v] (get m "xero")] [(keyword k) v]))))))

;; ───────── 請求書 ─────────

(def ^:private invoice-enums
  {"kind" #{:sales :purchase} "status" #{:draft :issued :paid :void}
   "tax_mode" #{:exclusive :inclusive :none} "rounding" #{:floor :half-up :ceil}
   "category" #{:taxable :zero-rated :exempt :out-of-scope}})

(defn- enum [m k default]
  (let [v (kw (get m k))]
    (if (contains? (invoice-enums k) v) v default)))

(defn- integer-value? [v] (and (number? v) (integer? v)))

(defn- invoice-line-in [m]
  (cond-> {:description (str (get m "description" ""))
           :amount (get m "amount" 0)
           :category (enum m "category" :taxable)}
    (get m "quantity") (assoc :quantity (str (get m "quantity")))
    (get m "unit_price") (assoc :unit-price (str (get m "unit_price")))
    (get m "account") (assoc :account (get m "account"))
    (get m "account_code") (assoc :account-code (get m "account_code"))
    (integer-value? (get m "rate")) (assoc :rate (get m "rate"))
    (true? (get m "reduced")) (assoc :reduced? true)
    (scheme-code (get m "tax")) (assoc :tax (scheme-code (get m "tax")))))

(defn- stated-in [m]
  (when (map? m)
    (cond-> {}
      (sequential? (get m "tax_by_rate"))
      (assoc :tax-by-rate (vec (for [r (get m "tax_by_rate") :when (and (map? r) (integer-value? (get r "tax")))]
                                 (cond-> {:tax (get r "tax")}
                                   (integer-value? (get r "rate")) (assoc :rate (get r "rate"))
                                   (true? (get r "reduced")) (assoc :reduced? true)
                                   (kw (get r "category")) (assoc :category (kw (get r "category")))))))
      (integer-value? (get m "tax")) (assoc :tax (get m "tax"))
      (integer-value? (get m "total")) (assoc :total (get m "total")))))

(defn- read-invoice [i m]
  (let [lines (get m "lines")
        where (str "請求書 " (inc i))]
    (cond
      (not (map? m)) {:problem (str where ": オブジェクトではありません")}
      (not (sequential? lines)) {:problem (str where ": lines がありません")}
      (not (every? #(and (map? %) (integer-value? (get % "amount" 0))) lines))
      {:problem (str where ": 金額は最小通貨単位の整数で書きます")}
      (not (contains? #{:sales :purchase} (kw (get m "kind"))))
      {:problem (str where ": kind は sales か purchase です")}
      :else
      {:invoice (cond-> {:kind (enum m "kind" :sales)
                         :number (str (get m "number" ""))
                         :date (or (core/parse-date (get m "date")) (str (get m "date" "")))
                         :status (enum m "status" :draft)
                         :partner (let [p (get m "partner")]
                                    (cond-> {:name (str (get p "name" ""))}
                                      (get p "registration") (assoc :registration (get p "registration"))))
                         :tax-mode (enum m "tax_mode" :exclusive)
                         :rounding (enum m "rounding" :floor)
                         :lines (mapv invoice-line-in lines)}
                  (get m "id") (assoc :id (get m "id"))
                  (core/parse-date (get m "due_date")) (assoc :due-date (core/parse-date (get m "due_date")))
                  (get m "subject") (assoc :subject (get m "subject"))
                  (seq (stated-in (get m "stated"))) (assoc :stated (stated-in (get m "stated")))
                  (integer-value? (get m "amount_paid")) (assoc :amount-paid (get m "amount_paid"))
                  (integer-value? (get m "amount_due")) (assoc :amount-due (get m "amount_due"))
                  (integer-value? (get m "withholding")) (assoc :withholding (get m "withholding"))
                  (read-origin (get m "origin")) (assoc :origin (read-origin (get m "origin"))))})))

(defn- business-in [m]
  (when (map? m)
    (not-empty (cond-> {}
                 (string? (get m "name")) (assoc :name (get m "name"))
                 (string? (get m "registration")) (assoc :registration (get m "registration"))))))

(defn- invoice-settings-in [m]
  (when (map? m)
    (not-empty (cond-> {}
                 (#{:tax-excluded :tax-included} (kw (get m "accounting"))) (assoc :accounting (kw (get m "accounting")))
                 (#{:floor :half-up :ceil} (kw (get m "rounding"))) (assoc :rounding (kw (get m "rounding")))
                 (map? (get m "accounts")) (assoc :accounts (into {} (for [[k v] (get m "accounts") :when (string? v)]
                                                                       [(keyword k) v])))))))

;; ───────── 明細（第 4 スライス、JUN-327） ─────────

(defn- str-or-nil [v] (when (and (string? v) (not (text/blank? v))) v))

(defn- statement-account-in [m]
  (when (and (map? m) (str-or-nil (get m "id")))
    (cond-> {:id (get m "id")
             :kind (or (#{:bank :card :expense} (kw (get m "kind"))) :bank)
             :name (str (get m "name" ""))
             :ledger-account (or (str-or-nil (get m "ledger_account")) "普通預金")}
      (str-or-nil (get m "key")) (assoc :key (get m "key"))
      (str-or-nil (get m "currency")) (assoc :currency (get m "currency"))
      (and (map? (get m "statement_balance")) (integer-value? (get-in m ["statement_balance" "amount"])))
      (assoc :statement-balance {:amount (get-in m ["statement_balance" "amount"])
                                 :date (str (get-in m ["statement_balance" "date"]))})
      (read-origin (get m "origin")) (assoc :origin (read-origin (get m "origin"))))))

(defn- hints-in [m]
  (when (map? m)
    (not-empty (into {} (for [[k v] m :when (some? v)]
                          [(keyword (text/replace (str k) "_" "-")) v])))))

(defn- read-statement-line [i m]
  (let [date (core/parse-date (get m "date"))]
    (cond
      (not (map? m)) {:problem (str "明細の行 " (inc i) ": オブジェクトではありません")}
      (not (str-or-nil (get m "account_id"))) {:problem (str "明細の行 " (inc i) ": account_id がありません")}
      (nil? date) {:problem (str "明細の行 " (inc i) ": 日付が読めません")}
      (not (integer-value? (get m "amount"))) {:problem (str "明細の行 " (inc i) ": 金額は最小通貨単位の整数で書きます")}
      :else
      {:line (cond-> {:account-id (get m "account_id") :date date :amount (get m "amount")}
               (str-or-nil (get m "id")) (assoc :id (get m "id"))
               (integer-value? (get m "seq")) (assoc :seq (get m "seq"))
               (integer-value? (get m "balance")) (assoc :balance (get m "balance"))
               (string? (get m "description")) (assoc :description (get m "description"))
               (str-or-nil (get m "counterparty")) (assoc :counterparty (get m "counterparty"))
               (str-or-nil (get m "reference")) (assoc :reference (get m "reference"))
               (str-or-nil (get m "uid")) (assoc :uid (get m "uid"))
               (hints-in (get m "hints")) (assoc :hints (hints-in (get m "hints")))
               (true? (get m "excluded")) (assoc :excluded? true)
               (str-or-nil (get-in m ["match" "entry_id"])) (assoc :match {:entry-id (get-in m ["match" "entry_id"])})
               (str-or-nil (get m "file_id")) (assoc :file-id (get m "file_id"))
               (read-origin (get m "origin")) (assoc :origin (read-origin (get m "origin"))))})))

(defn- tax-in [m]
  (when (map? m)
    (let [category (kw (get m "category"))]
      (when (#{:taxable :zero-rated :exempt :out-of-scope} category)
        (cond-> {:category category}
          (integer-value? (get m "kind")) (assoc :kind (get m "kind"))
          (integer-value? (get m "rate")) (assoc :rate (get m "rate")))))))

(defn- rule-in [m]
  (let [w (get m "when") t (get m "then")]
    (when (and (map? m) (map? w) (map? t) (str-or-nil (get w "text")) (str-or-nil (get t "account")))
      (cond-> {:when (cond-> {:text (get w "text")
                              :op (or (#{:exact :prefix :suffix :contains} (kw (get w "op"))) :contains)}
                       (#{:in :out} (kw (get w "direction"))) (assoc :direction (kw (get w "direction")))
                       (integer-value? (get w "min")) (assoc :min (get w "min"))
                       (integer-value? (get w "max")) (assoc :max (get w "max"))
                       (str-or-nil (get w "account_id")) (assoc :account-id (get w "account_id")))
               :then (cond-> {:account (get t "account")}
                       (tax-in (get t "tax")) (assoc :tax (tax-in (get t "tax")))
                       (str-or-nil (get t "partner")) (assoc :partner (get t "partner"))
                       (true? (get t "qualified")) (assoc :qualified? true))
               :stats {:suggested (if (integer-value? (get-in m ["stats" "suggested"])) (get-in m ["stats" "suggested"]) 0)
                       :accepted (if (integer-value? (get-in m ["stats" "accepted"])) (get-in m ["stats" "accepted"]) 0)}}
        (str-or-nil (get m "id")) (assoc :id (get m "id"))))))

(defn- statement-settings-in [m]
  (when (map? m)
    (not-empty
     (cond-> {}
       (integer-value? (get m "max_fee")) (assoc :max-fee (get m "max_fee"))
       (#{:return :purchase :discount} (kw (get m "fee_treatment"))) (assoc :fee-treatment (kw (get m "fee_treatment")))
       (map? (get m "fee_by_partner")) (assoc :fee-by-partner (into {} (for [[k v] (get m "fee_by_partner")
                                                                            :when (#{:return :purchase :discount} (kw v))]
                                                                        [k (kw v)])))
       (integer-value? (get m "match_window")) (assoc :match-window (get m "match_window"))
       (integer-value? (get m "entry_window")) (assoc :entry-window (get m "entry_window"))
       (integer-value? (get m "transfer_window")) (assoc :transfer-window (get m "transfer_window"))
       (integer-value? (get m "min_hits")) (assoc :min-hits (get m "min_hits"))
       (integer-value? (get m "min_share")) (assoc :min-share (get m "min_share"))
       (map? (get m "accounts")) (assoc :accounts (into {} (for [[k v] (get m "accounts") :when (string? v)] [(keyword k) v])))
       (map? (get m "aliases")) (assoc :aliases (into {} (for [[k v] (get m "aliases") :when (sequential? v)]
                                                           [k (vec (filter string? v))])))))))

(defn detect? [data] (and (map? data) (= format-id (get data "format"))))

(defn read-data
  "構文解析済みの JSON（文字列キー）→ 取り込み結果。"
  [data]
  (if-not (detect? data)
    {:format :kaikei-json :entries [] :accounts []
     :warnings [(str "\"format\": \"" format-id "\" の JSON ではありません")] :rejected 0}
    (let [currency (get data "currency" "JPY")
          candidates (map-indexed read-entry (get data "entries" []))
          invoices (map-indexed read-invoice (get data "invoices" []))]
      (if-not (core/exponent currency)
        {:format :kaikei-json :entries [] :accounts []
         :warnings [(str "通貨 " currency " の桁を知らないので取り込みません")] :rejected 0}
        (cond-> {:format :kaikei-json
                 :currency currency
                 :accounts (mapv read-account (filter map? (get data "accounts" [])))
                 :entries (vec (keep :entry candidates))
                 :warnings (vec (concat (keep :problem candidates) (keep :problem invoices)))
                 :rejected (count (filter :problem candidates))}
          (contains? data "invoices") (assoc :invoices (vec (keep :invoice invoices))
                                             :invoices-rejected (count (filter :problem invoices)))
          (business-in (get data "business")) (assoc :business (business-in (get data "business")))
          (invoice-settings-in (get data "invoice_settings"))
          (assoc :invoice-settings (invoice-settings-in (get data "invoice_settings")))
          (or (contains? data "statement_lines") (contains? data "statement_accounts"))
          (as-> r (let [ls (map-indexed read-statement-line (get data "statement_lines" []))]
                    (-> r
                        (assoc :statement-accounts (vec (keep statement-account-in (get data "statement_accounts" [])))
                               :statement-lines (vec (keep :line ls)))
                        (update :warnings into (keep :problem ls))
                        (update :rejected + (count (filter :problem ls))))))
          (contains? data "rules") (assoc :rules (vec (keep rule-in (get data "rules" []))))
          (statement-settings-in (get data "statement_settings"))
          (assoc :statement-settings (statement-settings-in (get data "statement_settings"))))))))

(defn- line-out [l]
  (json/ordered
   [["account" (:account l)]
    ["debit" (:debit l 0)]
    ["credit" (:credit l 0)]
    ["sub_account" (:sub-account l)]
    ["department" (:department l)]
    ["partner" (:partner l)]
    ["partner_type" (:partner-type l)]
    ["description" (:description l)]
    ["tax" (when-let [{:keys [scheme code]} (:tax l)] (json/ordered [["scheme" (name scheme)] ["code" code]]))]
    ["tax_amount" (:tax-amount l)]
    ["invoice" (when-let [{:keys [scheme code]} (:invoice l)] (json/ordered [["scheme" (name scheme)] ["code" code]]))]
    ["tracking" (when (seq (:tracking l)) (mapv vec (:tracking l)))]]))

(defn- origin-out [o]
  (when (seq o)
    (json/ordered (for [[k v] (sort-by (comp name key) o)]
                    [(name k) (if (keyword? v) (name v) v)]))))

(defn- vendor-out [m]
  (when (seq m) (json/ordered (for [[k v] (sort-by (comp name key) m)] [(name k) v]))))

(defn- kw-name [v] (when v (name v)))

(defn- invoice-out [inv]
  (json/ordered
   [["id" (:id inv)]
    ["kind" (kw-name (:kind inv))]
    ["number" (:number inv)]
    ["date" (:date inv)]
    ["due_date" (:due-date inv)]
    ["status" (kw-name (:status inv))]
    ["partner" (json/ordered [["name" (get-in inv [:partner :name])]
                              ["registration" (get-in inv [:partner :registration])]])]
    ["subject" (:subject inv)]
    ["tax_mode" (kw-name (:tax-mode inv))]
    ["rounding" (kw-name (:rounding inv))]
    ["lines" (vec (for [l (:lines inv)]
                    (json/ordered [["description" (:description l)]
                                   ["quantity" (:quantity l)]
                                   ["unit_price" (:unit-price l)]
                                   ["amount" (:amount l 0)]
                                   ["account" (:account l)]
                                   ["account_code" (:account-code l)]
                                   ["category" (kw-name (:category l :taxable))]
                                   ["rate" (:rate l)]
                                   ["reduced" (when (:reduced? l) true)]
                                   ["tax" (when-let [{:keys [scheme code]} (:tax l)]
                                            (json/ordered [["scheme" (name scheme)] ["code" code]]))]])))]
    ["stated" (when-let [st (not-empty (:stated inv))]
                (json/ordered [["tax_by_rate" (when (seq (:tax-by-rate st))
                                                (vec (for [r (:tax-by-rate st)]
                                                       (json/ordered [["rate" (:rate r)]
                                                                      ["reduced" (when (:reduced? r) true)]
                                                                      ["category" (kw-name (:category r))]
                                                                      ["tax" (:tax r)]]))))]
                               ["tax" (:tax st)]
                               ["total" (:total st)]]))]
    ["amount_paid" (:amount-paid inv)]
    ["amount_due" (:amount-due inv)]
    ["withholding" (:withholding inv)]
    ["origin" (origin-out (:origin inv))]]))

(defn- statement-account-out [a]
  (json/ordered [["id" (:id a)] ["kind" (kw-name (:kind a))] ["name" (:name a)]
                 ["ledger_account" (:ledger-account a)] ["key" (:key a)] ["currency" (:currency a)]
                 ["statement_balance" (when-let [b (:statement-balance a)]
                                        (json/ordered [["amount" (:amount b)] ["date" (:date b)]]))]
                 ["origin" (origin-out (:origin a))]]))

(defn- statement-line-out [l]
  (json/ordered [["id" (:id l)] ["account_id" (:account-id l)] ["seq" (:seq l)] ["date" (:date l)]
                 ["amount" (:amount l)] ["balance" (:balance l)] ["description" (:description l)]
                 ["counterparty" (:counterparty l)] ["reference" (:reference l)] ["uid" (:uid l)]
                 ["hints" (when (seq (:hints l))
                            (json/ordered (for [[k v] (sort-by (comp name key) (:hints l))]
                                            [(text/replace (name k) "-" "_") (if (keyword? v) (name v) v)])))]
                 ["excluded" (when (:excluded? l) true)]
                 ["match" (when-let [id (get-in l [:match :entry-id])] (json/ordered [["entry_id" id]]))]
                 ["file_id" (:file-id l)]
                 ["origin" (origin-out (:origin l))]]))

(defn- tax-out [t]
  (when t (json/ordered [["category" (kw-name (:category t))] ["kind" (:kind t)] ["rate" (:rate t)]])))

(defn- rule-out [r]
  (json/ordered [["id" (:id r)]
                 ["when" (let [w (:when r)]
                           (json/ordered [["direction" (kw-name (:direction w))] ["text" (:text w)] ["op" (kw-name (:op w))]
                                          ["min" (:min w)] ["max" (:max w)] ["account_id" (:account-id w)]]))]
                 ["then" (let [t (:then r)]
                           (json/ordered [["account" (:account t)] ["tax" (tax-out (:tax t))] ["partner" (:partner t)]
                                          ["qualified" (when (:qualified? t) true)]]))]
                 ["stats" (json/ordered [["suggested" (get-in r [:stats :suggested] 0)]
                                         ["accepted" (get-in r [:stats :accepted] 0)]])]]))

(defn- statement-settings-out [st]
  (json/ordered [["max_fee" (:max-fee st)] ["fee_treatment" (kw-name (:fee-treatment st))]
                 ["fee_by_partner" (when (seq (:fee-by-partner st))
                                     (json/ordered (for [[k v] (sort-by key (:fee-by-partner st))] [k (kw-name v)])))]
                 ["match_window" (:match-window st)] ["entry_window" (:entry-window st)]
                 ["transfer_window" (:transfer-window st)] ["min_hits" (:min-hits st)] ["min_share" (:min-share st)]
                 ["accounts" (when (seq (:accounts st))
                               (json/ordered (for [[k v] (sort-by (comp name key) (:accounts st))] [(name k) v])))]
                 ["aliases" (when (seq (:aliases st))
                              (json/ordered (for [[k v] (sort-by key (:aliases st))] [k (vec v)])))]]))

(defn data
  "db → kaikei.ledger.v1 の値（json/write に渡す形）。"
  [db]
  (json/ordered
   [["format" format-id]
    ["currency" (:currency db)]
    ["accounts" (vec (for [n (sort (keys (:accounts db)))
                           :let [a (get-in db [:accounts n])]]
                       (json/ordered [["name" n]
                                      ["class" (name (:class a :unclassified))]
                                      ["class_source" (some-> (:class-source a) name)]
                                      ["code" (:code a)]
                                      ["qbo" (vendor-out (:qbo a))]
                                      ["xero" (vendor-out (:xero a))]])))]
    ["entries" (vec (for [e (:entries db)]
                      (json/ordered [["id" (:id e)]
                                     ["date" (:date e)]
                                     ["number" (:number e)]
                                     ["memo" (:memo e)]
                                     ["note" (:note e)]
                                     ["adjustment" (when (:adjustment? e) true)]
                                     ["lines" (mapv line-out (:lines e))]
                                     ["origin" (origin-out (:origin e))]])))]
    ["invoices" (mapv invoice-out (:invoices db))]
    ["business" (when-let [b (not-empty (:business db))]
                  (json/ordered [["name" (:name b)] ["registration" (:registration b)]]))]
    ["invoice_settings" (when-let [st (not-empty (:invoice-settings db))]
                          (json/ordered [["accounting" (kw-name (:accounting st))]
                                         ["rounding" (kw-name (:rounding st))]
                                         ["accounts" (when (seq (:accounts st))
                                                       (json/ordered (for [[k v] (sort-by (comp name key) (:accounts st))]
                                                                       [(name k) v])))]]))]
    ["statement_accounts" (when (or (seq (:statement-accounts db)) (seq (:statement-lines db)))
                            (mapv statement-account-out (:statement-accounts db)))]
    ["statement_lines" (when (or (seq (:statement-accounts db)) (seq (:statement-lines db)))
                         (mapv statement-line-out (:statement-lines db)))]
    ["rules" (when (seq (:rules db)) (mapv rule-out (:rules db)))]
    ["statement_settings" (when-let [st (not-empty (:statement-settings db))] (statement-settings-out st))]]))

(defn write [db] (str (json/write (data db)) "\n"))
