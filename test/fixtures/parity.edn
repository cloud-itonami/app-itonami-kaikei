  ;; suggestion-level [hits total min-hits min-share in-range] — 2 強い 1 弱い 0 なし
  {:fn "suggestion-level" :args [3 3 2 7000 1] :expect 2}
  {:fn "suggestion-level" :args [1 1 2 7000 1] :expect 1}
  {:fn "suggestion-level" :args [3 5 2 7000 1] :expect 1}
