(ns kaikei.mcp-test
  "MCP の tool（kaikei.mcp）。stdio を通さず、handle に JSON-RPC の 1 通を渡す。"
  (:require [cljs.test :refer [deftest is testing]]
            ["fs" :as fs]
            [kaikei.encoding :as enc]
            [kaikei.ingest :as ingest]
            [kaikei.mcp :as mcp]
            [kaikei.core]
            [kaikei.compat.native]))

(defn- call [tool args]
  (get (mcp/handle {"jsonrpc" "2.0" "id" 1 "method" "tools/call" "params" {"name" tool "arguments" args}}) "result"))

(defn- ok [tool args]
  (let [r (call tool args)]
    (is (false? (get r "isError")) (str tool " " (get-in r ["content" 0 "text"])))
    (get r "structuredContent")))

(defn- err [tool args]
  (let [r (call tool args)]
    (is (true? (get r "isError")))
    (get (js->clj (.parse js/JSON (get-in r ["content" 0 "text"]))) "error")))

(defn- fixture-text [f] (str (fs/readFileSync (str "test/fixtures/" f) "utf8")))
(defn- fixture-base64 [f] (enc/bytes->base64 (js/Uint8Array. (fs/readFileSync (str "test/fixtures/" f)))))

(deftest lists-eleven-tools
  (let [tools (get-in (mcp/handle {"jsonrpc" "2.0" "id" 1 "method" "tools/list"}) ["result" "tools"])]
    (is (= ["kaikei_import" "kaikei_validate" "kaikei_report" "kaikei_export" "kaikei_convert"
            "kaikei_invoice_totals" "kaikei_invoice_check" "kaikei_invoice_post"
            "kaikei_statement_check" "kaikei_statement_suggest" "kaikei_statement_post"]
           (map #(get % "name") tools)))
    (is (every? #(get-in % ["inputSchema" "type"]) tools))
    (is (not-any? #(contains? % "run") tools))))

(deftest import-validate-report-export
  (let [{:strs [format encoding entries ledger checks]} (ok "kaikei_import" {"bytes_base64" (fixture-base64 "yayoi-sjis.txt")})]
    (is (= "yayoi" format))
    (is (= "shift_jis" encoding))
    (is (= 4 entries))
    (is (true? (get checks "balanced")))
    (is (= "kaikei.ledger.v1" (get ledger "format")))
    (testing "validate"
      (is (= [] (get (ok "kaikei_validate" {"ledger" ledger}) "problems"))))
    (testing "report: 3 つの形"
      (let [pl (ok "kaikei_report" {"ledger" ledger "report" "profit-and-loss" "from" "2026-04-01" "to" "2027-03-31"})]
        ;; 売上高 300,000（税抜）− 消耗品費 11,000 − 地代家賃 80,000 − 法人税等 30,000
        (is (= 179000 (get-in pl ["data" "stages" "net"]))))
      (let [bs (ok "kaikei_report" {"ledger" ledger "report" "balance-sheet" "shape" "qbo"
                                    "from" "2026-04-01" "to" "2027-03-31"})]
        (is (= "BalanceSheet" (get-in bs ["data" "Header" "ReportName"]))))
      (let [tb (ok "kaikei_report" {"ledger" ledger "report" "trial-balance" "shape" "xero"
                                    "from" "2026-04-01" "to" "2027-03-31"})]
        (is (= "TrialBalance" (get-in tb ["data" "Reports" 0 "ReportType"])))))
    (testing "export: Shift_JIS は base64、UTF-8 は text"
      (let [y (ok "kaikei_export" {"ledger" ledger "format" "yayoi"})]
        (is (= "shift_jis" (get y "encoding")))
        (is (string? (get y "bytes_base64")))
        (is (= (:entries (ingest/ingest-bytes (enc/base64->bytes (get y "bytes_base64")) {}))
               (:entries (ingest/ingest-bytes (enc/base64->bytes (fixture-base64 "yayoi-sjis.txt")) {})))))
      (let [x (ok "kaikei_export" {"ledger" ledger "format" "xero-json"})]
        (is (string? (get x "text")))
        (is (seq (get x "notes")))))))

(deftest convert
  (let [r (ok "kaikei_convert" {"text" (fixture-text "qbo-journal.csv") "currency" "USD" "to" "xero-csv"
                                "output_date_order" "dmy"})]
    (is (= "qbo-csv" (get r "from")))
    (is (= 3 (get r "entries")))
    (is (re-find #"15/04/2026" (get r "text")))))

(deftest invalid-input-is-a-tool-error
  (is (= "invalid-argument" (err "kaikei_import" {})))
  (is (= "invalid-argument" (err "kaikei_import" {"text" "a" "bytes_base64" "YQ=="})))
  (is (= "unknown-argument" (err "kaikei_import" {"text" "a" "nope" 1})))
  (is (= "invalid-argument" (err "kaikei_import" {"text" "a" "currency" "XXX"})))
  (is (= "invalid-argument" (err "kaikei_validate" {"ledger" {"format" "other"}})))
  (is (= "invalid-date" (err "kaikei_report" {"ledger" {"format" "kaikei.ledger.v1" "currency" "JPY" "entries" []}
                                              "report" "balance-sheet" "from" "2026-13-01" "to" "2027-03-31"})))
  (is (= "cannot-export" (err "kaikei_export" {"ledger" {"format" "kaikei.ledger.v1" "currency" "USD"
                                                         "entries" [{"date" "2026-04-01"
                                                                     "lines" [{"account" "Cash" "debit" 100 "credit" 0}
                                                                              {"account" "Sales" "debit" 0 "credit" 100}]}]}
                                               "format" "mf"})))
  (testing "5 MiB を超える入力"
    (is (= "input-too-large" (err "kaikei_import" {"text" (apply str (repeat (inc (* 5 1024 1024)) "a"))}))))
  (testing "JSON-RPC の層の誤り"
    (is (= -32602 (get-in (mcp/handle {"jsonrpc" "2.0" "id" 1 "method" "tools/call" "params" {"name" "nope"}})
                          ["error" "code"])))
    (is (= -32601 (get-in (mcp/handle {"jsonrpc" "2.0" "id" 1 "method" "nope"}) ["error" "code"])))
    (is (nil? (mcp/handle {"jsonrpc" "2.0" "method" "notifications/initialized"})))
    (is (re-find #"-32700" (mcp/handle-line "{not json")))))

;; ───────── 請求書（第 3 スライス、JUN-321） ─────────

(deftest invoice-totals
  (testing "国税庁 Q&A 問 57: 税込 60,000（10%）と 40,000（8%、軽減）を切捨て"
    (let [r (ok "kaikei_invoice_totals" {"lines" [{"amount" 60000 "rate" 10} {"amount" "40000" "rate" 8 "reduced" true}]
                                         "tax_mode" "inclusive"})]
      (is (= ["5454" "2962"] (mapv #(str (get % "tax")) (get r "groups"))))
      (is (= ["8416" "100000"] [(str (get r "tax")) (str (get r "total"))]))))
  (testing "行への割り当ては、いちばん大きい行が差を持つ（freee ヘルプの例）"
    (is (= ["42" "211" "188" "22"]
           (mapv str (get (ok "kaikei_invoice_totals" {"lines" (for [a [426 2100 1885 220]] {"amount" a "rate" 10})})
                          "line_tax")))))
  (testing "セントの通貨"
    (is (= "11.45" (str (get (ok "kaikei_invoice_totals" {"lines" [{"amount" "25.06" "rate" 15} {"amount" "25.61" "rate" 15}
                                                                     {"amount" "25.63" "rate" 15}]
                                                            "rounding" "half-up" "currency" "USD"})
                             "tax")))))
  (testing "不正な入力"
    (is (= "invalid-argument" (err "kaikei_invoice_totals" {"lines" []})))
    (is (= "invalid-argument" (err "kaikei_invoice_totals" {"lines" [{"amount" 100}]})))
    (is (= "invalid-argument" (err "kaikei_invoice_totals" {"lines" [{"amount" "abc" "rate" 10}]})))))

(deftest invoice-check-and-post
  (let [{:strs [ledger invoices]} (ok "kaikei_import" {"text" (fixture-text "xero-invoices.json")})
        check (ok "kaikei_invoice_check" {"ledger" ledger})
        by-number (fn [rows n] (first (filter #(= n (get % "number")) rows)))]
    (is (= 4 invoices))
    (testing "Xero の行ごとの丸めの請求書に tax-mismatch"
      (is (some #(= "tax-mismatch" (get % "code")) (get (by-number (get check "invoices") "INV-0102") "problems"))))
    (testing "登録番号の無い受け取った請求書に、経過措置の割合 70%"
      (is (= 70 (get (by-number (get check "invoices") "A-102") "deduction_percent"))))
    (let [posted (ok "kaikei_invoice_post" {"ledger" ledger})
          again (ok "kaikei_invoice_post" {"ledger" (get posted "ledger") "invoice_ids" (get posted "posted")})]
      (testing "発行済み・支払済みを計上する（取消は飛ばす）"
        (is (= 3 (count (get posted "posted"))))
        (is (true? (get-in posted ["checks" "balanced"]))))
      (testing "帳簿 JSON を受け渡しても id が変わらず、二重には計上しない"
        (is (= [] (get again "posted")))
        (is (= #{"already-posted"} (set (map #(get % "reason") (get again "skipped")))))))))

;; ───────── 明細の tools（第 4 スライス、JUN-327） ─────────

(def ^:private sample-ledger
  (let [db (:db (kaikei.core/merge-import kaikei.core/empty-db kaikei.core/sample-import))]
    (js->clj (.parse js/JSON (kaikei.compat.native/write db)))))

(deftest statement-check
  (let [r (ok "kaikei_statement_check" {"ledger" sample-ledger "as_of" "2027-01-31"})
        a (first (get r "accounts"))]
    (is (= ["a1" "サンプル銀行 普通 ****1234" 5 5 {"amount" 977650 "date" "2026-12-25"} 1003500 -25850]
           ((juxt #(get % "id") #(get % "name") #(get % "lines") #(get % "open") #(get % "closing")
                  #(get % "ledger_balance") #(get % "difference")) a)))
    (is (= 5 (get r "open_lines")))
    (is (= [0 0 0 59320 0] (get-in r ["aging" "sales" "totals"])))))

(deftest statement-suggest-and-post
  (let [s (ok "kaikei_statement_suggest" {"ledger" sample-ledger})
        by-id (into {} (map (juxt #(get-in % ["line" "id"]) identity)) (get s "lines"))
        l1 (by-id "l1")]
    (testing "未処理の行ごとの候補。最初から選ぶのは有力が 1 件のとき"
      (is (= ["l1" "l2" "l3" "l4" "l5"] (map #(get-in % ["line" "id"]) (get s "lines"))))
      (is (= 0 (get l1 "preselected")))
      (is (= {"type" "invoice" "allocations" [{"invoice_id" "i1" "amount" 59320}]}
             (get-in l1 ["candidates" 0 "choice"])))
      (is (= [] (get-in by-id ["l4" "candidates"])))
      (is (nil? (get-in by-id ["l5" "preselected"]))))
    (testing "承認した行だけを計上する（choice は候補のもの・自分で作ったもの・\"preselected\"）"
      (let [p (ok "kaikei_statement_post"
                  {"ledger" sample-ledger
                   "approvals" [{"line_id" "l1" "choice" (get-in l1 ["candidates" 0 "choice"])}
                                {"line_id" "l3" "choice" "preselected"}
                                {"line_id" "l4" "choice" {"type" "account" "account" "消耗品費"
                                                          "tax" {"category" "taxable" "kind" 0}}}
                                {"line_id" "l5" "choice" "preselected"}]})]
        (is (= ["l1" "l3" "l4"] (map #(get % "line_id") (get p "posted"))))
        (is (= [{"line_id" "l5" "reason" "no-preselected" "message" "有力の候補が 1 つではありません"}] (get p "skipped")))
        (testing "承認の無い l2 はそのまま（次の suggest でまだ未処理）"
          (let [s2 (ok "kaikei_statement_suggest" {"ledger" (get p "ledger")})]
            (is (= ["l2" "l5"] (map #(get-in % ["line" "id"]) (get s2 "lines"))))))
        (testing "帳簿 JSON の往復で id が変わらない"
          (let [c (ok "kaikei_statement_check" {"ledger" (get p "ledger")})]
            (is (= 3 (get-in c ["accounts" 0 "posted"])))))))
    (testing "入力の不正は tool の error"
      (is (= "invalid-argument" (err "kaikei_statement_post" {"ledger" sample-ledger})))
      (is (= "invalid-argument" (err "kaikei_statement_post" {"ledger" sample-ledger "approvals" [{"line_id" "l1" "choice" {"type" "pay"}}]})))
      (is (= "unknown-argument" (err "kaikei_statement_suggest" {"ledger" sample-ledger "send" true}))))))

(deftest statement-formats-through-mcp
  (let [r (ok "kaikei_import" {"text" (fixture-text "ofx-bank.ofx")})]
    (is (= ["ofx" 3] [(get r "format") (get r "statement_lines")]))
    (let [x (ok "kaikei_export" {"ledger" (get r "ledger") "format" "freee-statement-csv"})]
      (is (re-find #"^取引日,出金額,入金額,残高,取引内容" (get x "text")))))
  (is (= "cannot-export" (err "kaikei_export" {"ledger" sample-ledger "format" "freee-statement-csv" "statement_account" "zz"}))))

(deftest expense-formats-through-mcp
  (let [r (ok "kaikei_import" {"text" (fixture-text "ramp-list.json") "currency" "USD"})]
    (is (= ["ramp-json" 4 1] [(get r "format") (get r "statement_lines") (get r "invoices")])))
  (testing "読むだけの形式は書き出しの形式に無い"
    (is (= "invalid-argument" (err "kaikei_export" {"ledger" sample-ledger "format" "ramp-json"})))))
