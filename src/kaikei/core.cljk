   ["固定資産売却益" "投資有価証券売却益" "貸倒引当金戻入額" "前期損益修正益"]
   :extraordinary-loss
   ["固定資産売却損" "固定資産除却損" "投資有価証券売却損" "減損損失" "災害による損失"
    "前期損益修正損"]
   :income-tax
   ["法人税等" "法人税、住民税及び事業税" "法人税住民税及び事業税" "法人税・住民税及び事業税"
    "法人税等調整額" "Income Tax Expense"]})

(def default-class-by-name
  (into {} (for [[k names] default-class-names, n names] [n k])))

(defn default-class
  "勘定科目名 → 区分（既定の表に無ければ nil）。"
  [account-name]
  (get default-class-by-name (some-> account-name text/trim)))

(def ^:private income-side #{:revenue :non-operating-income :extraordinary-gain})
(def ^:private expense-side #{:cost-of-sales :operating-expense :non-operating-expense
                              :extraordinary-loss :income-tax})

(defn refine-class
  "各社の型から写した区分を、勘定科目名の既定の表で細かくする。P/L の収益側・
  費用側の中でだけ動かす（各社の型は営業外・特別損益・法人税等を区別しない
  ことが多い。例: Xero の EXPENSE は 支払利息 にも 法人税等 にも付く）。
  資産・負債・純資産は各社の型をそのまま使う。"
  [vendor-class account-name]
  (let [named (default-class account-name)]
    (if (or (and (income-side vendor-class) (income-side named))
            (and (expense-side vendor-class) (expense-side named)))
      named
      vendor-class)))

;; ───────── 値モデル ─────────

(def empty-db {:version 1 :currency "JPY" :accounts {} :entries []})

(defn account-class
  "勘定科目の区分。登録が無ければ既定の表、それも無ければ :unclassified。"
  [db account-name]
  (or (get-in db [:accounts account-name :class])
      (default-class account-name)
      :unclassified))

(defn ensure-account
  "勘定科目を登録する（無ければ）。info は取り込み元が知っている属性
  （:class :class-source :code :qbo :xero）。既にあるものは :user の区分を
  上書きしない。取り込み元の区分（:vendor）は既定の表・未分類より強い。"
  [db account-name info]
  (let [existing (get-in db [:accounts account-name])
        incoming (merge {:name account-name} info)
        keep-class? (or (= :user (:class-source existing))
                        (and (= :vendor (:class-source existing))
                             (not= :vendor (:class-source incoming))))
        merged (merge existing
                      (dissoc incoming :class :class-source)
                      (if (and existing keep-class?)
                        (select-keys existing [:class :class-source])
                        (if (:class incoming)
                          (select-keys incoming [:class :class-source])
                          (if-let [k (default-class account-name)]
                            {:class k :class-source :default}
                            (or (not-empty (select-keys existing [:class :class-source]))
                                {:class :unclassified :class-source :none})))))]
    (assoc-in db [:accounts account-name] merged)))

(defn set-class
  "画面からの区分の指定（:user）。"
  [db account-name class]
  (if (contains? class-code class)
    (-> db
        (ensure-account account-name {})
        (update-in [:accounts account-name] assoc :class class :class-source :user))
    db))

(defn used-accounts
  "仕訳に出てくる勘定科目名（出現順を保たず、名前順）。"
  [db]
  (sort (distinct (for [e (:entries db), l (:lines e)] (:account l)))))

(defn unclassified-accounts [db]
  (filterv #(= :unclassified (account-class db %)) (used-accounts db)))

;; ───────── 仕訳の検証 ─────────

(def error-bits
  {:empty 1 :odd-buffer 2 :negative 4 :zero-line 8 :both-sides 16 :unbalanced 32})

(def problem-label
  {:empty "行がありません"
   :odd-buffer "行の形が壊れています"
   :negative "金額が負です"
   :zero-line "借方・貸方がともに 0 の行があります"
   :both-sides "1 行に借方と貸方の両方があります"
   :unbalanced "借方と貸方の合計が一致しません"
   :missing-account "勘定科目が空の行があります"
   :invalid-date "日付が読めません"})

(defn entry-buffer
  "仕訳 → guest の [debit credit] × n。"
  [entry]
  (vec (mapcat (fn [l] [(:debit l 0) (:credit l 0)]) (:lines entry))))

(defn entry-problems
  "仕訳の問題（keyword の集合。空なら正しい）。guest のエラービットに、
  勘定科目と日付の欠けを足したもの。"
  [entry]
  (let [bits (validate-entry (entry-buffer entry))]
    (cond-> (set (keep (fn [[k b]] (when (pos? (bit-and bits b)) k)) error-bits))
      (some #(text/blank? (:account %)) (:lines entry)) (conj :missing-account)
      (nil? (some-> (:date entry) parse-date)) (conj :invalid-date))))

(defn invalid-entries [db]
  (filterv (fn [e] (seq (entry-problems e))) (:entries db)))

(defn entry-totals [entry]
  {:debit (reduce + 0 (map #(:debit % 0) (:lines entry)))
   :credit (reduce + 0 (map #(:credit % 0) (:lines entry)))})

;; ───────── 取り込みの合流 ─────────

(defn- fingerprint
  "重複の判定に使う形。日付と、勘定科目・借方・貸方の多重集合。"
  [entry]
  [(:date entry) (sort (map (juxt :account #(:debit % 0) #(:credit % 0)) (:lines entry)))])

(defn- id-number [entry]
  (or (some->> (:id entry) (text/re-matches #"e(\d+)") second parse-long) 0))

(defn- sort-entries [entries]
  (vec (sort-by (juxt :date id-number) entries)))

(defn merge-import
  "取り込み結果（{:currency :accounts [{:name …}] :entries […]}）を db に合流する。
  mode は :append（既定。同じ日付・同じ行の仕訳は重複として飛ばす）か
  :replace（仕訳と勘定科目を入れ替える。ただし画面で付けた区分は残す）。

  行の :account-code（Xero の CSV のように勘定科目のコードしか無い形式が付ける）は、
  帳簿の勘定科目のコード（:code・:xero :code）で名前に引き直す。

  通貨が違う帳簿へは合流しない（1 帳簿 1 通貨）。戻りは
  {:db :added :duplicates :error}。"
  ([db parsed] (merge-import db parsed :append))
  ([db parsed mode]
   (let [currency (or (:currency parsed) (:currency db))
         base (if (= mode :replace)
                (assoc empty-db :accounts (into {} (filter #(= :user (:class-source (val %))) (:accounts db))))
                db)]
     (if (and (seq (:entries base)) (not= currency (:currency base)))
       {:db db :added 0 :duplicates 0
        :error (str "帳簿の通貨は " (:currency base) " です。" currency " の仕訳は合流しません（1 帳簿 1 通貨）。")}
       (let [base (assoc base :currency currency)
             with-accounts (reduce (fn [d a] (ensure-account d (:name a) (dissoc a :name)))
                                   base (:accounts parsed))
             by-code (into {} (for [[n a] (:accounts with-accounts)
                                    c (distinct (remove nil? [(:code a) (get-in a [:xero :code])]))]
                                [c n]))
             resolve-codes (fn [e]
                             (update e :lines
                                     (fn [ls] (mapv (fn [l]
                                                      (if-let [c (:account-code l)]
                                                        (dissoc (assoc l :account (get by-code c (:account l))) :account-code)
                                                        l))
                                                    ls))))
             ;; 帳簿にコードの登録が無いコードは、そのコードを名前にした勘定科目として
             ;; コードごと登録する（書き出しで同じコードに戻るように）
             unresolved (distinct (for [e (:entries parsed), l (:lines e)
                                        :let [c (:account-code l)]
                                        :when (and c (not (contains? by-code c)))]
                                    c))
             with-accounts (reduce (fn [d c] (ensure-account d c {:code c :xero {:code c}})) with-accounts unresolved)
             parsed-entries (map resolve-codes (:entries parsed))
             seen (set (map fingerprint (:entries with-accounts)))
             first-id (inc (reduce max 0 (map id-number (:entries with-accounts))))
             [db' added dup _]
             (reduce (fn [[d added dup seen] e]
                       (let [fp (fingerprint e)]
                         (if (contains? seen fp)
                           [d added (inc dup) seen]
                           (let [d (reduce (fn [d l] (ensure-account d (:account l) {})) d (:lines e))]
                             [(update d :entries conj (assoc e :id (str "e" (+ first-id added))))
                              (inc added) dup (conj seen fp)]))))
                     [with-accounts 0 0 seen]
                     parsed-entries)]
         {:db (update db' :entries sort-entries)
          :added added :duplicates dup})))))

(defn delete-entry [db id]
  (update db :entries #(filterv (fn [e] (not= id (:id e))) %)))

;; ───────── 帳票 ─────────

(def min-date 0)
(def max-date 99991231)

(defn statement-buffer
  "db → guest の [date class debit credit] × n。"
  [db]
  (let [cls (memoize #(class-code (account-class db %)))]
    (vec (for [e (:entries db)
               :let [d (some-> (:date e) date-int)]
               :when d
               l (:lines e)
               x [d (cls (:account l)) (:debit l 0) (:credit l 0)]]
           x))))

(defn- account-buckets
  "勘定科目ごとの {:before 期首前の純額 :debit 期中借方 :credit 期中貸方}
  （1 回なめるだけ）。"
  [db from to]
  (reduce (fn [acc [d account debit credit]]
            (cond
              (< d from) (update-in acc [account :before] (fnil + 0) (- debit credit))
              (<= d to) (-> acc
                            (update-in [account :debit] (fnil + 0) debit)
                            (update-in [account :credit] (fnil + 0) credit))
              :else acc))
          {}
          (for [e (:entries db)
                :let [d (some-> (:date e) date-int)]
                :when d
                l (:lines e)]
            [d (:account l) (:debit l 0) (:credit l 0)])))

(defn- sort-accounts [db accounts]
  (sort-by (juxt #(class-code (account-class db %)) #(get-in db [:accounts % :code] "") identity) accounts))

(def retained-label "繰越損益（期首前の損益の累計）")

(defn trial-balance
  "残高試算表 [from, to]。行は勘定科目ごとに
  {:account :class :opening :debit :credit :closing}（:opening・:closing は
  借方 − 貸方の純額）。B/S の科目は期首前の累計を :opening に、P/L の科目は
  期間の分だけを数える。期首前の損益は :retained 行（純資産）にまとめる。
  合計は {:debit :credit :closing}（:closing は 0 なら貸借一致）。"
  [db from to]
  (let [buckets (account-buckets db from to)
        rows (vec (for [a (sort-accounts db (keys buckets))
                        :let [{:keys [before debit credit]} (buckets a)
                              k (account-class db a)
                              opening (if (pl-class? k) 0 (or before 0))
                              debit (or debit 0)
                              credit (or credit 0)]
                        :when (or (not (zero? opening)) (pos? debit) (pos? credit))]
                    {:account a :class k :opening opening :debit debit :credit credit
                     :closing (+ opening (- debit credit))}))
        retained (reduce + 0 (for [[a {:keys [before]}] buckets
                                   :when (pl-class? (account-class db a))]
                               (or before 0)))
        rows (cond-> rows
               (not (zero? retained))
               (conj {:account retained-label :class :equity :synthetic :retained
                      :opening retained :debit 0 :credit 0 :closing retained}))]
    {:from from :to to
     :rows rows
     :totals {:debit (reduce + 0 (map :debit rows))
              :credit (reduce + 0 (map :credit rows))
              :closing (reduce + 0 (map :closing rows))}}))

(defn- section
  "区分 k の科目と合計（正の側で見た額）。"
  [db rows k amount-of]
  (let [sign (normal-sign (class-code k))
        accounts (vec (for [r rows
                            :when (= k (:class r))
                            :let [v (* sign (amount-of r))]
                            :when (not (zero? v))]
                        {:account (:account r) :amount v :synthetic (:synthetic r)}))]
    {:class k :accounts accounts :total (reduce + 0 (map :amount accounts))}))

(def stage-keys [:gross :operating :ordinary :pre-tax :net])

(def stage-label
  {:gross "売上総利益" :operating "営業利益" :ordinary "経常利益"
   :pre-tax "税引前当期純利益" :net "当期純利益"})

(defn profit-and-loss
  "損益計算書 [from, to]。{:sections [区分ごと] :stages {:gross … :net}}。
  段階利益は guest の profit-stage と同じ式（profit-stages-from）。"
  [db from to]
  (let [{:keys [rows]} (trial-balance db from to)
        sections (mapv #(section db rows % (fn [r] (- (:debit r) (:credit r)))) pl-classes)
        by-code (into {} (map (fn [s] [(class-code (:class s)) (:total s)]) sections))]
    {:from from :to to
     :sections sections
     :stages (zipmap stage-keys (profit-stages-from #(get by-code % 0)))}))

(defn balance-sheet
  "貸借対照表（to 時点、当期は from から）。{:sections [区分ごと] :retained
  :net-income :totals {:assets :liabilities :equity :difference}}。:equity は
  純資産の科目 + 繰越損益 + 当期純利益。:difference = 資産 − (負債 + 純資産)
  で、0 なら一致（guest の bs-difference と同じ値）。"
  [db from to]
  (let [{:keys [rows]} (trial-balance db from to)
        bs-rows (remove #(= :retained (:synthetic %)) rows)
        sections (mapv #(section db bs-rows % :closing) bs-classes)
        total-of (fn [ks] (reduce + 0 (map :total (filter #((set ks) (:class %)) sections))))
        retained (- (reduce + 0 (map :closing (filter #(= :retained (:synthetic %)) rows))))
        net-income (get-in (profit-and-loss db from to) [:stages :net])
        assets (total-of [:current-asset :non-current-asset :deferred-asset])
        liabilities (total-of [:current-liability :non-current-liability])
        equity (+ (total-of [:equity]) retained net-income)]
    {:from from :to to
     :sections sections
     :retained retained
     :net-income net-income
     :totals {:assets assets :liabilities liabilities :equity equity
              :difference (- assets (+ liabilities equity))}}))

(defn checks
  "帳票の前提の検査。guest と同じ判定を statement-buffer に掛ける。"
  [db to]
  (let [buf (statement-buffer db)]
    {:buffer-valid? (= 1 (statement-buffer-valid? buf))
     :unclassified-lines (unclassified-count buf)
     :unclassified-accounts (unclassified-accounts db)
     :invalid-entries (count (invalid-entries db))
     :bs-difference (bs-difference buf to)
     :balanced? (= 1 (statement-balanced? buf to))}))

;; ───────── 期間 ─────────

(defn date-range
  "仕訳の最初と最後の日付（\"YYYY-MM-DD\"）。仕訳が無ければ nil。"
  [db]
  (let [ds (sort (keep #(some-> (:date %) parse-date) (:entries db)))]
    (when (seq ds) [(first ds) (last ds)])))

(defn fiscal-years
  "仕訳のある会計年度 [{:from :to :label}]（新しい順）。start-month は期首の月
  （1..12）。"
  [db start-month]
  (when-let [[first-d last-d] (date-range db)]
    (let [fy-of (fn [d] (let [y (parse-long (subs d 0 4)) m (parse-long (subs d 5 7))]
                          (if (>= m start-month) y (dec y))))]
      (vec (for [y (range (fy-of last-d) (dec (fy-of first-d)) -1)
                 :let [from (ymd y start-month 1)
                       end-y (if (= start-month 1) y (inc y))
                       end-m (if (= start-month 1) 12 (dec start-month))
                       to (ymd end-y end-m (days-in-month end-y end-m))]]
             {:from from :to to
              :label (if (= start-month 1) (str y " 年") (str y " 年度（" from " 〜 " to "）"))})))))

(defn months
  "仕訳のある月 [{:from :to :label}]（新しい順）。"
  [db]
  (vec (for [ym (reverse (sort (distinct (keep #(some-> (:date %) parse-date (subs 0 7)) (:entries db)))))
             :let [y (parse-long (subs ym 0 4)) m (parse-long (subs ym 5 7))]]
         {:from (ymd y m 1) :to (ymd y m (days-in-month y m)) :label (str y " 年 " m " 月")})))

;; ───────── サンプル ─────────

(def sample-import
  "画面の「サンプルを読み込む」とテストが使う帳簿。guest の sample-ledger と
  同じ数（区分も同じ）。会計年度は 2026-04-01 〜 2027-03-31。"
  (let [e (fn [date memo & lines]
            {:date date :memo memo
             :lines (vec (for [[account debit credit] lines]
                           {:account account :debit debit :credit credit}))})]
    {:format :sample
     :currency "JPY"
     :accounts []
     :entries [(e "2026-03-31" "開始仕訳（元入金）" ["普通預金" 1000000 0] ["元入金" 0 1000000])
               (e "2026-04-01" "設備資金の借入" ["普通預金" 200000 0] ["長期借入金" 0 200000])
               (e "2026-04-10" "4 月分の売上" ["売掛金" 330000 0] ["売上高" 0 330000])
               (e "2026-04-20" "商品の仕入" ["仕入高" 110000 0] ["普通預金" 0 110000])
               (e "2026-05-25" "事務所の家賃" ["地代家賃" 80000 0] ["普通預金" 0 80000])
               (e "2026-06-30" "預金利息" ["普通預金" 500 0] ["受取利息" 0 500])
               (e "2026-07-15" "借入金の利息" ["支払利息" 2000 0] ["普通預金" 0 2000])
               (e "2026-08-01" "備品の売却損" ["固定資産売却損" 10000 0] ["普通預金" 0 10000])
               (e "2026-09-01" "引当金の戻入" ["普通預金" 5000 0] ["貸倒引当金戻入額" 0 5000])
               (e "2027-03-31" "法人税等の計上" ["法人税等" 30000 0] ["未払法人税等" 0 30000])]
     :warnings []}))
