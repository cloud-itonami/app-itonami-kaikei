(ns kaikei.core
  "kaikei の adapter と値モデル — guest（aiueos/kaikei_journal.cljk）と**同名・
  同引数順・同結果**の判定関数と、その上に建つ帳簿・帳票の純関数。

  ## guest と同じ判定

  `validate-entry` `entry-balanced?` `ledger-balanced?` `account-net`
  `class-valid?` `normal-sign` `period-net` `class-balance` `profit-stage`
  `unclassified-count` `bs-difference` `statement-balanced?`
  `statement-buffer-valid?` は guest の写し。入力も出力も整数（vector-i64 は
  Clojure の vector）で、test/fixtures/parity.edn の全行を guest（3 target +
  wasm）とこちら（kbb）の両方が通す。

  ## 値モデル（db）

    {:version 1
     :currency \"JPY\"
     :accounts {\"普通預金\" {:name \"普通預金\" :class :current-asset
                             :class-source :default   ; :vendor :default :user :none
                             :code \"1110\" :qbo {…} :xero {…}}}
     :entries [{:id \"e1\" :date \"2026-04-01\" :number \"1\" :memo \"摘要\"
                :note \"仕訳メモ\" :adjustment? false
                :lines [{:account \"普通預金\" :debit 1000 :credit 0
                         :sub-account … :department … :partner … :description …
                         :tax {:scheme :mf :code \"課税売上 10%\"} :tax-amount 100
                         :invoice {:scheme :mf :code \"適格\"} :tracking [[name option] …]}]
                :origin {:format :mf :row 12}}]}

  金額は最小通貨単位の整数（JPY は 1 円、USD は 1 セント）。1 帳簿 1 通貨で、
  通貨の桁は ISO 4217 の小数桁（`currency-exponent`）。日付は \"YYYY-MM-DD\" の
  文字列で持ち、判定に渡すときだけ yyyymmdd の整数にする。

  この ns は I/O を持たない —— 取り込み・書き出しは kaikei.compat.*、保存は
  ブラウザ側の effect。

  ## 各社との関係

  勘定科目の区分への写し方（QBO の AccountType、Xero の Type、日本の勘定科目名）
  と、帳票の数え方（段階利益、繰越損益）は kaikei の規則で、各社の内部の計算の
  再現を主張しない。"
  (:require [kotoba.lang.text :as text]))

;; ───────── 区分 ─────────

(def classes
  "区分。並びは guest の符号（0..14）と同じ。"
  [:unclassified
   :current-asset :non-current-asset :deferred-asset
   :current-liability :non-current-liability :equity
   :revenue :cost-of-sales :operating-expense
   :non-operating-income :non-operating-expense
   :extraordinary-gain :extraordinary-loss :income-tax])

(def class-code (zipmap classes (range)))
(def code->class (zipmap (range) classes))

(def class-label
  {:unclassified "未分類"
   :current-asset "流動資産" :non-current-asset "固定資産" :deferred-asset "繰延資産"
   :current-liability "流動負債" :non-current-liability "固定負債" :equity "純資産"
   :revenue "売上高" :cost-of-sales "売上原価" :operating-expense "販売費及び一般管理費"
   :non-operating-income "営業外収益" :non-operating-expense "営業外費用"
   :extraordinary-gain "特別利益" :extraordinary-loss "特別損失" :income-tax "法人税等"})

(def class-label-en
  {:unclassified "Unclassified"
   :current-asset "Current assets" :non-current-asset "Non-current assets" :deferred-asset "Deferred assets"
   :current-liability "Current liabilities" :non-current-liability "Non-current liabilities" :equity "Equity"
   :revenue "Income" :cost-of-sales "Cost of sales" :operating-expense "Operating expenses"
   :non-operating-income "Other income" :non-operating-expense "Other expenses"
   :extraordinary-gain "Extraordinary gains" :extraordinary-loss "Extraordinary losses"
   :income-tax "Income taxes"})

(defn bs-class? [k] (<= 1 (class-code k 0) 6))
(defn pl-class? [k] (<= 7 (class-code k 0) 14))
(def bs-classes (filterv bs-class? classes))
(def pl-classes (filterv pl-class? classes))

;; ───────── guest と同じ判定（parity） ─────────

(defn- flag [b] (if b 1 0))

(defn validate-entry
  "buf = [debit credit] × n → エラービット（guest と同じ）。"
  [buf]
  (let [n (count buf)]
    (cond
      (zero? n) 1
      (odd? n) 2
      :else
      (loop [i 0 bad 0 total-d 0 total-c 0]
        (if (< i n)
          (let [d (nth buf i)
                c (nth buf (inc i))]
            (recur (+ i 2)
                   (cond
                     (or (neg? d) (neg? c)) (+ bad 4)
                     (and (zero? d) (zero? c)) (+ bad 8)
                     (and (pos? d) (pos? c)) (+ bad 16)
                     :else bad)
                   (+ total-d d)
                   (+ total-c c)))
          (if (= total-d total-c) bad (+ bad 32)))))))

(defn entry-balanced? [buf] (flag (zero? (validate-entry buf))))

(defn ledger-balanced?
  "buf = [account debit credit] × n。"
  [buf]
  (let [n (count buf)]
    (if (zero? (mod n 3))
      (flag (= (reduce + 0 (map #(nth buf %) (range 1 n 3)))
               (reduce + 0 (map #(nth buf %) (range 2 n 3)))))
      0)))

(defn account-net [buf account]
  (reduce + 0 (for [i (range 0 (count buf) 3)
                    :when (= (nth buf i) account)]
                (- (nth buf (+ i 1)) (nth buf (+ i 2))))))

(defn class-valid? [c] (flag (and (integer? c) (<= 1 c 14))))

(defn normal-sign [c]
  (cond
    (zero? (class-valid? c)) 0
    (<= c 3) 1
    (<= c 6) -1
    (#{7 10 12} c) -1
    :else 1))

(defn period-net
  "buf = [date class debit credit] × n。区分 c で from ≤ date ≤ to の
  借方 − 貸方。"
  [buf c from to]
  (let [n (count buf)]
    (loop [i 0 net 0]
      (if (< i n)
        (let [d (nth buf i)]
          (recur (+ i 4)
                 (if (and (= (nth buf (+ i 1)) c) (>= d from) (<= d to))
                   (+ net (- (nth buf (+ i 2)) (nth buf (+ i 3))))
                   net)))
        net))))

(defn class-balance [buf c from to]
  (* (normal-sign c) (period-net buf c from to)))

(defn profit-stages-from
  "区分コード → 正の側で見た残高 の関数から段階利益
  [売上総利益 営業利益 経常利益 税引前当期純利益 当期純利益]。guest の
  profit-stage と同じ式。"
  [bal]
  (let [gross (- (bal 7) (bal 8))
        operating (- gross (bal 9))
        ordinary (- (+ operating (bal 10)) (bal 11))
        pre-tax (- (+ ordinary (bal 12)) (bal 13))
        net (- pre-tax (bal 14))]
    [gross operating ordinary pre-tax net]))

(defn profit-stage [buf stage from to]
  (if (<= 1 stage 5)
    (nth (profit-stages-from #(class-balance buf % from to)) (dec stage))
    0))

(defn unclassified-count [buf]
  (count (for [i (range 0 (count buf) 4)
               :when (zero? (class-valid? (nth buf (+ i 1))))]
           i)))

(defn bs-difference [buf to]
  (reduce + 0 (for [i (range 0 (count buf) 4)
                    :when (and (= 1 (class-valid? (nth buf (+ i 1))))
                               (<= (nth buf i) to))]
                (- (nth buf (+ i 2)) (nth buf (+ i 3))))))

(defn statement-balanced? [buf to]
  (flag (and (zero? (unclassified-count buf)) (zero? (bs-difference buf to)))))

(defn statement-buffer-valid? [buf]
  (let [n (count buf)]
    (flag (and (zero? (mod n 4))
               (every? (fn [i]
                         (let [c (nth buf (+ i 1))]
                           (and (>= (nth buf i) 0)
                                (<= 0 c 14)
                                (>= (nth buf (+ i 2)) 0)
                                (>= (nth buf (+ i 3)) 0))))
                       (range 0 n 4))))))

;; ───────── 金額 ─────────

(def currency-exponent
  "ISO 4217 の小数桁。ここに無い通貨は取り込まない（桁を推測しない）。"
  {"JPY" 0 "KRW" 0 "VND" 0 "CLP" 0 "ISK" 0 "UGX" 0 "PYG" 0
   "USD" 2 "EUR" 2 "GBP" 2 "AUD" 2 "NZD" 2 "CAD" 2 "SGD" 2 "HKD" 2 "CNY" 2
   "TWD" 2 "CHF" 2 "SEK" 2 "NOK" 2 "DKK" 2 "INR" 2 "THB" 2 "MYR" 2 "PHP" 2
   "IDR" 2 "ZAR" 2 "MXN" 2 "BRL" 2 "PLN" 2 "CZK" 2 "HUF" 2 "ILS" 2 "AED" 2
   "SAR" 2 "TRY" 2 "FJD" 2 "PGK" 2 "WST" 2 "TOP" 2
   "BHD" 3 "KWD" 3 "OMR" 3 "JOD" 3 "TND" 3 "IQD" 3 "LYD" 3})

(defn exponent [currency] (get currency-exponent currency))

(defn- pow10 [e] (reduce * 1 (repeat e 10)))

(def ^:private max-digits
  "整数部と小数部を合わせた桁の上限。JS の数が正確に持てる 2^53 未満に収める。"
  15)

(defn parse-amount
  "文字列か数 → {:amount 最小通貨単位の整数} か {:error :format|:precision|:range}。
  桁区切りのカンマ・空白・通貨記号（¥ ￥ $ € £）は読み飛ばす。先頭の - か ▲、
  または全体を囲む ( ) は負。小数部が通貨の桁より長いとき、余りが 0 で
  なければ :precision（丸めない）。空は {:amount 0}。"
  [x exp]
  (let [s (-> (if (number? x) (str x) (str (or x "")))
              text/trim
              (text/replace #"[,\s¥￥$€£]" ""))]
    (if (= s "")
      {:amount 0}
      (let [[_ open neg int-part frac close] (text/re-matches #"(\()?([-−▲])?(\d+)(?:\.(\d+))?(\))?" s)]
        (cond
          (nil? int-part) {:error :format}
          (not= (some? open) (some? close)) {:error :format}
          :else
          (let [frac (or frac "")
                extra (when (> (count frac) exp) (subs frac exp))
                frac (subs (str frac (apply str (repeat exp "0"))) 0 exp)
                digits (str (text/replace int-part #"^0+(?=\d)" "") frac)]
            (cond
              (and extra (text/re-find #"[1-9]" extra)) {:error :precision}
              (> (count digits) max-digits) {:error :range}
              :else (let [n (parse-long (if (= digits "") "0" digits))]
                      {:amount (if (or open neg) (- n) n)}))))))))

(defn format-amount
  "最小通貨単位 → 10 進の文字列（桁区切りなし）。例: 123456 2 → \"1234.56\"。"
  [n exp]
  (let [neg? (neg? n)
        a (if neg? (- n) n)]
    (str (when neg? "-")
         (if (zero? exp)
           (str a)
           (let [p (pow10 exp)]
             (str (quot a p) "." (text/pad-left (str (rem a p)) exp "0")))))))

(defn display-amount
  "画面用。桁区切りのカンマを入れる。"
  [n exp]
  (let [s (format-amount n exp)
        [_ sign int-part frac] (text/re-matches #"(-?)(\d+)(\.\d+)?" s)
        grouped (text/replace int-part #"\B(?=(\d{3})+(?!\d))" ",")]
    (str sign grouped frac)))

;; ───────── 日付 ─────────

(defn- leap? [y] (and (zero? (mod y 4)) (or (pos? (mod y 100)) (zero? (mod y 400)))))

(defn- days-in-month [y m]
  (case m
    2 (if (leap? y) 29 28)
    (4 6 9 11) 30
    31))

(defn- ymd [y m d]
  (when (and (<= 1900 y 2999) (<= 1 m 12) (<= 1 d (days-in-month y m)))
    (str y "-" (text/pad-left (str m) 2 "0") "-" (text/pad-left (str d) 2 "0"))))

(defn- civil-from-days
  "1970-01-01 からの日数 → [y m d]（H. Hinnant の civil_from_days）。"
  [z]
  (let [z (+ z 719468)
        era (quot (if (>= z 0) z (- z 146096)) 146097)
        doe (- z (* era 146097))
        yoe (quot (- doe (quot doe 1460) (- (quot doe 36524)) (quot doe 146096)) 365)
        y (+ yoe (* era 400))
        doy (- doe (- (+ (* 365 yoe) (quot yoe 4)) (quot yoe 100)))
        mp (quot (+ (* 5 doy) 2) 153)
        d (inc (- doy (quot (+ (* 153 mp) 2) 5)))
        m (if (< mp 10) (+ mp 3) (- mp 9))]
    [(if (<= m 2) (inc y) y) m d]))

(def ^:private era-base {"R" 2018 "H" 1988 "S" 1925 "令和" 2018 "平成" 1988 "昭和" 1925})

(defn parse-date
  "日付の文字列 → \"YYYY-MM-DD\"（読めなければ nil）。受ける形:
  2026-04-01 / 2026/04/01 / 2026/4/1 / 2026.04.01 / 20260401（時刻の後置は
  捨てる）、和暦 R08/04/01・R8.4.1・令和8年4月1日、Xero の MS date
  /Date(1775001600000+0000)/（UTC の日付）。"
  [s]
  (when-let [s (some-> s str text/trim not-empty)]
    (or (when-let [[_ ms] (text/re-matches #"/Date\((-?\d+)(?:[+-]\d{4})?\)/" s)]
          (let [ms (parse-long ms)
                days (quot (- ms (mod ms 86400000)) 86400000)
                [y m d] (civil-from-days days)]
            (ymd y m d)))
        (when-let [[_ y m d] (text/re-matches #"(\d{4})[-/.](\d{1,2})[-/.](\d{1,2})(?:[T ].*)?" s)]
          (ymd (parse-long y) (parse-long m) (parse-long d)))
        (when-let [[_ y m d] (text/re-matches #"(\d{4})(\d{2})(\d{2})" s)]
          (ymd (parse-long y) (parse-long m) (parse-long d)))
        (when-let [[_ e y m d] (text/re-matches #"(R|H|S|令和|平成|昭和)(\d{1,2})[/.年](\d{1,2})[/.月](\d{1,2})日?" s)]
          (ymd (+ (era-base e) (parse-long y)) (parse-long m) (parse-long d))))))

(defn date-int
  "\"2026-04-01\" → 20260401。"
  [date]
  (parse-long (text/replace date "-" "")))

(defn slash-date "\"2026-04-01\" → \"2026/04/01\"。" [date] (text/replace date "-" "/"))

;; ───────── 勘定科目名 → 区分（既定の対応表） ─────────

