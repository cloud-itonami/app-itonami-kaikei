;; kaikei の parity fixture — guest（aiueos/kaikei_journal.cljk）と adapter
;; （src/kaikei/core.cljk）が同じ入力に同じ i64 を返すことの表。
;;
;; 3 か所がこの表を読む / 写す:
;;   1. test/kaikei/parity_test.cljk       — adapter で全行を照合する（kbb）
;;   2. aiueos/kaikei_journal.cljk の test-* — 同じ行を手で写す（amu test、3 target）
;;   3. test/guest_parity.mjs              — 同じ表を wasm（kototama-browser-host-v1）で回す
;;
;; 行を足したら 2 も足す。件数は parity_test が数えて guest の docstring と照合する。
;;
;; :buffers の名前（keyword）は :args の中でその buffer に置き換わる。
;; :sample は guest の sample-ledger と同じ帳簿（[date class debit credit] × 20 行）。
;; 明細の buffer は [amount balance] × n、未消込の請求書の buffer は [open] × n
;; （第 4 スライス、JUN-327。行は guest の test-* から写した）。
;; 区分: 1 流動資産 … 6 純資産、7 売上高 … 14 法人税等（guest の docstring）。
;;
;; 請求書の buffer は [rate amount] × n（rate は basis points）。mode 0 税抜・
;; 1 税込・2 税なし、rounding 0 切捨て・1 四捨五入・2 切上げ。例の出所:
;;   :freee         freee ヘルプ 23500770784153（10%: 426・2,100・1,885・220 → 463、
;;                  いちばん大きい行が差を持つ）
;;   :nta57         国税庁 Q&A 問 57（税込 10% 60,000 → 5,454、8% 40,000 → 2,962）
;;   :xero-rounding Xero「Rounding in Xero」（15%: 25.06・25.61・25.63。行ごとの
;;                  丸めの和は 11.44、税率ごとに 1 回なら 11.45）
{:buffers
 {:sample [20260331 1 1000000 0       20260331 6 0 1000000
           20260401 1 200000 0        20260401 5 0 200000
           20260410 1 330000 0        20260410 7 0 330000
           20260420 8 110000 0        20260420 1 0 110000
           20260525 9 80000 0         20260525 1 0 80000
           20260630 1 500 0           20260630 10 0 500
           20260715 11 2000 0         20260715 1 0 2000
           20260801 13 10000 0        20260801 1 0 10000
           20260901 1 5000 0          20260901 12 0 5000
           20270331 14 30000 0        20270331 4 0 30000]
  :unclassified [20260101 0 100 0 20260101 1 0 100]
  :unbalanced [20260101 1 100 0 20260101 7 0 90]
  :mixed [1000 50000 1000 33333 800 12345]
  :freee [1000 426 1000 2100 1000 1885 1000 220]
  :nta57 [1000 60000 800 40000]
  :xero-rounding [1500 2506 1500 2561 1500 2563]
  :discount [1000 1000 800 1080 1000 -100]}

 :rows
 [;; validate-entry [debit credit] × n → エラービット
  {:fn "validate-entry" :args [[100 0 0 100]] :expect 0}
  {:fn "validate-entry" :args [[]] :expect 1}
  {:fn "validate-entry" :args [[100 0 50]] :expect 2}
  {:fn "validate-entry" :args [[100 0 -100 0]] :expect 4}
  {:fn "validate-entry" :args [[100 0 0 100 0 0]] :expect 8}
  {:fn "validate-entry" :args [[100 0 50 100 0 50]] :expect 16}
  {:fn "validate-entry" :args [[100 0 0 90]] :expect 32}

  ;; entry-balanced?
  {:fn "entry-balanced?" :args [[300 0 0 200 0 100]] :expect 1}
  {:fn "entry-balanced?" :args [[100 0 0 90]] :expect 0}

  ;; ledger-balanced? [account debit credit] × n
  {:fn "ledger-balanced?" :args [[1 300 0 2 0 300]] :expect 1}
  {:fn "ledger-balanced?" :args [[1 300 0 2 0 200]] :expect 0}

  ;; account-net
  {:fn "account-net" :args [[1 300 0 2 0 300 1 0 50] 1] :expect 250}

  ;; class-valid?
  {:fn "class-valid?" :args [0] :expect 0}
  {:fn "class-valid?" :args [1] :expect 1}
  {:fn "class-valid?" :args [14] :expect 1}
  {:fn "class-valid?" :args [15] :expect 0}

  ;; normal-sign — 借方が正 1、貸方が正 -1、未分類・範囲外 0
  {:fn "normal-sign" :args [1] :expect 1}
  {:fn "normal-sign" :args [4] :expect -1}
  {:fn "normal-sign" :args [7] :expect -1}
  {:fn "normal-sign" :args [0] :expect 0}

  ;; period-net [buf class from to] — 借方 − 貸方
  {:fn "period-net" :args [:sample 1 0 99991231] :expect 1333500}
  {:fn "period-net" :args [:sample 1 20260401 20270331] :expect 333500}
  {:fn "period-net" :args [:sample 7 20260401 20270331] :expect -330000}
  {:fn "period-net" :args [:sample 6 0 20260331] :expect -1000000}
  {:fn "period-net" :args [:sample 9 20260601 20260630] :expect 0}

  ;; class-balance — 正の側で見た残高
  {:fn "class-balance" :args [:sample 7 20260401 20270331] :expect 330000}
  {:fn "class-balance" :args [:sample 1 0 99991231] :expect 1333500}
  {:fn "class-balance" :args [:sample 4 0 99991231] :expect 30000}
  {:fn "class-balance" :args [:sample 8 20260401 20270331] :expect 110000}

  ;; profit-stage [buf stage from to]
  {:fn "profit-stage" :args [:sample 1 20260401 20270331] :expect 220000}
  {:fn "profit-stage" :args [:sample 2 20260401 20270331] :expect 140000}
  {:fn "profit-stage" :args [:sample 3 20260401 20270331] :expect 138500}
  {:fn "profit-stage" :args [:sample 4 20260401 20270331] :expect 133500}
  {:fn "profit-stage" :args [:sample 5 20260401 20270331] :expect 103500}
  {:fn "profit-stage" :args [:sample 0 20260401 20270331] :expect 0}
  {:fn "profit-stage" :args [:sample 6 20260401 20270331] :expect 0}
  {:fn "profit-stage" :args [:sample 5 20260401 20260630] :expect 140500}

  ;; unclassified-count
  {:fn "unclassified-count" :args [:sample] :expect 0}
  {:fn "unclassified-count" :args [:unclassified] :expect 1}
  {:fn "unclassified-count" :args [[]] :expect 0}

  ;; bs-difference [buf to] — 資産 − (負債 + 純資産 + 損益の累計)
  {:fn "bs-difference" :args [:sample 20270331] :expect 0}
  {:fn "bs-difference" :args [:sample 20260331] :expect 0}
  {:fn "bs-difference" :args [:unclassified 20261231] :expect -100}

  ;; statement-balanced?
  {:fn "statement-balanced?" :args [:sample 20270331] :expect 1}
  {:fn "statement-balanced?" :args [:unclassified 20261231] :expect 0}
  {:fn "statement-balanced?" :args [:unbalanced 20261231] :expect 0}

  ;; statement-buffer-valid?
  {:fn "statement-buffer-valid?" :args [:sample] :expect 1}
  {:fn "statement-buffer-valid?" :args [[]] :expect 1}
  {:fn "statement-buffer-valid?" :args [[20260101 1 100]] :expect 0}
  {:fn "statement-buffer-valid?" :args [[20260101 15 100 0]] :expect 0}
  {:fn "statement-buffer-valid?" :args [[20260101 1 -100 0]] :expect 0}
  {:fn "statement-buffer-valid?" :args [[-1 1 100 0]] :expect 0}

  ;; rate-base [buf rate] — 税率ごとの対価の合計
  {:fn "rate-base" :args [:mixed 1000] :expect 83333}
  {:fn "rate-base" :args [:mixed 800] :expect 12345}
  {:fn "rate-base" :args [:mixed 0] :expect 0}

  ;; rate-tax [buf rate mode rounding] — 税率ごとに 1 回だけ丸める
  {:fn "rate-tax" :args [:mixed 1000 0 0] :expect 8333}
  {:fn "rate-tax" :args [:mixed 1000 0 1] :expect 8333}
  {:fn "rate-tax" :args [:mixed 1000 0 2] :expect 8334}
  {:fn "rate-tax" :args [:mixed 800 0 0] :expect 987}
  {:fn "rate-tax" :args [:mixed 800 0 1] :expect 988}
  {:fn "rate-tax" :args [:mixed 1000 2 0] :expect 0}
  {:fn "rate-tax" :args [[1000 1000] 1000 1 0] :expect 90}
  {:fn "rate-tax" :args [[1000 1000] 1000 1 1] :expect 91}
  {:fn "rate-tax" :args [:nta57 1000 1 0] :expect 5454}
  {:fn "rate-tax" :args [:nta57 800 1 0] :expect 2962}
  {:fn "rate-tax" :args [[1000 3017 800 2524] 1000 0 0] :expect 301}
  {:fn "rate-tax" :args [[1000 3017 800 2524] 800 0 0] :expect 201}
  {:fn "rate-tax" :args [:xero-rounding 1500 0 1] :expect 1145}
  {:fn "rate-tax" :args [[1000 900000000000000] 1000 1 0] :expect 81818181818181}
  {:fn "rate-tax" :args [[1000 900000000000000] 1000 1 1] :expect 81818181818182}

  ;; invoice-tax [buf mode rounding] — 税率ごとの税額の和
  {:fn "invoice-tax" :args [:mixed 0 0] :expect 9320}
  {:fn "invoice-tax" :args [:nta57 1 0] :expect 8416}
  {:fn "invoice-tax" :args [[1000 105 1000 105 1000 105] 0 0] :expect 31}
  {:fn "invoice-tax" :args [[0 5000 1000 1000] 0 0] :expect 100}
  {:fn "invoice-tax" :args [:freee 0 0] :expect 463}
  {:fn "invoice-tax" :args [[] 0 0] :expect 0}

  ;; invoice-total [buf mode rounding] — 税込の合計
  {:fn "invoice-total" :args [:mixed 0 0] :expect 104998}
  {:fn "invoice-total" :args [[1000 110000 800 10800] 1 0] :expect 120800}
  {:fn "invoice-total" :args [[1000 5000] 2 0] :expect 5000}

  ;; rate-net [buf rate mode rounding] — 税率ごとの税抜の対価
  {:fn "rate-net" :args [[1000 110000 800 10800] 1000 1 0] :expect 100000}
  {:fn "rate-net" :args [[1000 1000] 1000 1 1] :expect 909}
  {:fn "rate-net" :args [:mixed 1000 0 0] :expect 83333}

  ;; tax-share [buf line mode rounding] — 行への割り当て（和は rate-tax）
  {:fn "tax-share" :args [:freee 0 0 0] :expect 42}
  {:fn "tax-share" :args [:freee 1 0 0] :expect 211}
  {:fn "tax-share" :args [:freee 2 0 0] :expect 188}
  {:fn "tax-share" :args [:freee 3 0 0] :expect 22}
  {:fn "tax-share" :args [:discount 0 1 0] :expect 90}
  {:fn "tax-share" :args [:discount 1 1 0] :expect 80}
  {:fn "tax-share" :args [:discount 2 1 0] :expect -9}
  {:fn "tax-share" :args [:xero-rounding 0 0 1] :expect 375}
  {:fn "tax-share" :args [:xero-rounding 2 0 1] :expect 386}
  {:fn "tax-share" :args [:mixed 0 2 0] :expect 0}

  ;; invoice-buffer-valid?
  {:fn "invoice-buffer-valid?" :args [:mixed] :expect 1}
  {:fn "invoice-buffer-valid?" :args [[]] :expect 1}
  {:fn "invoice-buffer-valid?" :args [[1000]] :expect 0}
  {:fn "invoice-buffer-valid?" :args [[10001 100]] :expect 0}
  {:fn "invoice-buffer-valid?" :args [[1000 100 1000 -200]] :expect 0}
  {:fn "invoice-buffer-valid?" :args [[1000 900000000000001]] :expect 0}

  ;; registration-format? [codes] — 「T」＋数字 13 桁（符号位置の列）
  {:fn "registration-format?" :args [[84 49 50 51 52 53 54 55 56 57 48 49 50 51]] :expect 1}
  {:fn "registration-format?" :args [[116 49 50 51 52 53 54 55 56 57 48 49 50 51]] :expect 0}
  {:fn "registration-format?" :args [[84 49 50 51 52 53 54 55 56 57 48 49 50]] :expect 0}
  {:fn "registration-format?" :args [[84 49 50 51 52 53 54 55 56 57 48 49 50 65]] :expect 0}

  ;; deduction-percent [date qualified] — 国税庁 Q&A 問 113 の経過措置
  {:fn "deduction-percent" :args [20261022 1] :expect 100}
  {:fn "deduction-percent" :args [20230930 0] :expect 100}
  {:fn "deduction-percent" :args [20231001 0] :expect 80}
  {:fn "deduction-percent" :args [20260930 0] :expect 80}
  {:fn "deduction-percent" :args [20261001 0] :expect 70}
  {:fn "deduction-percent" :args [20281001 0] :expect 50}
  {:fn "deduction-percent" :args [20301001 0] :expect 30}
  {:fn "deduction-percent" :args [20311001 0] :expect 0}

  ;; days-between [from to] — 日数の差（うるう年: 2024・2000 は数え、2100 は数えない）
  {:fn "days-between" :args [19700101 20261023] :expect 20749}
  {:fn "days-between" :args [20260101 20261231] :expect 364}
  {:fn "days-between" :args [20240228 20240301] :expect 2}
  {:fn "days-between" :args [20230228 20230301] :expect 1}
  {:fn "days-between" :args [20000228 20000301] :expect 2}
  {:fn "days-between" :args [21000228 21000301] :expect 1}
  {:fn "days-between" :args [19700101 16000301] :expect -135080}
  {:fn "days-between" :args [19700101 99991231] :expect 2932896}
  {:fn "days-between" :args [20261023 20261023] :expect 0}

  ;; consumption-rate [date kind] — 0 標準・1 飲食料品・2 新聞。表の外と 2027-04-01 からの飲食料品は -1
  {:fn "consumption-rate" :args [20140331 0] :expect -1}
  {:fn "consumption-rate" :args [20140401 0] :expect 800}
  {:fn "consumption-rate" :args [20190930 0] :expect 800}
  {:fn "consumption-rate" :args [20190930 1] :expect 800}
  {:fn "consumption-rate" :args [20191001 0] :expect 1000}
  {:fn "consumption-rate" :args [20191001 1] :expect 800}
  {:fn "consumption-rate" :args [20191001 2] :expect 800}
  {:fn "consumption-rate" :args [20270331 1] :expect 800}
  {:fn "consumption-rate" :args [20270401 1] :expect -1}
  {:fn "consumption-rate" :args [20270401 2] :expect 800}
  {:fn "consumption-rate" :args [20270401 0] :expect 1000}

  ;; aging-bucket [due as-of] — 0 期日前、1 1〜30 日、2 31〜60 日、3 61〜90 日、4 91 日〜
  {:fn "aging-bucket" :args [20261031 20261031] :expect 0}
  {:fn "aging-bucket" :args [20261031 20261001] :expect 0}
  {:fn "aging-bucket" :args [20261031 20261101] :expect 1}
  {:fn "aging-bucket" :args [20261031 20261130] :expect 1}
  {:fn "aging-bucket" :args [20261031 20261201] :expect 2}
  {:fn "aging-bucket" :args [20261031 20261230] :expect 2}
  {:fn "aging-bucket" :args [20261031 20261231] :expect 3}
  {:fn "aging-bucket" :args [20261031 20270129] :expect 3}
  {:fn "aging-bucket" :args [20261031 20270130] :expect 4}

  ;; running-break [buf opening] — 明細の [amount balance] × n。食い違う最初の行、合えば -1
  {:fn "running-break" :args [[-1000 99000 5000 104000 -300 103700] 100000] :expect -1}
  {:fn "running-break" :args [[-1000 99000 5000 104100 -300 103800] 100000] :expect 1}
  {:fn "running-break" :args [[-1000 99000] 100001] :expect 0}
  {:fn "running-break" :args [[] 100000] :expect -1}

  ;; closing-gap [buf opening closing] — 期首 + 明細の和 − 期末
  {:fn "closing-gap" :args [[-1000 0 5000 0] 100000 104000] :expect 0}
  {:fn "closing-gap" :args [[-1000 0 5000 0] 100000 104500] :expect -500}
  {:fn "closing-gap" :args [[] 100000 100000] :expect 0}

  ;; line-buffer-valid? [buf] — 明細の buffer の形
  {:fn "line-buffer-valid?" :args [[-1000 99000]] :expect 1}
  {:fn "line-buffer-valid?" :args [[]] :expect 1}
  {:fn "line-buffer-valid?" :args [[100]] :expect 0}
  {:fn "line-buffer-valid?" :args [[900000000000001 0]] :expect 0}
  {:fn "line-buffer-valid?" :args [[-900000000000000 0]] :expect 1}

  ;; payment-kind [due received max-fee] — 0 なし 1 一致 2 手数料の分だけ少ない 3 一部 4 多い
  {:fn "payment-kind" :args [55000 55000 880] :expect 1}
  {:fn "payment-kind" :args [55000 54560 880] :expect 2}
  {:fn "payment-kind" :args [55000 54120 880] :expect 2}
  {:fn "payment-kind" :args [55000 54119 880] :expect 3}
  {:fn "payment-kind" :args [55000 56000 880] :expect 4}
  {:fn "payment-kind" :args [55000 0 880] :expect 0}
  {:fn "payment-kind" :args [0 1000 880] :expect 0}
  {:fn "payment-kind" :args [55000 54560 0] :expect 3}

  ;; cover-count [buf received max-fee] — 期日の順の先頭 k 件で入金と合う最小の k
  {:fn "cover-count" :args [[33000 22000 11000] 55000 0] :expect 2}
  {:fn "cover-count" :args [[33000 22000 11000] 54560 880] :expect 2}
  {:fn "cover-count" :args [[33000 22000 11000] 66000 0] :expect 3}
  {:fn "cover-count" :args [[33000 22000 11000] 33000 0] :expect 1}
  {:fn "cover-count" :args [[33000 22000 11000] 40000 0] :expect 0}
  {:fn "cover-count" :args [[33000 22000 11000] 0 0] :expect 0}
  {:fn "cover-count" :args [[] 1000 0] :expect 0}

  ;; allocate [buf received i] — 期日の順に割り当てた i 件目への額
  {:fn "allocate" :args [[33000 22000 11000] 40000 0] :expect 33000}
  {:fn "allocate" :args [[33000 22000 11000] 40000 1] :expect 7000}
  {:fn "allocate" :args [[33000 22000 11000] 40000 2] :expect 0}
  {:fn "allocate" :args [[33000 22000 11000] 70000 2] :expect 11000}
  {:fn "allocate" :args [[33000 22000 11000] 20000 0] :expect 20000}

  ;; date-fit [issue due paid window] — 0 発行日より前、1 期日 + window まで、2 それより後
  {:fn "date-fit" :args [20261031 20261130 20261128 90] :expect 1}
  {:fn "date-fit" :args [20261031 20261130 20261030 90] :expect 0}
  {:fn "date-fit" :args [20261031 20261130 20261031 90] :expect 1}
