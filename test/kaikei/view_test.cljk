(ns kaikei.view-test
  "画面の純関数。SSR では関数が 1 つも混ざらないこと、帳票が描けること、
  handler を渡せば付くこと。"
  (:require [cljs.test :refer [deftest is testing]]
            [clojure.walk :as walk]
            [kaikei.core :as core]
            [kaikei.invoice]
            [kaikei.view :as view]))

(defn- nodes [tree]
  (let [acc (atom [])]
    (walk/postwalk (fn [x] (swap! acc conj x) x) tree)
    @acc))

(defn- texts [tree] (filter string? (nodes tree)))

(defn- has-text? [tree s] (some #(.includes % s) (texts tree)))

(def sample-db (:db (core/merge-import core/empty-db core/sample-import)))

(defn- render [data ui h]
  (view/root {:data data :ui ui} (view/derive data (view/period data ui)) h))

(deftest ssr-has-no-functions
  (doseq [booting? [true false]]
    (let [tree (render core/empty-db (assoc view/initial-ui :booting? booting?) view/ssr-handlers)]
      (testing (str ":booting? " booting?)
        (is (not-any? fn? (nodes tree)))
        (testing "JS 無しでも何の道具か・送信しないこと・商標の断りが読める"
          (is (has-text? tree "試算表・損益計算書・貸借対照表"))
          (is (has-text? tree "送信されず"))
          (is (has-text? tree "商標"))
          (is (has-text? tree "電子帳簿保存法への適合を主張せず")))))))

(deftest ssr-does-not-claim-empty
  (let [tree (render core/empty-db (assoc view/initial-ui :booting? true) view/ssr-handlers)]
    (is (has-text? tree "読み込んでいます"))
    (is (not (has-text? tree "まだ仕訳がありません")))))

(deftest every-mode-renders
  (doseq [mode [:trial-balance :profit-and-loss :balance-sheet :journal :accounts]]
    (let [tree (render sample-db (assoc view/initial-ui :mode mode :account "普通預金") view/ssr-handlers)]
      (testing (str mode)
        (is (not-any? fn? (nodes tree)))
        (is (has-text? tree "完全"))))))

(deftest reports-show-the-numbers
  (let [pl (render sample-db (assoc view/initial-ui :mode :profit-and-loss) view/ssr-handlers)
        us (render sample-db (assoc view/initial-ui :mode :profit-and-loss :pl-style :us) view/ssr-handlers)
        bs (render sample-db (assoc view/initial-ui :mode :balance-sheet) view/ssr-handlers)]
    (is (has-text? pl "当期純利益"))
    (is (has-text? pl "103,500"))
    (is (has-text? us "Net Income"))
    (is (has-text? bs "1,333,500"))))

(deftest unclassified-accounts-are-flagged
  (let [{db :db} (core/merge-import sample-db {:currency "JPY" :accounts []
                                               :entries [{:date "2026-06-01"
                                                          :lines [{:account "謎の科目" :debit 100 :credit 0}
                                                                  {:account "普通預金" :debit 0 :credit 100}]}]})
        tree (render db view/initial-ui view/ssr-handlers)]
    (is (has-text? tree "不完全"))
    (is (has-text? tree "区分の無い勘定科目が "))))

(deftest handlers-attach
  (let [h (fn [kind ev] (when (= kind :click) (fn [_] ev)))
        tree (render sample-db view/initial-ui h)
        buttons (filter #(and (vector? %) (= :button (first %)) (map? (second %)) (:on-click (second %))) (nodes tree))]
    (is (seq buttons))))

;; ───────── 請求書（第 3 スライス、JUN-321） ─────────

(deftest invoices-render
  (let [i1 (:id (first (:invoices sample-db)))
        base (assoc view/initial-ui :mode :invoices)
        list-view (render sample-db base view/ssr-handlers)
        detail (render sample-db (assoc base :invoice i1) view/ssr-handlers)
        editor (render sample-db (assoc base :invoice-draft (kaikei.invoice/new-draft sample-db :sales "2026-11-20"))
                       view/ssr-handlers)
        settings (render sample-db (assoc base :invoice-settings-open? true) view/ssr-handlers)
        purchases (render sample-db (assoc base :invoice-kind :purchase :invoice (:id (last (:invoices sample-db))))
                          view/ssr-handlers)]
    (doseq [[label tree] [["一覧" list-view] ["詳細" detail] ["編集" editor] ["設定" settings] ["仕入" purchases]]]
      (testing label (is (not-any? fn? (nodes tree)))))
    (testing "一覧と検査の欄"
      (is (has-text? list-view "INV-0001"))
      (is (has-text? list-view "59,320"))
      (is (has-text? list-view "計上していない請求書が ")))
    (testing "詳細は適格請求書の記載事項を並べる"
      (is (has-text? detail "登録番号 T1234567890123"))
      (is (has-text? detail "株式会社みなと 御中"))
      (is (has-text? detail "10%対象"))
      (is (has-text? detail "8%（軽減）対象"))
      (is (has-text? detail "※ は軽減税率の対象です。"))
      (is (has-text? detail "切捨て")))
    (testing "受け取った請求書は経過措置の割合を出す"
      (is (has-text? purchases "70%")))
    (testing "編集と設定"
      (is (has-text? editor "新しい請求書（売上）"))
      (is (has-text? settings "自社の登録番号")))))

(deftest invoices-without-entries
  (testing "仕訳が無くても請求書のタブは使える"
    (let [db (dissoc (:db (core/merge-import core/empty-db (dissoc core/sample-import :entries))) :entries)
          tree (render (assoc db :entries []) (assoc view/initial-ui :mode :invoices) view/ssr-handlers)]
      (is (has-text? tree "INV-0001"))
      (is (not (has-text? tree "まだ仕訳がありません"))))))

;; ───────── 明細（第 4 スライス、JUN-327） ─────────

(deftest statements-render
  (let [ui (assoc view/initial-ui :mode :statements)
        tree (render sample-db ui view/ssr-handlers)]
    (is (not-any? fn? (nodes tree)))
    (testing "口座の照合（明細の残高・帳簿の残高・差）と行の候補"
      (is (has-text? tree "サンプル銀行 普通 ****1234"))
      (is (has-text? tree "977,650"))
      (is (has-text? tree "1,003,500"))
      (is (has-text? tree "請求書 INV-0001（株式会社みなと）"))
      (is (has-text? tree "科目 支払手数料（課税 10%（標準））（規則）"))
      (is (has-text? tree "有力")))
    (testing "行の詳細: 候補の理由と、承認するまで帳簿は変わらないこと"
      (let [tree (render sample-db (assoc ui :statement-line "l1") view/ssr-handlers)]
        (is (has-text? tree "振込名義が取引先と一致"))
        (is (has-text? tree "承認するまで帳簿は変わりません"))))
    (testing "規則と設定の欄"
      (let [tree (render sample-db (assoc ui :rules-open? true :statement-settings-open? true) view/ssr-handlers)]
        (is (has-text? tree "「ﾌﾘｺﾐﾃｽｳﾘﾖｳ」に部分一致"))
        (is (has-text? tree "事務所ノ家賃"))
        (is (has-text? tree "売上の対価の返還（科目は支払手数料。国税庁 Q&A 問 30）")))))
  (testing "検査の欄に未処理の明細、請求書タブに残額と年齢表"
    (let [tree (render sample-db view/initial-ui view/ssr-handlers)]
      (is (has-text? tree "計上も照合もしていない明細の行が ")))
    (let [tree (render sample-db (assoc view/initial-ui :mode :invoices) view/ssr-handlers)]
      (is (has-text? tree "売掛金の年齢表"))
      (is (has-text? tree "59,320")))))

(deftest statements-only-book
  (testing "明細だけの帳簿でも明細のタブが開く"
    (let [db (:db (core/merge-import core/empty-db (select-keys core/sample-import [:currency :statement-accounts :statement-lines])))
          tree (render db (assoc view/initial-ui :mode :statements) view/ssr-handlers)]
      (is (has-text? tree "サンプル銀行"))
      (is (not (has-text? tree "まだ仕訳がありません"))))))
