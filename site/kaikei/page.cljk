(ns kaikei.page
  "itonami.cloud/sites/app/kaikei/ のページの殻（SSR）。

  既存の帳簿の画面は DADS の class を使い、確定申告の画面は独自の部品を使う。

  ## このページは何も送信しない

  仕訳には取引先・金額・摘要など、事業の内部情報が入る。**入力は 1 バイトも
  ネットワークに出ない** —— サーバも fetch も無く、保存はこの端末の
  IndexedDB（使えなければ localStorage）だけ。外部リクエストもゼロにしてある: DADS の CSS は inline、
  React / scittle は同一オリジンに vendor（site/vendor/PROVENANCE.edn）。

  ## 本文は view と同じ関数

  `<div id=\"app\">` の中身は `kaikei.view/root` を空の状態で描いたもの。
  ブラウザでは site/app.cljk が同じ関数を Reagent で描き直す。"
  (:require ["node:fs" :as fs]
            ["node:path" :as path]
            [jp-go-dds.page :as dds-page]
            [kaikei.core :as core]
            [kaikei.view :as view]))

(def ^:private site-title "kaikei — 会計帳簿・請求書・明細の消込（MF・freee・弥生・QuickBooks・Xero 互換）")

(def ^:private site-description
  "会計ソフトから書き出した仕訳を取り込み、試算表・損益計算書・貸借対照表をブラウザの中だけで作ります。請求書を作り、適格請求書の記載事項を確かめて計上できます。自分で落とした銀行・カードの明細を取り込み、請求書の消込と仕訳の候補を確かめてから計上できます。データは送信されません。")

(def app-css
  "帳簿と確定申告のスタイル。"
  ".kk-app{max-width:80rem;margin:0 auto;padding:1.5rem 1rem 3rem;}
.kk-title{font-size:1.75rem;font-weight:700;margin:0;}
.kk-title-sub{font-size:1rem;font-weight:400;margin-left:.5rem;color:var(--color-neutral-solid-gray-600,#666);}
.kk-lead,.kk-help{color:var(--color-neutral-solid-gray-700,#555);line-height:1.7;}
.kk-h2{font-size:1.125rem;font-weight:700;margin:0 0 .5rem;}
.kk-h3{font-size:1rem;font-weight:700;margin:1rem 0 .5rem;}
.kk-toolbar{display:flex;flex-wrap:wrap;gap:.75rem 1.5rem;align-items:center;margin:1rem 0;padding:.75rem 0;border-block:1px solid var(--color-neutral-solid-gray-200,#ddd);}
.kk-toolbar-group,.kk-actions,.kk-confirm,.kk-tabs{display:flex;flex-wrap:wrap;gap:.5rem;align-items:center;max-width:100%;min-width:0;}
.kk-app .dads-select,.kk-app .dads-select__control,.kk-app .dads-select__select{max-width:100%;min-width:0;}
.kk-app .dads-form-control-label,.kk-app .dads-form-control-label>div{max-width:100%;min-width:0;}
.kk-tabs{margin:1rem 0;}
.kk-inline-label{font-weight:700;}
.kk-panel,.kk-result,.kk-empty,.kk-report,.kk-checks{border:1px solid var(--color-neutral-solid-gray-200,#ddd);border-radius:.5rem;padding:1rem;margin:1rem 0;background:var(--color-neutral-white,#fff);}
.kk-result--error,.kk-checks--warn{border-color:var(--color-primitive-orange-600,#c60);}
.kk-checks ul,.kk-notes{margin:0;padding-left:1.25rem;line-height:1.8;}
.kk-checks p{margin:0;}
.kk-warnings{color:var(--color-primitive-red-800,#b00);}
.kk-settings,.kk-period{display:flex;flex-wrap:wrap;gap:1rem;align-items:end;margin:.75rem 0;}
.kk-panel .dads-textarea{width:100%;}
.kk-report-head{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:.5rem 1rem;}
.kk-table-wrap{overflow-x:auto;max-width:100%;position:relative;}
.kk-table{width:100%;border-collapse:collapse;font-size:.875rem;}
.kk-table th,.kk-table td{padding:.375rem .5rem;border-bottom:1px solid var(--color-neutral-solid-gray-100,#eee);text-align:left;vertical-align:top;}
.kk-table thead th{font-weight:700;border-bottom-width:2px;white-space:nowrap;}
.kk-table tbody th{font-weight:400;}
.kk-table tfoot th,.kk-table tfoot td,.kk-stage th,.kk-stage td{font-weight:700;border-top:2px solid var(--color-neutral-solid-gray-200,#ddd);}
.kk-num{text-align:right !important;font-variant-numeric:tabular-nums;white-space:nowrap;}
.kk-section th{font-weight:700 !important;background:var(--color-neutral-solid-gray-50,#f7f7f7);}
.kk-subtotal th,.kk-subtotal td{color:var(--color-neutral-solid-gray-700,#555);}
.kk-indent{padding-left:1.5rem !important;}
.kk-statement{max-width:40rem;}
.kk-statement caption{text-align:left;font-weight:700;padding:.25rem 0;}
.kk-bs{display:grid;grid-template-columns:minmax(0,1fr);gap:1rem;}
@media (min-width:64rem){.kk-bs{grid-template-columns:minmax(0,1fr) minmax(0,1fr);}}
.kk-row--warn{background:var(--color-primitive-yellow-50,#fffbe6);}
.kk-row--selected{background:var(--color-primitive-blue-50,#eef4ff);}
.kk-details{margin-top:1rem;}
.kk-code{white-space:pre-wrap;overflow-wrap:anywhere;font-size:.75rem;background:var(--color-neutral-solid-gray-50,#f8f8fb);padding:.5rem;border-radius:.25rem;max-height:16rem;overflow:auto;}
.kk-candidates{list-style:none;margin:0;padding:0;display:grid;gap:.5rem;}
.kk-candidate{border:1px solid var(--color-neutral-solid-gray-200,#ddd);border-radius:.5rem;padding:.5rem .75rem;}
.kk-candidate p{margin:.25rem 0;overflow-wrap:anywhere;}
.kk-link{border:0;background:transparent;padding:0;font:inherit;color:var(--color-primitive-blue-900,#0031d8);text-decoration:underline;cursor:pointer;text-align:left;}
.kk-entries{list-style:none;margin:0;padding:0;}
.kk-entry{border-bottom:1px solid var(--color-neutral-solid-gray-200,#ddd);padding:.75rem 0;}
.kk-entry--warn{background:var(--color-primitive-yellow-50,#fffbe6);}
.kk-entry-head{display:flex;flex-wrap:wrap;gap:.25rem .75rem;align-items:center;font-size:.875rem;}
.kk-date,.kk-number,.kk-origin{font-family:ui-monospace,monospace;color:var(--color-neutral-solid-gray-600,#666);}
.kk-memo{flex:1 1 12rem;}
.kk-lines{margin-top:.25rem;}
.kk-check{display:flex;gap:.25rem;align-items:center;}
.kk-danger{color:var(--color-primitive-red-800,#b00);}
.kk-footer{margin-top:3rem;font-size:.8125rem;color:var(--color-neutral-solid-gray-600,#666);line-height:1.7;}
.kk-noscript{font-weight:700;}
.kk-visually-hidden{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap;}
.kk-invoice{border:1px solid var(--color-neutral-solid-gray-200,#ddd);border-radius:.5rem;padding:1.5rem;margin-top:1rem;background:var(--color-neutral-white,#fff);}
.kk-invoice-head{display:flex;flex-wrap:wrap;justify-content:space-between;gap:.5rem 1rem;align-items:start;}
.kk-invoice-title{font-size:1.5rem;font-weight:700;margin:0;letter-spacing:.2em;}
.kk-invoice-meta{display:grid;grid-template-columns:auto auto;gap:.125rem .75rem;margin:0;font-size:.875rem;}
.kk-invoice-meta dt{font-weight:700;}
.kk-invoice-meta dd{margin:0;}
.kk-invoice-parties{display:flex;flex-wrap:wrap;justify-content:space-between;gap:1rem;margin:1rem 0;}
.kk-invoice-parties p{margin:.125rem 0;}
.kk-invoice-to{font-size:1.125rem;font-weight:700;border-bottom:1px solid currentcolor;}
.kk-invoice-from{text-align:right;}
.kk-invoice-total{font-size:1.125rem;margin:1rem 0;}
.kk-invoice-rates{max-width:36rem;margin-top:1rem;}
.kk-invoice-rates caption{text-align:left;font-weight:700;padding:.25rem 0;}
.kk-invoice-lines .dads-input-text,.kk-invoice-lines .dads-input-text__input{min-width:5rem;max-width:100%;}
.tax-screen,.tax-button{--tax-text:#152b29;--tax-muted:#496460;--tax-border:#a9c2bd;--tax-accent:#005d51;--tax-surface:#f1f7f5;--tax-card:#fff;--tax-focus:#935800;color:var(--tax-text);font-family:system-ui,-apple-system,sans-serif;}
.tax-screen{box-sizing:border-box;max-width:65rem;min-height:100vh;margin:auto;padding:clamp(1rem,4vw,3rem);background:var(--tax-surface);line-height:1.55;}
.tax-topbar,.tax-checklist li{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:.75rem;}
.tax-screen h1{font-size:clamp(1.8rem,4vw,2.7rem);line-height:1.2;margin:0;}
.tax-screen h2,.tax-screen h3{margin:0 0 .6rem;line-height:1.35;}
.tax-lead,.tax-muted{color:var(--tax-muted);}
.tax-steps{display:grid;grid-template-columns:repeat(auto-fit,minmax(6rem,1fr));gap:.4rem;list-style:none;padding:0;margin:1.5rem 0;}
.tax-steps li{border-block-end:3px solid var(--tax-border);padding:.55rem 0;text-align:center;color:var(--tax-muted);}
.tax-steps [aria-current=step]{border-color:var(--tax-accent);color:var(--tax-accent);font-weight:750;}
.tax-card,.tax-detail{border:1px solid var(--tax-border);background:var(--tax-card);padding:clamp(1rem,3vw,1.6rem);border-radius:1rem;margin:1rem 0;overflow-wrap:anywhere;}
.tax-approval{border:2px solid var(--tax-accent);}
.tax-detail summary{font-weight:680;cursor:pointer;}
.tax-detail[open]>summary{margin-bottom:.75rem;}
.tax-fields{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,13rem),1fr));gap:.1rem 1rem;}
.tax-field{display:grid;justify-items:start;gap:.25rem;min-width:0;margin:.65rem 0;}
.tax-field label{font-weight:650;}
.tax-screen input,.tax-screen select{box-sizing:border-box;max-width:100%;min-height:2.75rem;background:var(--tax-card);color:var(--tax-text);border:1px solid var(--tax-border);border-radius:.45rem;padding:.35rem .55rem;font:inherit;}
.tax-screen input[type=checkbox]{min-height:0;inline-size:1.4rem;block-size:1.4rem;accent-color:var(--tax-accent);}
.tax-button{min-height:2.75rem;border:2px solid var(--tax-accent);border-radius:.55rem;background:var(--tax-accent);color:#fff;padding:.35rem .75rem;font:600 .95rem/1.3 system-ui,-apple-system,sans-serif;cursor:pointer;}
.tax-button-secondary{background:var(--tax-card);color:var(--tax-accent);}
.tax-button:hover{box-shadow:inset 0 0 0 100px #00000012;}
.tax-screen :focus-visible,.tax-button:focus-visible{outline:3px solid var(--tax-focus);outline-offset:2px;}
.tax-scroll{overflow-x:auto;}
.tax-table{width:100%;border-collapse:collapse;text-align:left;}
.tax-table :is(td,th){border-bottom:1px solid var(--tax-border);vertical-align:top;padding:.5rem;}
.tax-table :is(select,button,small){display:block;margin:.2rem 0;}
.tax-totals{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,9rem),1fr));gap:.5rem;}
.tax-totals>div{padding:.65rem;background:var(--tax-surface);border-radius:.5rem;}
.tax-screen dd{margin:0;font-weight:700;font-variant-numeric:tabular-nums;}
.tax-breakdown{display:grid;grid-template-columns:minmax(0,1fr) max-content;gap:.3rem 1rem;}
.tax-estimate,.tax-check-status{color:var(--tax-accent);}
.tax-checklist{list-style:none;padding:0;}
.tax-checklist li{border-block-end:1px solid var(--tax-border);padding:.55rem 0;}
.tax-error{border-inline-start:4px solid #8a2622;padding:.55rem;margin:1rem 0;color:#8a2622;background:#fff4f3;}
.tax-sr{position:absolute;width:1px;height:1px;clip-path:inset(50%);overflow:hidden;}
@media print{
body *{visibility:hidden;}
.kk-invoice,.kk-invoice *{visibility:visible;}
.kk-invoice{position:absolute;left:0;top:0;width:100%;border:0;margin:0;padding:0;}
.kk-no-print{display:none;}
}")

(def ssr-state
  "SSR で描く状態。保存した仕訳はブラウザでしか分からないので、
  「仕訳がありません」ではなく読み込み中（:booting?）を描く。"
  {:data core/empty-db :ui (assoc view/initial-ui :booting? true)})

(defn- inline-source [root source]
  (let [body (fs/readFileSync (path/join root source) "utf8")]
    (when (re-find #"(?i)</script" body)
      (throw (js/Error. (str "Scittle source contains a closing script tag: " source))))
    [:script {:type "application/x-scittle"} body]))

(defn document
  "完全な HTML 文書。opts（生成器が渡す。site/site.edn の契約）:
  :css             vendored dds.css の中身（jp-go-dds.page は I/O を持たない）
  :vendor-scripts  [\"vendor/react.production.min.js\" …]（この順で <script src>）
  :scittle-scripts [\"kotoba/lang/text.cljs\" … \"app.cljs\"]（この順で scittle）
  :scittle-root  コピー済みのソースの場所。公開生成器では SCITTLE_APP_OUT。"
  [{:keys [css vendor-scripts scittle-scripts scittle-root]}]
  (let [root (or scittle-root (aget js/process.env "SCITTLE_APP_OUT"))]
    (dds-page/->page
     {:title site-title
      :description site-description
      :css css
      :app-css app-css
      :head (into [[:meta {:http-equiv "Content-Security-Policy"
                           :content "connect-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'"}]]
                  (map (fn [src] [:script {:src (str "./" src)}]) vendor-scripts))}
     [:div {:id "app"} (view/root ssr-state nil view/ssr-handlers)]
     ;; Scittle reads inline sources without its XHR loader.
     (mapv #(inline-source root %) scittle-scripts))))
