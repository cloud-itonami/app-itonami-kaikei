(ns kaikei.compat.paypay-merchant
  "PayPay 加盟店の即時・後日確定 recon CSV。本人の PayPay 支出履歴ではない。"
  (:require [kotoba.lang.text :as text]
            [kaikei.core :as core]
            [kaikei.csv :as csv]
            [kaikei.compat.common :as common]))

(def ^:private columns
  ["決済番号" "加盟店ID" "屋号" "店舗ID" "店舗名" "端末番号/PosID" "取引ステータス"
   "取引日時" "取引金額" "レシート番号" "支払い方法" "マーチャント決済ID" "支払い詳細"])

(def ^:private capture-columns
  ["orderId" "merchantId" "brandName" "storeId" "storeName" "terminalId" "transactionStatus"
   "acceptedAt" "amount" "orderReceiptNumber" "methodOfPayment" "merchantPaymentId" "paymentDetails"])

(defn- kind [rows]
  (let [h (mapv text/trim (first rows))]
    (cond (= columns h) :instant (= capture-columns h) :capture :else nil)))

(defn detect? [rows] (boolean (kind rows)))

(defn read-rows [rows]
  (if-not (detect? rows)
    {:format :paypay-merchant-csv :accounts [] :statement-accounts [] :statement-lines []
     :rejected 0 :warnings ["PayPay 加盟店 recon CSV の見出しが一致しません"]}
    (let [capture? (= :capture (kind rows))
          [merchant-col payment-col event-col status-col date-col amount-col]
          (if capture? ["merchantId" "orderId" "merchantPaymentId" "transactionStatus" "acceptedAt" "amount"]
              ["加盟店ID" "決済番号" "マーチャント決済ID" "取引ステータス" "取引日時" "取引金額"])
          records (csv/records rows)
          merchants (vec (distinct (keep #(common/blank->nil (get % merchant-col)) records)))
          ids (into {} (map-indexed (fn [i m] [m (str "s" (inc i))]) merchants))
          accounts (mapv (fn [m] {:id (get ids m) :key (str "paypay-merchant:" m)
                                   :kind :bank :name "PayPay 加盟店 売上明細"
                                   :ledger-account "未収入金" :currency "JPY"
                                   :origin {:format :paypay-merchant-csv}}) merchants)
          candidates
          (mapv (fn [r]
                  (let [where (str "行 " (::csv/row r))
                        merchant (common/blank->nil (get r merchant-col))
                        payment (common/blank->nil (get r payment-col))
                        event-id (common/blank->nil (get r event-col))
                        status (common/blank->nil (get r status-col))
                        date (core/parse-date (get r date-col))
                        raw (common/blank->nil (get r amount-col))
                        amount (when raw (common/read-amount raw 0 (str where " の取引金額")))
                        n (:amount amount)
                        completed? (if capture? (= status "COMPLETED") (= status "取引完了"))
                        refunded? (if capture? (= status "REFUNDED") (= status "返金完了"))]
                    (cond
                      (not (or completed? refunded?)) {:problem (str where ": 未確定・失敗または未知の状態は取り込みません（" status "）")}
                      (or (nil? merchant) (nil? payment) (nil? event-id)) {:problem (str where ": 加盟店・決済・取引 ID が必要です")}
                      (nil? date) {:problem (str where ": 取引日時を読めません")}
                      (nil? raw) {:problem (str where ": 金額がありません")}
                      (:problem amount) {:problem (:problem amount)}
                      (or (and completed? (not (pos? n)))
                          (and refunded? (if capture? (zero? n) (not (neg? n))))) {:problem (str where ": 状態と金額の符号が一致しません")}
                      ;; 公式仕様は絶対値とするが、公式サンプルの REFUNDED は負数。
                      ;; どちらも返金として負にする。0 は拒否する。
                      :else {:line {:account-id (get ids merchant) :date date :amount (if (and capture? refunded? (pos? n)) (- n) n)
                                    :description (str status " " event-id)
                                    :reference event-id
                                    :uid (if capture? (pr-str ["capture" payment status event-id])
                                           (pr-str [payment status event-id]))
                                    :origin {:format :paypay-merchant-csv :row (::csv/row r)}}}))) records)]
      {:format :paypay-merchant-csv :currency "JPY" :accounts []
       :statement-accounts accounts :statement-lines (vec (keep :line candidates))
       :rejected (count (filter :problem candidates))
       :warnings (into ["加盟店の売上・返金です。個人の PayPay 支出や銀行への入金とは別に確認してください。提供元の履歴に欠落や他の明細との重複がないか確認してください。"] (keep :problem candidates))})))
