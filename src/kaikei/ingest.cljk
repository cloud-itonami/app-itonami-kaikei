(ns kaikei.ingest
  "取り込み —— 形式の一覧、形式の判定、バイト列・文字列からの取り込み。

  形式（:id は MCP の format 引数と同じ文字列）:

    kaikei-json  kaikei の帳簿 JSON（失う項目が無い）
    xero-json    Xero Accounting API の Accounts・Journals・ManualJournals
    qbo-json     QuickBooks Online の Account・JournalEntry（query の応答）
    yayoi        弥生会計の仕訳日記帳 インポート形式
    mf           マネーフォワード クラウド会計の仕訳帳 CSV
    freee        freee 会計の仕訳 CSV（汎用形式）
    qbo-csv      QuickBooks Online の journal entries 取り込み CSV
    xero-csv     Xero の manual journal 取り込み CSV

  請求書の形式（第 3 スライス、JUN-321。:content :invoices）:

    xero-invoices-json       Xero Accounting API の Invoices（ACCREC・ACCPAY）
    qbo-invoices-json        QuickBooks Online の Invoice・Bill（query の応答）
    xero-invoice-csv         Xero の customer invoices 取り込み CSV
    xero-bill-csv            Xero の bills 取り込み CSV
    qbo-invoice-csv          QuickBooks Online の invoices 取り込み CSV
    freee-invoice-csv        freee請求書 の帳票 CSV インポート（請求書）
    freee-invoice-json       freee請求書 API の invoice
    mf-invoice-csv           MF クラウド請求書 の CSV 一括追加（縦並び）
    mf-invoice-json          MF クラウド請求書 API v3 の Billing
    zoho-invoice-json        Zoho Invoice API v3 の invoice（読むだけ）
    freshbooks-invoice-json  FreshBooks の invoices・bills（読むだけ）

  明細の形式（第 4 スライス、JUN-327。:content :statements）:

    ofx                  OFX 1.x・2.x、QFX・QBO（銀行・カードの明細。読むだけ）
    freee-statement-csv  freee 会計の明細のテンプレート（銀行・カード）
    mf-statement-csv     マネーフォワード クラウド会計の明細の取り込み
    xero-statement-csv   Xero の明細の CSV
    qbo-bank-csv         QuickBooks Online の明細の CSV（3 列・4 列）
    zengin               全銀協の入出金取引明細・振込入金通知（固定長 200 バイト・全銀 CSV。読むだけ）
    statement-csv        汎用の明細 CSV（列の割り当てか型。読むだけ。判断 3）

  :content は :journal（仕訳と勘定科目）・:invoices（請求書）・:statements（明細）・
  :all（kaikei-json）。明細の形式の書き出しは口座ごと（opts の :statement-account）。
  :read-only の形式は書き出さない。Xero の bills の CSV は見出しが customer invoices
  と同じなので、自動の判定では売上の請求書として読む（受け取った請求書は形式を選ぶ）。

  この ns はネットワークに触れない。JSON の構文解析はホスト（JSON.parse）、
  文字コードの解読はホストの TextDecoder（kaikei.encoding）。"
  (:require [kotoba.lang.text :as text]
            [kaikei.csv :as csv]
            [kaikei.json :as json]
            [kaikei.encoding :as enc]
            [kaikei.compat.native :as native]
            [kaikei.compat.xero :as xero]
            [kaikei.compat.qbo :as qbo]
            [kaikei.compat.xero-invoices :as xero-invoices]
            [kaikei.compat.qbo-invoices :as qbo-invoices]
            [kaikei.compat.freee-invoices :as freee-invoices]
            [kaikei.compat.mf-invoices :as mf-invoices]
            [kaikei.compat.zoho-invoices :as zoho-invoices]
            [kaikei.compat.freshbooks-invoices :as freshbooks-invoices]
            [kaikei.compat.yayoi :as yayoi]
            [kaikei.compat.mf :as mf]
            [kaikei.compat.freee :as freee]
            [kaikei.compat.ofx :as ofx]
            [kaikei.compat.zengin :as zengin]
            [kaikei.compat.statement-csv :as statement-csv]))

(def formats
  [{:id "kaikei-json" :label "kaikei 帳簿 JSON（すべての項目）" :kind :json :encoding "utf-8" :content :all
    :file "kaikei-ledger.json" :mime "application/json"}
   {:id "xero-json" :content :journal :label "Xero API JSON（Accounts・ManualJournals）" :kind :json :encoding "utf-8"
    :file "kaikei-xero.json" :mime "application/json"}
   {:id "qbo-json" :content :journal :label "QuickBooks Online API JSON（Account・JournalEntry）" :kind :json :encoding "utf-8"
    :file "kaikei-quickbooks.json" :mime "application/json"}
   {:id "yayoi" :content :journal :label "弥生会計 インポート形式（仕訳日記帳）" :kind :csv :encoding "shift_jis"
    :encodings ["shift_jis" "utf-8"] :file "kaikei-yayoi.txt" :mime "text/plain"}
   {:id "mf" :content :journal :label "マネーフォワード クラウド会計 仕訳帳 CSV" :kind :csv :encoding "shift_jis"
    :encodings ["shift_jis" "utf-8" "utf-8-bom"] :file "kaikei-moneyforward.csv" :mime "text/csv"}
   {:id "freee" :content :journal :label "freee 会計 仕訳 CSV（汎用形式）" :kind :csv :encoding "shift_jis"
    :encodings ["shift_jis" "utf-8" "utf-8-bom"] :file "kaikei-freee.csv" :mime "text/csv"}
   {:id "qbo-csv" :content :journal :label "QuickBooks Online journal entries CSV" :kind :csv :encoding "utf-8"
    :encodings ["utf-8" "utf-8-bom"] :file "kaikei-quickbooks-journal.csv" :mime "text/csv"}
   {:id "xero-csv" :content :journal :label "Xero manual journal CSV" :kind :csv :encoding "utf-8"
    :encodings ["utf-8" "utf-8-bom"] :file "kaikei-xero-manual-journal.csv" :mime "text/csv"}
   {:id "xero-invoices-json" :content :invoices :label "Xero API JSON（Invoices）" :kind :json :encoding "utf-8"
    :file "kaikei-xero-invoices.json" :mime "application/json"}
   {:id "qbo-invoices-json" :content :invoices :label "QuickBooks Online API JSON（Invoice・Bill）" :kind :json
    :encoding "utf-8" :file "kaikei-quickbooks-invoices.json" :mime "application/json"}
   {:id "xero-invoice-csv" :content :invoices :label "Xero 請求書の取り込み CSV（customer invoices）" :kind :csv
    :encoding "utf-8" :encodings ["utf-8" "utf-8-bom"] :file "kaikei-xero-invoices.csv" :mime "text/csv"}
   {:id "xero-bill-csv" :content :invoices :label "Xero 受け取った請求書の取り込み CSV（bills）" :kind :csv
    :encoding "utf-8" :encodings ["utf-8" "utf-8-bom"] :file "kaikei-xero-bills.csv" :mime "text/csv"}
   {:id "qbo-invoice-csv" :content :invoices :label "QuickBooks Online 請求書の取り込み CSV（invoices）" :kind :csv
    :encoding "utf-8" :encodings ["utf-8" "utf-8-bom"] :file "kaikei-quickbooks-invoices.csv" :mime "text/csv"}
   {:id "freee-invoice-csv" :content :invoices :label "freee請求書 帳票 CSV インポート（請求書）" :kind :csv
    :encoding "utf-8" :encodings ["utf-8" "utf-8-bom"] :file "kaikei-freee-invoices.csv" :mime "text/csv"}
   {:id "freee-invoice-json" :content :invoices :label "freee請求書 API JSON（invoice）" :kind :json
    :encoding "utf-8" :file "kaikei-freee-invoices.json" :mime "application/json"}
   {:id "mf-invoice-csv" :content :invoices :label "MF クラウド請求書 CSV 一括追加（縦並び）" :kind :csv
    :encoding "shift_jis" :encodings ["shift_jis" "utf-8"] :file "kaikei-moneyforward-invoices.csv" :mime "text/csv"}
   {:id "mf-invoice-json" :content :invoices :label "MF クラウド請求書 API JSON（Billing）" :kind :json
    :encoding "utf-8" :file "kaikei-moneyforward-invoices.json" :mime "application/json"}
   {:id "zoho-invoice-json" :content :invoices :read-only true :label "Zoho Invoice API JSON（invoice、読むだけ）"
    :kind :json :encoding "utf-8"}
   {:id "freshbooks-invoice-json" :content :invoices :read-only true :label "FreshBooks API JSON（invoices・bills、読むだけ）"
    :kind :json :encoding "utf-8"}
   {:id "ofx" :content :statements :read-only true :label "OFX・QFX・QBO（銀行・カードの明細、読むだけ）"
    :kind :ofx :encoding "utf-8"}
   {:id "freee-statement-csv" :content :statements :label "freee 会計 明細 CSV（銀行・カードのテンプレート）" :kind :csv
    :encoding "utf-8" :encodings ["utf-8" "utf-8-bom" "shift_jis"] :file "kaikei-freee-statement.csv" :mime "text/csv"}
   {:id "mf-statement-csv" :content :statements :label "マネーフォワード クラウド会計 明細 CSV" :kind :csv
    :encoding "shift_jis" :encodings ["shift_jis" "utf-8"] :file "kaikei-moneyforward-statement.csv" :mime "text/csv"}
   {:id "xero-statement-csv" :content :statements :label "Xero 明細 CSV（bank statement）" :kind :csv
    :encoding "utf-8" :encodings ["utf-8" "utf-8-bom"] :file "kaikei-xero-statement.csv" :mime "text/csv"}
   {:id "qbo-bank-csv" :content :statements :label "QuickBooks Online 明細 CSV（bank transactions）" :kind :csv
    :encoding "utf-8" :encodings ["utf-8" "utf-8-bom"] :file "kaikei-quickbooks-bank.csv" :mime "text/csv"}
   {:id "zengin" :content :statements :read-only true
    :label "全銀協 入出金取引明細・振込入金通知（固定長・全銀 CSV、読むだけ）" :kind :zengin :encoding "shift_jis"}
   {:id "statement-csv" :content :statements :read-only true
    :label "汎用の明細 CSV（列を割り当てる・銀行とカードの型、読むだけ）" :kind :csv :encoding "utf-8"}])

(def format-ids (mapv :id formats))

(def export-formats
  "書き出せる形式（読むだけの形式を除く）。"
  (filterv (complement :read-only) formats))

(def export-format-ids (mapv :id export-formats))

(def ledger-export-formats
  "帳簿全体を書き出す形式（画面のツールバー）。明細の形式は口座ごとに「明細」タブから。"
  (filterv #(not= :statements (:content %)) export-formats))

(def statement-export-formats (filterv #(= :statements (:content %)) export-formats))

(defn content-formats
  "content（:journal・:invoices・:statements）を書ける形式。kaikei-json はどれにも入る。"
  [content]
  (filterv #(#{content :all} (:content %)) formats))

(defn format-by-id [id] (first (filter #(= id (:id %)) formats)))

(defn encoding-label [e]
  (case e "utf-8" "UTF-8" "utf-8-bom" "UTF-8（BOM 付き）" "shift_jis" "Shift_JIS" (str e)))

;; ───────── 判定 ─────────

(defn- json-text? [s] (boolean (text/re-find #"^\s*[\[{]" (or s ""))))

(defn detect-json [data]
  (cond
    (native/detect? data) "kaikei-json"
    ;; 請求書の形は仕訳の形より先に見る（Xero の Invoices と Accounts を 1 つの JSON に
    ;; 入れたもの、QBO の QueryResponse に Invoice・Bill があるもの）
    (xero-invoices/detect? data) "xero-invoices-json"
    (qbo-invoices/detect? data) "qbo-invoices-json"
    (freee-invoices/detect? data) "freee-invoice-json"
    (mf-invoices/detect? data) "mf-invoice-json"
    (zoho-invoices/detect? data) "zoho-invoice-json"
    (freshbooks-invoices/detect? data) "freshbooks-invoice-json"
    (xero/detect? data) "xero-json"
    (qbo/detect? data) "qbo-json"
    :else nil))

(defn detect-csv [rows]
  (cond
    ;; 明細の CSV は見出しが短いので、仕訳・請求書の形（見出しに勘定科目や請求書番号が
    ;; ある）と重ならない条件だけで見る
    (statement-csv/freee-kind rows) "freee-statement-csv"
    (statement-csv/mf-detect? rows) "mf-statement-csv"
    (statement-csv/qbo-detect? rows) "qbo-bank-csv"
    (statement-csv/xero-detect? rows) "xero-statement-csv"
    (zengin/csv-detect? rows) "zengin"
    (statement-csv/detect-preset rows) "statement-csv"
    (freee-invoices/csv-detect? rows) "freee-invoice-csv"
    (mf-invoices/csv-detect? rows) "mf-invoice-csv"
    (xero-invoices/csv-detect? rows) "xero-invoice-csv"
    (qbo-invoices/csv-detect? rows) "qbo-invoice-csv"
    (mf/detect? rows) "mf"
    (freee/detect? rows) "freee"
    (qbo/csv-detect? rows) "qbo-csv"
    (xero/csv-detect? rows) "xero-csv"
    (yayoi/detect? rows) "yayoi"
    :else nil))

;; ───────── 取り込み ─────────

(defn- empty-result [fmt warning]
  {:format (some-> fmt keyword) :entries [] :accounts [] :rejected 0 :warnings [warning]})

(defn ingest-text
  "文字列 → 取り込み結果（kaikei.compat.common の形）。opts:
  :format   \"auto\"（既定）か format-ids のどれか
  :currency Xero／QBO の取り込みで、応答に通貨が無いときの帳簿の通貨（既定 JPY）
  :date-order QBO・Xero の CSV の数だけの日付の並び（\"mdy\"・\"dmy\"。無ければ推す）
  :mapping  汎用の明細 CSV の列の割り当て（kaikei.compat.statement-csv）"
  [s {:keys [format currency date-order mapping] :or {format "auto" currency "JPY"}}]
  (let [opts (cond-> {:currency currency} date-order (assoc :date-order date-order))
        ofx? (or (= format "ofx") (and (= format "auto") (ofx/detect-text? s)))
        zengin-fixed? (or (and (= format "zengin") (zengin/detect-text? s))
                          (and (= format "auto") (zengin/detect-text? s)))
        json-format? (= :json (:kind (format-by-id format)))
        data (when (or json-format? (and (= format "auto") (json-text? s)))
               (try (json/parse s) (catch #?(:cljs :default :clj Exception) e ::bad)))
        ;; 形式を指定したら、その形式の種類（JSON か CSV）で読む。判定に任せるときは、
        ;; [ で始まっても JSON として読めないもの（freee の [表題行]）を CSV として読む。
        json? (if (= format "auto") (and (some? data) (not= data ::bad)) json-format?)]
    (cond
      ofx? (ofx/read-text s)
      zengin-fixed? (zengin/read-text s)
      json?
      (if (= data ::bad)
        (empty-result format "JSON として読めません")
        (let [fmt (if (= format "auto") (detect-json data) format)]
          (case fmt
            "kaikei-json" (native/read-data data)
            "xero-json" (xero/read-data data opts)
            "qbo-json" (qbo/read-data data opts)
            "xero-invoices-json" (xero-invoices/read-data data opts)
            "qbo-invoices-json" (qbo-invoices/read-data data opts)
            "freee-invoice-json" (freee-invoices/read-data data)
            "mf-invoice-json" (mf-invoices/read-data data)
            "zoho-invoice-json" (zoho-invoices/read-data data opts)
            "freshbooks-invoice-json" (freshbooks-invoices/read-data data opts)
            (empty-result fmt (if (nil? fmt)
                                "JSON の形を判定できません（kaikei の帳簿 JSON、Xero の Accounts・Journals・ManualJournals・Invoices、QBO の query の応答のどれでもありません）"
                                (str (:label (format-by-id fmt)) " は JSON ではありません"))))))
      :else
      (let [rows (csv/parse s)
            fmt (if (= format "auto") (detect-csv rows) format)]
        (case fmt
          "mf" (mf/read-rows rows)
          "freee" (freee/read-rows rows)
          "yayoi" (yayoi/read-rows rows)
          "qbo-csv" (qbo/read-csv rows opts)
          "xero-csv" (xero/read-csv rows opts)
          "xero-invoice-csv" (xero-invoices/read-csv rows :sales opts)
          "xero-bill-csv" (xero-invoices/read-csv rows :purchase opts)
          "qbo-invoice-csv" (qbo-invoices/read-csv rows opts)
          "freee-invoice-csv" (freee-invoices/read-csv rows)
          "mf-invoice-csv" (mf-invoices/read-csv rows)
          "freee-statement-csv" (if (statement-csv/freee-kind rows)
                                  (statement-csv/read-freee rows)
                                  (empty-result fmt "freee の明細のテンプレートの見出し（取引日・出金額・入金額・取引内容、カードは取引日・取引金額・取引内容）がありません"))
          "mf-statement-csv" (statement-csv/read-mf rows)
          "xero-statement-csv" (statement-csv/read-xero rows opts)
          "qbo-bank-csv" (statement-csv/read-qbo rows opts)
          "zengin" (zengin/read-csv rows)
          "statement-csv" (if-let [m (or mapping (:mapping (statement-csv/detect-preset rows)))]
                            (statement-csv/read-mapped rows
                                                       (if mapping m (assoc m :preset (:id (statement-csv/detect-preset rows))))
                                                       opts)
                            (empty-result fmt "汎用の明細 CSV は、列を割り当ててから取り込んでください"))
          (empty-result fmt (if (nil? fmt)
                              "CSV の形を判定できません。形式を選んでから取り込んでください"
                              (str (:label (format-by-id fmt)) " は CSV ではありません"))))))))

(defn decode-csv
  "バイト列 → {:rows CSV の行 :encoding}（画面の列の割り当てに見出しを出すため）。"
  [b encoding]
  (let [{:keys [text] :as decoded} (enc/decode b (when-not (= encoding "auto") encoding))]
    {:rows (csv/parse text) :encoding (:encoding decoded)}))

(defn ingest-bytes
  "バイト列（Uint8Array）→ 取り込み結果 + :encoding。opts は ingest-text と同じに
  :encoding（\"auto\" か \"utf-8\" か \"shift_jis\"）を足したもの。"
  [b {:keys [encoding] :or {encoding "auto"} :as opts}]
  (let [{:keys [text] :as decoded} (enc/decode b (when-not (= encoding "auto") encoding))]
    (assoc (ingest-text text opts) :encoding (:encoding decoded))))
