   :non-operating-income
   ["受取利息" "受取配当金" "有価証券売却益" "為替差益" "雑収入" "受取手数料"
    "Interest Earned" "Interest Income" "Other Income" "Other Revenue"]
   :non-operating-expense
   ["支払利息" "支払利息割引料" "手形売却損" "為替差損" "雑損失" "有価証券売却損"
    "Interest Expense" "Interest Paid"]
   :extraordinary-gain
   ["固定資産売却益" "投資有価証券売却益" "貸倒引当金戻入額" "前期損益修正益"]
   :extraordinary-loss
   ["固定資産売却損" "固定資産除却損" "投資有価証券売却損" "減損損失" "災害による損失"
    "前期損益修正損"]
   :income-tax
   ["法人税等" "法人税、住民税及び事業税" "法人税住民税及び事業税" "法人税・住民税及び事業税"
    "法人税等調整額" "Income Tax Expense"]})

(def default-class-by-name
  (into {} (for [[k names] default-class-names, n names] [n k])))

(defn default-class
  "勘定科目名 → 区分（既定の表に無ければ nil）。"
  [account-name]
  (get default-class-by-name (some-> account-name text/trim)))

(def ^:private income-side #{:revenue :non-operating-income :extraordinary-gain})
(def ^:private expense-side #{:cost-of-sales :operating-expense :non-operating-expense
                              :extraordinary-loss :income-tax})

(defn refine-class
  "各社の型から写した区分を、勘定科目名の既定の表で細かくする。P/L の収益側・
  費用側の中でだけ動かす（各社の型は営業外・特別損益・法人税等を区別しない
  ことが多い。例: Xero の EXPENSE は 支払利息 にも 法人税等 にも付く）。
  資産・負債・純資産は各社の型をそのまま使う。"
  [vendor-class account-name]
  (let [named (default-class account-name)]
    (if (or (and (income-side vendor-class) (income-side named))
            (and (expense-side vendor-class) (expense-side named)))
      named
      vendor-class)))

;; ───────── 値モデル ─────────

(def empty-db {:version 1 :currency "JPY" :accounts {} :entries [] :invoices []})

(defn account-class
  "勘定科目の区分。登録が無ければ既定の表、それも無ければ :unclassified。"
  [db account-name]
  (or (get-in db [:accounts account-name :class])
      (default-class account-name)
      :unclassified))

(defn ensure-account
  "勘定科目を登録する（無ければ）。info は取り込み元が知っている属性
  （:class :class-source :code :qbo :xero）。既にあるものは :user の区分を
  上書きしない。取り込み元の区分（:vendor）は既定の表・未分類より強い。"
  [db account-name info]
  (let [existing (get-in db [:accounts account-name])
        incoming (merge {:name account-name} info)
        keep-class? (or (= :user (:class-source existing))
                        (and (= :vendor (:class-source existing))
                             (not= :vendor (:class-source incoming))))
        merged (merge existing
                      (dissoc incoming :class :class-source)
                      (if (and existing keep-class?)
                        (select-keys existing [:class :class-source])
                        (if (:class incoming)
                          (select-keys incoming [:class :class-source])
                          (if-let [k (default-class account-name)]
                            {:class k :class-source :default}
                            (or (not-empty (select-keys existing [:class :class-source]))
                                {:class :unclassified :class-source :none})))))]
    (assoc-in db [:accounts account-name] merged)))

(defn set-class
  "画面からの区分の指定（:user）。"
  [db account-name class]
  (if (contains? class-code class)
    (-> db
        (ensure-account account-name {})
        (update-in [:accounts account-name] assoc :class class :class-source :user))
    db))

(defn used-accounts
  "仕訳に出てくる勘定科目名（出現順を保たず、名前順）。"
  [db]
  (sort (distinct (for [e (:entries db), l (:lines e)] (:account l)))))

(defn unclassified-accounts [db]
  (filterv #(= :unclassified (account-class db %)) (used-accounts db)))

;; ───────── 仕訳の検証 ─────────

(def error-bits
  {:empty 1 :odd-buffer 2 :negative 4 :zero-line 8 :both-sides 16 :unbalanced 32})

(def problem-label
  {:empty "行がありません"
   :odd-buffer "行の形が壊れています"
   :negative "金額が負です"
   :zero-line "借方・貸方がともに 0 の行があります"
   :both-sides "1 行に借方と貸方の両方があります"
   :unbalanced "借方と貸方の合計が一致しません"
   :missing-account "勘定科目が空の行があります"
   :invalid-date "日付が読めません"})

(defn entry-buffer
  "仕訳 → guest の [debit credit] × n。"
  [entry]
  (vec (mapcat (fn [l] [(:debit l 0) (:credit l 0)]) (:lines entry))))

(defn entry-problems
  "仕訳の問題（keyword の集合。空なら正しい）。guest のエラービットに、
  勘定科目と日付の欠けを足したもの。"
  [entry]
  (let [bits (validate-entry (entry-buffer entry))]
    (cond-> (set (keep (fn [[k b]] (when (pos? (bit-and bits b)) k)) error-bits))
      (some #(text/blank? (:account %)) (:lines entry)) (conj :missing-account)
      (nil? (some-> (:date entry) parse-date)) (conj :invalid-date))))

(defn invalid-entries [db]
  (filterv (fn [e] (seq (entry-problems e))) (:entries db)))

(defn entry-totals [entry]
  {:debit (reduce + 0 (map #(:debit % 0) (:lines entry)))
   :credit (reduce + 0 (map #(:credit % 0) (:lines entry)))})

;; ───────── 取り込みの合流 ─────────

(defn- fingerprint
  "重複の判定に使う形。日付と、勘定科目・借方・貸方の多重集合。"
  [entry]
  [(:date entry) (sort (map (juxt :account #(:debit % 0) #(:credit % 0)) (:lines entry)))])

(defn- id-number [entry]
  (or (some->> (:id entry) (text/re-matches #"e(\d+)") second parse-long) 0))

(defn- sort-entries [entries]
  (vec (sort-by (juxt :date id-number) entries)))

(defn- invoice-number [inv]
  (or (some->> (:id inv) (text/re-matches #"i(\d+)") second parse-long) 0))

(defn invoice-fingerprint
  "請求書の重複の判定に使う形。種類・番号・取引先・日付・明細の金額の和。"
  [inv]
  [(:kind inv) (:number inv) (get-in inv [:partner :name]) (:date inv)
   (reduce + 0 (map #(:amount % 0) (:lines inv)))])

(defn- merge-invoices
  "請求書を合流する。戻りは [db 元の id → 帳簿の id の表 追加した数 重複の数]。
  取り込み元の id（i1, i2, …）は、帳簿で使われていなければ保つ（MCP の tool の間で
  帳簿 JSON を受け渡しても id が変わらないように）。使われていれば、used（入れ替える
  前の請求書も含めて、使ったことのある id）と取り込み元の id のどれよりも大きい
  番号を振る —— 入れ替えた請求書の id を使い回すと、残った仕訳の :invoice-id が
  別の請求書を指してしまうため。"
  [db invoices used]
  (let [own-id (fn [inv] (when (some->> (:id inv) str (text/re-matches #"i\d+")) (:id inv)))
        taken (set (concat (keep :id (:invoices db)) (keep :id used)))
        counter (atom (reduce max 0 (map invoice-number (concat (:invoices db) used invoices))))
        fresh! (fn [] (str "i" (swap! counter inc)))
        [d m added dup _ _]
        (reduce (fn [[d m added dup seen taken] inv]
                  (let [fp (invoice-fingerprint inv)
                        remember (fn [m id] (if (:id inv) (assoc m (:id inv) id) m))]
                    (if-let [id (seen fp)]
                      [d (remember m id) added (inc dup) seen taken]
                      (let [id (let [own (own-id inv)] (if (and own (not (taken own))) own (fresh!)))]
                        [(update d :invoices (fnil conj []) (assoc inv :id id))
                         (remember m id) (inc added) dup (assoc seen fp id) (conj taken id)]))))
                [db {} 0 0 (into {} (map (juxt invoice-fingerprint :id) (:invoices db))) taken]
                invoices)]
    [d m added dup]))

;; ───────── 明細の合流（第 4 スライス、JUN-327） ─────────

(defn- prefixed-number [prefix id]
  (or (some->> id str (text/re-matches (re-pattern (str prefix "(\\d+)"))) second parse-long) 0))

(defn- line-content-key
  "一意な id の無い行の重複の判定に使う形（口座・日付・金額・摘要・残高）。"
  [l]
  [(:account-id l) (:date l) (:amount l) (:description l) (:balance l)])

(defn- newer-balance [a b]
  (cond (nil? a) b (nil? b) a (neg? (compare (:date a) (:date b))) b :else a))

(defn- merge-statements
  "取り込み結果の明細（:statement-accounts :statement-lines）を db に合流する。
  戻りは [db 元の行 id → 帳簿の行 id の表 {:lines-added :lines-duplicates
  :lines-corrected} 警告]。

  口座: opts の :statement-account が帳簿の口座の id なら、すべての行をその口座へ。
  \"new\" なら新しい口座を作る。それ以外（\"auto\"）は :key（OFX は金融機関・口座の
  下 4 桁・種類、CSV は形式と種類）が同じ口座へ、無ければ新しい口座を作る。
  取り込み元の id（a1…）は帳簿で使われていなければ保つ（MCP の tool の間で帳簿 JSON を
  受け渡しても id が変わらないように）。

  重複: :uid（OFX の FITID など）があれば口座と :uid で、無ければ
  line-content-key と、同じ内容の何番目かで判定する（同じファイルを 2 回取り込んでも
  増えない。同じ日に同じ額・同じ摘要の行が 2 つあっても両方残る）。

  訂正: OFX の CORRECTFITID（:correct {:uid :action}）は、訂正される行を消す
  （計上・照合した行は消さずに警告する）。:replace なら新しい行を足す。"
  [db parsed {:keys [statement-account file]}]
  (let [existing (vec (:statement-accounts db))
        target (first (filter #(= statement-account (:id %)) existing))
        counter (atom (reduce max 0 (map #(prefixed-number "a" (:id %)) (concat existing (:statement-accounts parsed)))))
        fresh! (fn [] (str "a" (swap! counter inc)))
        taken (atom (set (map :id existing)))
        [accounts amap]
        (reduce (fn [[accs m] a]
                  (let [same (when-not (= "new" statement-account)
                               (or target
                                   (when (:key a) (first (filter #(= (:key a) (:key %)) accs)))))]
                    (if same
                      [(mapv #(if (= (:id same) (:id %))
                                (update % :statement-balance newer-balance (:statement-balance a))
                                %)
                             accs)
                       (assoc m (:id a) (:id same))]
                      (let [own (:id a)
                            id (if (and own (re-matches #"a\d+" (str own)) (not (@taken own))) own (fresh!))]
                        (swap! taken conj id)
                        [(conj accs (-> a (assoc :id id) (cond-> (= "new" statement-account) (dissoc :key))))
                         (assoc m (:id a) id)]))))
                [existing {}]
                (:statement-accounts parsed))
        lines (vec (:statement-lines db))
        status-of (let [posted (set (for [e (:entries db)
                                          :when (= :statement (get-in e [:origin :format]))
                                          id (remove nil? (cons (get-in e [:origin :line-id]) (get-in e [:origin :line-ids])))]
                                      id))]
                    (fn [l] (or (posted (:id l)) (get-in l [:match :entry-id]))))
        incoming (for [l (:statement-lines parsed)
                       :when (not= :delete (get-in l [:correct :action]))]
                   (assoc (dissoc l :correct) :account-id (get amap (:account-id l))))
        uids (set (for [l lines :when (:uid l)] [(:account-id l) (:uid l)]))
        existing-counts (frequencies (map line-content-key (remove :uid lines)))
        id-counter (atom (reduce max 0 (map #(prefixed-number "l" (:id %)) (concat lines (:statement-lines parsed)))))
        seq-counter (atom (reduce max 0 (map #(:seq % 0) lines)))
        line-taken (atom (set (map :id lines)))
        [lines lmap added dup _ _]
        (reduce (fn [[ls m added dup seen-uids seen] l]
                  (let [uid-key (when (:uid l) [(:account-id l) (:uid l)])
                        ck (line-content-key l)
                        n (get seen ck 0)]
                    (if (if uid-key (seen-uids uid-key) (< n (get existing-counts ck 0)))
                      [ls m added (inc dup) seen-uids (if uid-key seen (assoc seen ck (inc n)))]
                      (let [own (:id l)
                            id (if (and own (re-matches #"l\d+" (str own)) (not (@line-taken own)))
                                 own
                                 (str "l" (swap! id-counter inc)))]
                        (swap! line-taken conj id)
                        [(conj ls (assoc l :id id :seq (swap! seq-counter inc)))
                         (cond-> m (:id l) (assoc (:id l) id))
                         (inc added) dup
                         (cond-> seen-uids uid-key (conj uid-key))
                         (if uid-key seen (assoc seen ck (inc n)))]))))
                [lines {} 0 0 uids {}]
                incoming)
        ;; 訂正（同じファイルの中の行にも当てる）。訂正される行を消す。計上・照合した行は
        ;; 消さずに警告する。REPLACE の新しい行はもう足してある
        corrections (for [l (:statement-lines parsed) :when (:correct l)]
                      [(get amap (:account-id l)) (:correct l) (:uid l)])
        [lines corrected warnings]
        (reduce (fn [[ls n ws] [acc {:keys [uid]} own-uid]]
                  (let [victim (first (filter #(and (= acc (:account-id %)) (= uid (:uid %)) (not= own-uid (:uid %))) ls))]
                    (cond
                      (nil? victim) [ls n ws]
                      (status-of victim) [ls n (conj ws (str "訂正された明細の行 " (:date victim) " " (:description victim "")
                                                            " は計上・照合済みなので消していません"))]
                      :else [(filterv #(not= (:id victim) (:id %)) ls) (inc n) ws])))
                [lines 0 []]
                corrections)]
    (let [;; 元のファイル（判断 5）: 行を足したときだけ、ファイルの id を振って行に付ける。
          ;; 帳簿にはファイルの名前・SHA-256・大きさ・取り込みの時刻だけを持つ（バイト列は
          ;; 画面が IndexedDB の別の store に持つ）
          file-id (when (and file (pos? added))
                    (str "f" (inc (reduce max 0 (map #(prefixed-number "f" (:id %)) (:files db))))))
          before (set (map :id (:statement-lines db)))
          lines (if file-id
                  (mapv #(if (before (:id %)) % (assoc % :file-id file-id)) lines)
                  lines)]
      [(cond-> (assoc db :statement-accounts accounts :statement-lines lines)
         file-id (update :files (fnil conj [])
                         (merge (select-keys file [:name :sha256 :size :imported-at :format])
                                {:id file-id
                                 :account-ids (vec (distinct (keep #(when (= file-id (:file-id %)) (:account-id %)) lines)))})))
       lmap
       (cond-> {:lines-added added :lines-duplicates dup :lines-corrected corrected}
         file-id (assoc :file-id file-id))
       warnings])))

(defn- merge-rules
  "利用者の規則と明細の設定を合流する（同じ条件と同じ結果の規則は足さない）。"
  [db parsed replace?]
  (let [db (cond-> db
             (and (:statement-settings parsed) (or replace? (nil? (:statement-settings db))))
             (assoc :statement-settings (:statement-settings parsed)))
        existing (set (map (juxt :when :then) (:rules db)))
        counter (atom (reduce max 0 (map #(prefixed-number "r" (:id %)) (concat (:rules db) (:rules parsed)))))
        taken (atom (set (map :id (:rules db))))]
    (reduce (fn [d r]
              (if (existing [(:when r) (:then r)])
                d
                (let [own (:id r)
                      id (if (and own (not (@taken own))) own (str "r" (swap! counter inc)))]
                  (swap! taken conj id)
                  (update d :rules (fnil conj []) (assoc r :id id)))))
            db
            (:rules parsed))))

(defn merge-import
  "取り込み結果（{:currency :accounts [{:name …}] :entries […] :invoices […]
  :statement-accounts […] :statement-lines […] :rules […]}）を db に合流する。mode は
  :append（既定。同じ日付・同じ行の仕訳、同じ請求書、同じ明細の行は重複として
  飛ばす）か :replace（取り込み結果が持つものを入れ替える。:entries があれば
  仕訳と勘定科目 —— ただし画面で付けた区分は残す。:invoices があれば請求書。
  :statement-lines があれば明細の口座と行。:rules があれば利用者の規則）。

  行の :account-code（Xero の CSV のように勘定科目のコードしか無い形式が付ける）は、
  帳簿の勘定科目のコード（:code・:xero :code）で名前に引き直す。

  請求書・仕訳・明細の口座と行には、取り込み元の id（i1・e1・a1・l1…）が帳簿で
  使われていなければそれを保ち、使われていれば新しい番号を振る（MCP の tool の間で
  帳簿 JSON を受け渡しても id が変わらないように）。振り直したときは、仕訳の origin の
  :invoice-id・:allocations・:line-id・:line-ids と、明細の行の :match も合わせる。
  合わせる先の無い :invoice-id は外す。:business・:invoice-settings・
  :statement-settings は、帳簿に無ければ取り込み結果のものを使う（:replace では
  取り込み結果のものが勝つ）。

  opts の :statement-account は明細を入れる口座（帳簿の口座の id、\"new\"、
  \"auto\"。merge-statements）。

  通貨が違う帳簿へは合流しない（1 帳簿 1 通貨）。:replace で仕訳を入れ替えて
  通貨が変わるとき、残せなかった請求書と明細の行の数を :invoices-dropped・
  :lines-dropped に返す。戻りは {:db :added :duplicates :invoices-added
  :invoices-duplicates :invoices-dropped :lines-added :lines-duplicates
  :lines-corrected :lines-dropped :warnings :error}。"
  ([db parsed] (merge-import db parsed :append))
  ([db parsed mode] (merge-import db parsed mode {}))
  ([db parsed mode opts]
   (let [currency (or (:currency parsed) (:currency db))
         replace? (= mode :replace)
         ;; :replace は取り込み結果が持つものだけを入れ替える: :entries があれば
         ;; 仕訳と勘定科目（画面で付けた区分は残す）、:invoices があれば請求書、
         ;; :statement-lines があれば明細、:rules があれば利用者の規則
         replace-entries? (and replace? (contains? parsed :entries))
         replace-invoices? (and replace? (contains? parsed :invoices))
         replace-statements? (and replace? (contains? parsed :statement-lines))
         base (cond-> db
                replace-entries? (assoc :entries []
                                        :accounts (into {} (filter #(= :user (:class-source (val %))) (:accounts db))))
                replace-invoices? (assoc :invoices [])
                replace-statements? (assoc :statement-accounts [] :statement-lines [])
                (and replace? (contains? parsed :rules)) (assoc :rules []))
         ;; 仕訳を入れ替えて通貨が変わるとき、残る請求書と明細は残せない（1 帳簿 1 通貨）
         currency-change? (and replace-entries? (not= currency (:currency db)))
         dropped (if currency-change? (count (:invoices base)) 0)
         lines-dropped (if currency-change? (count (:statement-lines base)) 0)
         base (cond-> base
                (pos? dropped) (assoc :invoices [])
                (pos? lines-dropped) (assoc :statement-accounts [] :statement-lines []))]
     (if (and (or (seq (:entries base)) (seq (:invoices base)) (seq (:statement-lines base)))
              (not= currency (:currency base)))
       {:db db :added 0 :duplicates 0 :invoices-added 0 :invoices-duplicates 0
        :error (str "帳簿の通貨は " (:currency base) " です。" currency " の仕訳・請求書・明細は合流しません（1 帳簿 1 通貨）。")}
       (let [base (cond-> (assoc base :currency currency)
                    (and (:business parsed) (or replace? (nil? (:business base))))
                    (assoc :business (:business parsed))
                    (and (:invoice-settings parsed) (or replace? (nil? (:invoice-settings base))))
                    (assoc :invoice-settings (:invoice-settings parsed)))
             with-accounts (reduce (fn [d a] (ensure-account d (:name a) (dissoc a :name)))
                                   base (:accounts parsed))
             by-code (into {} (for [[n a] (:accounts with-accounts)
                                    c (distinct (remove nil? [(:code a) (get-in a [:xero :code])]))]
                                [c n]))
             ;; 請求書の行のコード（Xero の CSV の AccountCode）も、帳簿の勘定科目の名前に引き直す
             ;; （:account-code は書き出しで同じコードに戻すために残す）
             resolve-invoice (fn [inv]
                               (update inv :lines
                                       (fn [ls] (mapv (fn [l]
                                                        (if-let [n (some-> (:account-code l) by-code)]
                                                          (assoc l :account n)
                                                          l))
                                                      ls))))
             [with-accounts invoice-ids inv-added inv-dup]
             (merge-invoices with-accounts (map resolve-invoice (:invoices parsed)) (:invoices db))
             [with-accounts line-ids statement-counts statement-warnings]
             (merge-statements with-accounts parsed opts)
             with-accounts (merge-rules with-accounts parsed replace?)
             resolve-codes (fn [e]
                             (update e :lines
                                     (fn [ls] (mapv (fn [l]
                                                      (if-let [c (:account-code l)]
                                                        (dissoc (assoc l :account (get by-code c (:account l))) :account-code)
                                                        l))
                                                    ls))))
             relink (fn [e]
                      (let [e (if-let [iid (get-in e [:origin :invoice-id])]
                                (if-let [id (get invoice-ids iid)]
                                  (assoc-in e [:origin :invoice-id] id)
                                  (update e :origin dissoc :invoice-id))
                                e)
                            e (if (seq (get-in e [:origin :allocations]))
                                (update-in e [:origin :allocations]
                                           (fn [as] (mapv #(update % :invoice-id (fn [i] (get invoice-ids i i))) as)))
                                e)
                            e (if-let [lid (get-in e [:origin :line-id])]
                                (assoc-in e [:origin :line-id] (get line-ids lid lid))
                                e)]
                        (if (seq (get-in e [:origin :line-ids]))
                          (update-in e [:origin :line-ids] (fn [ls] (mapv #(get line-ids % %) ls)))
                          e)))
             ;; 帳簿にコードの登録が無いコードは、そのコードを名前にした勘定科目として
             ;; コードごと登録する（書き出しで同じコードに戻るように）
             unresolved (distinct (for [e (:entries parsed), l (:lines e)
                                        :let [c (:account-code l)]
                                        :when (and c (not (contains? by-code c)))]
                                    c))
             with-accounts (reduce (fn [d c] (ensure-account d c {:code c :xero {:code c}})) with-accounts unresolved)
             parsed-entries (map (comp relink resolve-codes) (:entries parsed))
             seen (into {} (map (juxt fingerprint :id) (:entries with-accounts)))
             counter (atom (reduce max 0 (map id-number (concat (:entries with-accounts) (:entries parsed)))))
             taken (atom (set (map :id (:entries with-accounts))))
             [db' added dup _ entry-ids]
             (reduce (fn [[d added dup seen emap] e]
                       (let [fp (fingerprint e)
                             remember (fn [m id] (if (:id e) (assoc m (:id e) id) m))]
                         (if-let [same (get seen fp)]
                           [d added (inc dup) seen (remember emap same)]
                           (let [own (:id e)
                                 id (if (and own (re-matches #"e\d+" (str own)) (not (@taken own)))
                                      own
                                      (str "e" (swap! counter inc)))
                                 d (reduce (fn [d l] (ensure-account d (:account l) {})) d (:lines e))]
                             (swap! taken conj id)
                             [(update d :entries conj (assoc e :id id))
                              (inc added) dup (assoc seen fp id) (remember emap id)]))))
                     [with-accounts 0 0 seen {}]
                     parsed-entries)
             ;; 元のファイルの記録（kaikei-json が運ぶ）: 同じ SHA-256 は 1 つに、id は空いていれば保つ
             [db' file-ids]
             (reduce (fn [[d m] f]
                       (if-let [same (first (filter #(= (:sha256 f) (:sha256 %)) (:files d)))]
                         [d (assoc m (:id f) (:id same))]
                         (let [taken (set (map :id (:files d)))
                               id (if (taken (:id f))
                                    (str "f" (inc (reduce max 0 (map #(prefixed-number "f" (:id %)) (:files d)))))
                                    (:id f))]
                           [(update d :files (fnil conj []) (assoc f :id id)) (assoc m (:id f) id)])))
                     [(cond-> db' (and replace? (contains? parsed :files)) (assoc :files [])) {}]
                     (:files parsed))
             ;; 取り込んだ明細の行の照合（:match）を、振り直した仕訳の id に合わせる
             new-lines (set (vals line-ids))
             db' (update db' :statement-lines
                         (fn [ls] (mapv (fn [l]
                                          (if (and (new-lines (:id l)) (:file-id l) (contains? file-ids (:file-id l)))
                                            (assoc l :file-id (get file-ids (:file-id l)))
                                            l))
                                        ls)))
             db' (update db' :statement-lines
                         (fn [ls] (mapv (fn [l]
                                          (if-let [m (and (new-lines (:id l)) (get-in l [:match :entry-id]))]
                                            (if-let [id (get entry-ids m)]
                                              (assoc-in l [:match :entry-id] id)
                                              (dissoc l :match))
                                            l))
                                        ls)))]
         (cond-> (merge {:db (update db' :entries sort-entries)
                         :added added :duplicates dup
                         :invoices-added inv-added :invoices-duplicates inv-dup}
                        statement-counts)
           (seq statement-warnings) (assoc :warnings statement-warnings)
           (pos? dropped) (assoc :invoices-dropped dropped)
           (pos? lines-dropped) (assoc :lines-dropped lines-dropped)))))))

(defn delete-entry [db id]
  (update db :entries #(filterv (fn [e] (not= id (:id e))) %)))

(defn append-entry
  "仕訳を 1 つ足す（重複の判定はしない —— 請求書の計上のように、呼ぶ側が
  origin で判定するもの）。id を振り、勘定科目を登録する。戻りは
  [db 振った id]。"
  [db entry]
  (let [id (str "e" (inc (reduce max 0 (map id-number (:entries db)))))
        db (reduce (fn [d l] (ensure-account d (:account l) {})) db (:lines entry))]
    [(update db :entries #(sort-entries (conj (vec %) (assoc entry :id id)))) id]))

;; ───────── 帳票 ─────────

(def min-date 0)
(def max-date 99991231)

(defn statement-buffer
  "db → guest の [date class debit credit] × n。"
  [db]
  (let [cls (memoize #(class-code (account-class db %)))]
    (vec (for [e (:entries db)
               :let [d (some-> (:date e) date-int)]
               :when d
               l (:lines e)
               x [d (cls (:account l)) (:debit l 0) (:credit l 0)]]
           x))))

(defn- account-buckets
  "勘定科目ごとの {:before 期首前の純額 :debit 期中借方 :credit 期中貸方}
  （1 回なめるだけ）。"
  [db from to]
  (reduce (fn [acc [d account debit credit]]
            (cond
              (< d from) (update-in acc [account :before] (fnil + 0) (- debit credit))
              (<= d to) (-> acc
                            (update-in [account :debit] (fnil + 0) debit)
                            (update-in [account :credit] (fnil + 0) credit))
              :else acc))
          {}
          (for [e (:entries db)
                :let [d (some-> (:date e) date-int)]
                :when d
                l (:lines e)]
            [d (:account l) (:debit l 0) (:credit l 0)])))

(defn- sort-accounts [db accounts]
  (sort-by (juxt #(class-code (account-class db %)) #(get-in db [:accounts % :code] "") identity) accounts))

(def retained-label "繰越損益（期首前の損益の累計）")

(defn trial-balance
  "残高試算表 [from, to]。行は勘定科目ごとに
  {:account :class :opening :debit :credit :closing}（:opening・:closing は
  借方 − 貸方の純額）。B/S の科目は期首前の累計を :opening に、P/L の科目は
  期間の分だけを数える。期首前の損益は :retained 行（純資産）にまとめる。
  合計は {:debit :credit :closing}（:closing は 0 なら貸借一致）。"
  [db from to]
  (let [buckets (account-buckets db from to)
        rows (vec (for [a (sort-accounts db (keys buckets))
                        :let [{:keys [before debit credit]} (buckets a)
                              k (account-class db a)
                              opening (if (pl-class? k) 0 (or before 0))
                              debit (or debit 0)
                              credit (or credit 0)]
                        :when (or (not (zero? opening)) (pos? debit) (pos? credit))]
                    {:account a :class k :opening opening :debit debit :credit credit
                     :closing (+ opening (- debit credit))}))
        retained (reduce + 0 (for [[a {:keys [before]}] buckets
                                   :when (pl-class? (account-class db a))]
                               (or before 0)))
        rows (cond-> rows
               (not (zero? retained))
               (conj {:account retained-label :class :equity :synthetic :retained
                      :opening retained :debit 0 :credit 0 :closing retained}))]
    {:from from :to to
     :rows rows
     :totals {:debit (reduce + 0 (map :debit rows))
              :credit (reduce + 0 (map :credit rows))
              :closing (reduce + 0 (map :closing rows))}}))

(defn- section
  "区分 k の科目と合計（正の側で見た額）。"
  [db rows k amount-of]
  (let [sign (normal-sign (class-code k))
        accounts (vec (for [r rows
                            :when (= k (:class r))
                            :let [v (* sign (amount-of r))]
                            :when (not (zero? v))]
                        {:account (:account r) :amount v :synthetic (:synthetic r)}))]
    {:class k :accounts accounts :total (reduce + 0 (map :amount accounts))}))

(def stage-keys [:gross :operating :ordinary :pre-tax :net])

(def stage-label
  {:gross "売上総利益" :operating "営業利益" :ordinary "経常利益"
   :pre-tax "税引前当期純利益" :net "当期純利益"})

(defn profit-and-loss
  "損益計算書 [from, to]。{:sections [区分ごと] :stages {:gross … :net}}。
  段階利益は guest の profit-stage と同じ式（profit-stages-from）。"
  [db from to]
  (let [{:keys [rows]} (trial-balance db from to)
        sections (mapv #(section db rows % (fn [r] (- (:debit r) (:credit r)))) pl-classes)
        by-code (into {} (map (fn [s] [(class-code (:class s)) (:total s)]) sections))]
    {:from from :to to
     :sections sections
     :stages (zipmap stage-keys (profit-stages-from #(get by-code % 0)))}))

(defn balance-sheet
  "貸借対照表（to 時点、当期は from から）。{:sections [区分ごと] :retained
  :net-income :totals {:assets :liabilities :equity :difference}}。:equity は
  純資産の科目 + 繰越損益 + 当期純利益。:difference = 資産 − (負債 + 純資産)
  で、0 なら一致（guest の bs-difference と同じ値）。"
  [db from to]
  (let [{:keys [rows]} (trial-balance db from to)
        bs-rows (remove #(= :retained (:synthetic %)) rows)
        sections (mapv #(section db bs-rows % :closing) bs-classes)
        total-of (fn [ks] (reduce + 0 (map :total (filter #((set ks) (:class %)) sections))))
        retained (- (reduce + 0 (map :closing (filter #(= :retained (:synthetic %)) rows))))
        net-income (get-in (profit-and-loss db from to) [:stages :net])
        assets (total-of [:current-asset :non-current-asset :deferred-asset])
        liabilities (total-of [:current-liability :non-current-liability])
        equity (+ (total-of [:equity]) retained net-income)]
    {:from from :to to
     :sections sections
     :retained retained
     :net-income net-income
     :totals {:assets assets :liabilities liabilities :equity equity
              :difference (- assets (+ liabilities equity))}}))

(defn checks
  "帳票の前提の検査。guest と同じ判定を statement-buffer に掛ける。"
  [db to]
  (let [buf (statement-buffer db)]
    {:buffer-valid? (= 1 (statement-buffer-valid? buf))
     :unclassified-lines (unclassified-count buf)
     :unclassified-accounts (unclassified-accounts db)
     :invalid-entries (count (invalid-entries db))
     :bs-difference (bs-difference buf to)
     :balanced? (= 1 (statement-balanced? buf to))}))

;; ───────── 期間 ─────────

(defn date-range
  "仕訳の最初と最後の日付（\"YYYY-MM-DD\"）。仕訳が無ければ nil。"
  [db]
  (let [ds (sort (keep #(some-> (:date %) parse-date) (:entries db)))]
    (when (seq ds) [(first ds) (last ds)])))

(defn fiscal-years
  "仕訳のある会計年度 [{:from :to :label}]（新しい順）。start-month は期首の月
  （1..12）。"
  [db start-month]
  (when-let [[first-d last-d] (date-range db)]
    (let [fy-of (fn [d] (let [y (parse-long (subs d 0 4)) m (parse-long (subs d 5 7))]
                          (if (>= m start-month) y (dec y))))]
      (vec (for [y (range (fy-of last-d) (dec (fy-of first-d)) -1)
                 :let [from (ymd y start-month 1)
                       end-y (if (= start-month 1) y (inc y))
                       end-m (if (= start-month 1) 12 (dec start-month))
                       to (ymd end-y end-m (days-in-month end-y end-m))]]
             {:from from :to to
              :label (if (= start-month 1) (str y " 年") (str y " 年度（" from " 〜 " to "）"))})))))

(defn months
  "仕訳のある月 [{:from :to :label}]（新しい順）。"
  [db]
  (vec (for [ym (reverse (sort (distinct (keep #(some-> (:date %) parse-date (subs 0 7)) (:entries db)))))
             :let [y (parse-long (subs ym 0 4)) m (parse-long (subs ym 5 7))]]
         {:from (ymd y m 1) :to (ymd y m (days-in-month y m)) :label (str y " 年 " m " 月")})))

;; ───────── サンプル ─────────

(def sample-import
  "画面の「サンプルを読み込む」とテストが使う帳簿。仕訳は guest の
  sample-ledger と同じ数（区分も同じ）。会計年度は 2026-04-01 〜 2027-03-31。
  請求書は 3 件（未計上）。自社の登録番号 T1234567890123 は国税庁 Q&A 問 54 の
  記載例の番号で、取引先も含めてすべて合成の値。明細は 1 口座 5 行と利用者の規則
  1 つ（第 4 スライス）。"
  (let [e (fn [date memo & lines]
            {:date date :memo memo
             :lines (vec (for [[account debit credit] lines]
                           {:account account :debit debit :credit credit}))})]
    {:format :sample
     :currency "JPY"
     :accounts []
     :entries [(e "2026-03-31" "開始仕訳（元入金）" ["普通預金" 1000000 0] ["元入金" 0 1000000])
               (e "2026-04-01" "設備資金の借入" ["普通預金" 200000 0] ["長期借入金" 0 200000])
               (e "2026-04-10" "4 月分の売上" ["売掛金" 330000 0] ["売上高" 0 330000])
               (e "2026-04-20" "商品の仕入" ["仕入高" 110000 0] ["普通預金" 0 110000])
               (e "2026-05-25" "事務所の家賃" ["地代家賃" 80000 0] ["普通預金" 0 80000])
               (e "2026-06-30" "預金利息" ["普通預金" 500 0] ["受取利息" 0 500])
               (e "2026-07-15" "借入金の利息" ["支払利息" 2000 0] ["普通預金" 0 2000])
               (e "2026-08-01" "備品の売却損" ["固定資産売却損" 10000 0] ["普通預金" 0 10000])
               (e "2026-09-01" "引当金の戻入" ["普通預金" 5000 0] ["貸倒引当金戻入額" 0 5000])
               (e "2027-03-31" "法人税等の計上" ["法人税等" 30000 0] ["未払法人税等" 0 30000])]
     :business {:name "サンプル商店" :registration "T1234567890123"}
     :invoices [{:id "s1" :kind :sales :number "INV-0001" :date "2026-10-31" :due-date "2026-11-30"
                 :status :issued :partner {:name "株式会社みなと"} :subject "10 月分"
                 :tax-mode :exclusive :rounding :floor
                 :lines [{:description "ウェブサイトの保守（10 月分）" :quantity "1" :unit-price "50000"
                          :amount 50000 :account "売上高" :category :taxable :rate 1000}
                         {:description "打ち合わせの弁当" :quantity "5" :unit-price "800"
                          :amount 4000 :account "売上高" :category :taxable :rate 800 :reduced? true}]}
                {:id "s2" :kind :sales :number "INV-0002" :date "2026-11-15" :due-date "2026-12-31"
                 :status :draft :partner {:name "合同会社かもめ"} :subject "ロゴの制作"
                 :tax-mode :inclusive :rounding :floor
                 :lines [{:description "ロゴの制作" :quantity "1" :unit-price "33000"
                          :amount 33000 :account "売上高" :category :taxable :rate 1000}]}
                {:id "s3" :kind :purchase :number "A-102" :date "2026-10-20" :due-date "2026-11-30"
                 :status :issued :partner {:name "やまだ文具"} :subject "事務用品"
                 :tax-mode :exclusive :rounding :floor
                 :lines [{:description "コピー用紙" :quantity "3" :unit-price "1100"
                          :amount 3300 :account "消耗品費" :category :taxable :rate 1000}]
