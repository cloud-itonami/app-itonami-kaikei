(ns kaikei.mcp
  "kaikei を itonami agent の tool にする MCP の中身（Linear JUN-304）。

  `bin/kaikei-mcp` が stdio の JSON-RPC をここへ渡し、ここが応答を返す。この
  ns は I/O をしない —— 1 通のメッセージ（文字列キーの map）を受けて、応答の
  map（通知なら nil）を返す純関数だけを持つ。判定は画面と同じ adapter
  （kaikei.core / ingest / export）で、書き直さない。

  tool は 8 つ。どれも送信せず、保存せず、各社（MoneyForward・freee・弥生・
  QuickBooks・Xero・Zoho・FreshBooks）の API にも、国税庁の公表サイトにも接続しない:

    kaikei_import          仕訳・請求書のファイル（テキストか base64 のバイト列）→ kaikei の帳簿 JSON
    kaikei_validate        帳簿 JSON の検査（貸借一致・未分類の勘定科目・問題のある仕訳）
    kaikei_report          帳簿 JSON → 試算表・P/L・B/S（kaikei・QBO・Xero の形）
    kaikei_export          帳簿 JSON → 各形式のテキスト（Shift_JIS は base64）
    kaikei_convert         仕訳・請求書のファイル → 別の形式（import と export を 1 回で）
    kaikei_invoice_totals  請求書の明細 → 税率ごとの対価・消費税額・合計（1 請求書・税率ごとに 1 回の端数処理）
    kaikei_invoice_check   帳簿 JSON の請求書の検査（適格請求書の記載事項の欠け・税額の差・経過措置の割合）
    kaikei_invoice_post    帳簿 JSON の請求書から売掛・買掛の仕訳を起こす

  帳簿 JSON は kaikei.ledger.v1（kaikei.compat.native）。請求書（invoices）も
  運ぶ（第 3 スライス、JUN-321）。tool の間で受け渡す。

  入力の不正は JSON-RPC の error ではなく tool の結果（isError true、本文は
  {\"error\" \"<名前>\" …}）で返す。"
  (:require [kotoba.lang.text :as text]
            [kaikei.core :as core]
            [kaikei.encoding :as enc]
            [kaikei.export :as export]
            [kaikei.ingest :as ingest]
            [kaikei.invoice :as invoice]
            [kaikei.json :as json]
            [kaikei.compat.common :as common]
            [kaikei.compat.native :as native]))

(def server-name "kaikei")
(def server-version "0.2.0")
(def default-protocol-version "2024-11-05")

(def max-bytes
  "取り込む文字列・バイト列の上限（UTF-8 バイト）。"
  (* 5 1024 1024))

;; ───────── 入力の検査 ─────────

(defn- tool-error [code & {:as detail}]
  (ex-info code {::tool-error (merge {"error" code} detail)}))

(defn- reject-unknown [args allowed]
  (when-let [extra (seq (remove (set allowed) (keys args)))]
    (throw (tool-error "unknown-argument" "arguments" (vec (sort extra))))))

(defn- enum-arg [args k allowed default]
  (let [v (get args k default)]
    (if (some #(= v %) allowed)
      v
      (throw (tool-error "invalid-argument" "argument" k "expected" (vec allowed))))))

(defn- date-arg [args k]
  (let [v (get args k)]
    (or (when (string? v) (core/parse-date v))
        (throw (tool-error "invalid-date" "argument" k "expected" "YYYY-MM-DD")))))

(defn- input-bytes
  "text か bytes_base64 のどちらか 1 つ → Uint8Array。"
  [args]
  (let [t (get args "text")
        b (get args "bytes_base64")]
    (cond
      (and t b) (throw (tool-error "invalid-argument" "detail" "give text or bytes_base64, not both"))
      (string? t) (let [bytes (:bytes (enc/encode t "utf-8"))]
                    (if (> (enc/bytes-length bytes) max-bytes)
                      (throw (tool-error "input-too-large" "limit_bytes" max-bytes))
                      bytes))
      (string? b) (let [bytes (try (enc/base64->bytes b)
                                   (catch #?(:cljs :default :clj Exception) _
                                     (throw (tool-error "invalid-base64" "argument" "bytes_base64"))))]
                    (if (> (enc/bytes-length bytes) max-bytes)
                      (throw (tool-error "input-too-large" "limit_bytes" max-bytes))
                      bytes))
      :else (throw (tool-error "invalid-argument" "detail" "text or bytes_base64 is required")))))

(defn- ledger-arg
  "帳簿 JSON（kaikei.ledger.v1 のオブジェクト）→ db。"
  [args]
  (let [v (get args "ledger")]
    (when-not (native/detect? v)
      (throw (tool-error "invalid-argument" "argument" "ledger"
                         "expected" "kaikei.ledger.v1 object (kaikei_import output)")))
    (let [{:keys [warnings] :as parsed} (native/read-data v)]
      (when (seq warnings)
        (throw (tool-error "invalid-ledger" "detail" (vec warnings))))
      (:db (core/merge-import (assoc core/empty-db :currency (:currency parsed "JPY")) parsed)))))

;; ───────── 出力の形 ─────────

(defn- ledger-out [db] (json/parse (native/write db)))

(defn- checks-out [db]
  (let [to (or (some-> (core/date-range db) second core/date-int) core/max-date)
        c (core/checks db to)]
    {"balanced" (:balanced? c)
     "bs_difference" (:bs-difference c)
     "unclassified_accounts" (:unclassified-accounts c)
     "unclassified_lines" (:unclassified-lines c)
     "invalid_entries" (:invalid-entries c)}))

(defn- import-opts [args]
  (cond-> {:format (enum-arg args "format" (cons "auto" ingest/format-ids) "auto")
           :encoding (enum-arg args "encoding" ["auto" "utf-8" "shift_jis"] "auto")
           :currency (enum-arg args "currency" (sort (keys core/currency-exponent)) "JPY")}
    (get args "date_order") (assoc :date-order (enum-arg args "date_order" ["mdy" "dmy"] nil))))

(defn- read-input [args]
  (let [parsed (ingest/ingest-bytes (input-bytes args) (import-opts args))
        {:keys [db error]} (core/merge-import (assoc core/empty-db :currency (:currency parsed "JPY")) parsed)]
    (when error (throw (tool-error "currency-mismatch" "detail" error)))
    {:parsed parsed :db db}))

(defn- export-out [db fmt args]
  (let [{:keys [error text bytes encoding notes]}
        (export/export db fmt (cond-> {}
                                (get args "encoding") (assoc :encoding (get args "encoding"))
                                (get args "output_date_order") (assoc :date-order (get args "output_date_order"))))]
    (when error (throw (tool-error "cannot-export" "detail" error)))
    (cond-> {"format" fmt "encoding" encoding "notes" (vec notes)}
      (= encoding "shift_jis") (assoc "bytes_base64" (enc/bytes->base64 bytes))
      (not= encoding "shift_jis") (assoc "text" text))))

;; ───────── tools ─────────

(defn import-tool [args]
  (reject-unknown args ["text" "bytes_base64" "format" "encoding" "currency" "date_order"])
  (let [{:keys [parsed db]} (read-input args)]
    {"format" (some-> (:format parsed) name)
     "encoding" (:encoding parsed)
     "entries" (count (:entries db))
     "invoices" (count (:invoices db))
     "rejected" (+ (:rejected parsed 0) (:invoices-rejected parsed 0))
     "skipped" (:invoices-skipped parsed 0)
     "warnings" (vec (:warnings parsed))
     "checks" (checks-out db)
     "ledger" (ledger-out db)}))

(defn validate-tool [args]
  (reject-unknown args ["ledger"])
  (let [db (ledger-arg args)
        bad (core/invalid-entries db)]
    (assoc (checks-out db)
           "problems" (vec (for [e (take 100 bad)]
                             {"id" (:id e) "date" (:date e)
                              "problems" (vec (sort (map name (core/entry-problems e))))})))))

(defn report-tool [args]
  (reject-unknown args ["ledger" "report" "shape" "from" "to"])
  (let [db (ledger-arg args)
        kind (enum-arg args "report" export/reports nil)
        shape (enum-arg args "shape" export/shapes "kaikei")
        from (date-arg args "from")
        to (date-arg args "to")]
    (when (pos? (compare from to))
      (throw (tool-error "invalid-argument" "detail" "from must not be after to")))
    {"report" kind "shape" shape "from" from "to" to
     "checks" (checks-out db)
     "data" (json/parse (export/report-text db kind shape from to))}))

(defn export-tool [args]
  (reject-unknown args ["ledger" "format" "encoding" "output_date_order"])
  (let [db (ledger-arg args)
        fmt (enum-arg args "format" ingest/format-ids nil)]
    (when (get args "encoding") (enum-arg args "encoding" enc/encodings nil))
    (when (get args "output_date_order") (enum-arg args "output_date_order" common/date-orders nil))
    (export-out db fmt args)))

(defn convert-tool [args]
  (reject-unknown args ["text" "bytes_base64" "from" "to" "input_encoding" "encoding" "currency"
                        "date_order" "output_date_order"])
  (let [to-fmt (enum-arg args "to" ingest/format-ids nil)
        {:keys [parsed db]} (read-input (cond-> (select-keys args ["text" "bytes_base64" "currency" "date_order"])
                                          (get args "from") (assoc "format" (get args "from"))
                                          (get args "input_encoding") (assoc "encoding" (get args "input_encoding"))))]
    (when (get args "encoding") (enum-arg args "encoding" enc/encodings nil))
    (when (get args "output_date_order") (enum-arg args "output_date_order" common/date-orders nil))
    (merge (export-out db to-fmt args)
           {"from" (some-> (:format parsed) name)
            "entries" (count (:entries db))
            "invoices" (count (:invoices db))
            "rejected" (:rejected parsed 0)
            "warnings" (vec (:warnings parsed))})))

;; ───────── 請求書の tools（第 3 スライス、JUN-321） ─────────

(def ^:private categories ["taxable" "zero-rated" "exempt" "out-of-scope"])

(defn- plain
  "json/decimal を含む値 → JSON の数（書いて読み直す。report-tool と同じ）。"
  [v]
  (json/parse (json/write v)))

(defn- money-out [n exp] (json/decimal (core/format-amount n exp)))

(defn- group-out [g exp]
  (let [[rate x] (:key g)]
    (json/ordered [["label" (:label g)]
                   ["rate" (when-not (keyword? x) (some-> rate (core/format-amount 2) json/decimal))]
                   ["reduced" (when (true? x) true)]
                   ["category" (if (keyword? x) (name x) "taxable")]
                   ["base" (money-out (:base g) exp)]
                   ["net" (money-out (:net g) exp)]
                   ["tax" (money-out (:used-tax g) exp)]
                   ["computed_tax" (when (not= (:tax g) (:used-tax g)) (money-out (:tax g) exp))]
                   ["gross" (money-out (:gross g) exp)]])))

(defn- totals-line [exp i m]
  (when-not (map? m)
    (throw (tool-error "invalid-argument" "argument" "lines" "detail" (str "line " (inc i) " is not an object"))))
  (let [{:keys [amount error]} (core/parse-amount (get m "amount") exp)
        category (keyword (get m "category" "taxable"))
        rate (when (some? (get m "rate"))
               (or (common/percent->rate (get m "rate"))
                   (throw (tool-error "invalid-argument" "argument" "lines" "detail" (str "line " (inc i) ": rate is a percent like 10 or 8")))))]
    (when (or error (nil? (get m "amount")))
      (throw (tool-error "invalid-argument" "argument" "lines" "detail" (str "line " (inc i) ": amount is a decimal in currency units"))))
    (when-not (some #{(name category)} categories)
      (throw (tool-error "invalid-argument" "argument" "lines" "expected" categories)))
    (when (and (= category :taxable) (nil? rate))
      (throw (tool-error "invalid-argument" "argument" "lines" "detail" (str "line " (inc i) ": taxable lines need a rate"))))
    (cond-> {:amount amount :category category :description (str (get m "description" ""))}
      (= category :taxable) (assoc :rate rate :reduced? (true? (get m "reduced")))
      (not= category :taxable) (assoc :rate 0))))

(defn invoice-totals-tool [args]
  (reject-unknown args ["lines" "tax_mode" "rounding" "currency"])
  (let [currency (enum-arg args "currency" (sort (keys core/currency-exponent)) "JPY")
        exp (core/exponent currency)
        lines (get args "lines")]
    (when-not (and (sequential? lines) (seq lines))
      (throw (tool-error "invalid-argument" "argument" "lines" "detail" "a non-empty array of lines")))
    (let [inv {:tax-mode (keyword (enum-arg args "tax_mode" ["exclusive" "inclusive" "none"] "exclusive"))
               :rounding (keyword (enum-arg args "rounding" ["floor" "half-up" "ceil"] "floor"))
               :lines (vec (map-indexed (partial totals-line exp) lines))}
          t (invoice/totals inv)]
      (when-not (:valid? t)
        (throw (tool-error "invalid-invoice" "detail" "a tax rate's total is negative, or an amount is out of range")))
      (plain
       {"currency" currency
       "tax_mode" (name (:tax-mode inv))
       "rounding" (name (:rounding inv))
       "groups" (mapv #(group-out % exp) (:groups t))
       "net" (money-out (:net t) exp)
       "tax" (money-out (:tax t) exp)
       "total" (money-out (:total t) exp)
       "line_tax" (vec (for [i (range (count (:lines inv)))] (money-out (get (:line-tax t) i 0) exp)))
       "rule" "Consumption tax is computed once per invoice per tax rate (消費税法施行令 70 条の 10, 基通 1-8-15); line_tax splits it: other lines are truncated and the largest line of the rate takes the difference."}))))

(defn- invoice-check-out [db inv exp]
  (let [t (invoice/totals inv)
        posted (invoice/posted-entry db (:id inv))]
    (json/ordered
     [["id" (:id inv)]
      ["kind" (name (:kind inv))]
      ["number" (:number inv)]
      ["date" (:date inv)]
      ["status" (name (:status inv))]
      ["partner" (get-in inv [:partner :name])]
      ["registration_format_ok" (let [reg (if (= :sales (:kind inv)) (get-in db [:business :registration]) (get-in inv [:partner :registration]))]
                                  (when reg (invoice/registration-valid? reg)))]
      ["groups" (mapv #(group-out % exp) (:groups t))]
      ["total" (money-out (:total t) exp)]
      ["tax" (money-out (:tax t) exp)]
      ["problems" (mapv (fn [p] (json/ordered [["code" (name (:code p))] ["message" (invoice/problem-label p inv exp)]]))
                        (invoice/problems db inv))]
      ["missing_items" (invoice/missing-items? db inv)]
      ["posted" (some? posted)]
      ["post_blocker" (some-> (invoice/post-blocker db inv) name)]
      ["deduction_percent" (invoice/deduction-percent inv)]])))

(defn invoice-check-tool [args]
  (reject-unknown args ["ledger"])
  (let [db (ledger-arg args)
        exp (core/exponent (:currency db))
        invs (:invoices db)]
    {"invoices" (plain (mapv #(invoice-check-out db % exp) invs))
     "missing_items" (count (filter #(and (not= :void (:status %)) (invoice/missing-items? db %)) invs))
     "unposted" (count (filter #(and (#{:issued :paid} (:status %)) (nil? (invoice/post-blocker db %))) invs))
     "note" "Checks the contents a qualified invoice must state (消費税法 57 条の 4 ①). It does not certify an invoice, and it only checks the registration number's form (T + 13 digits); it does not query the NTA."}))

(defn invoice-post-tool [args]
  (reject-unknown args ["ledger" "invoice_ids" "accounting"])
  (let [db (cond-> (ledger-arg args)
             (get args "accounting")
             (assoc-in [:invoice-settings :accounting]
                       (keyword (enum-arg args "accounting" ["tax-excluded" "tax-included"] nil))))
        ids (get args "invoice_ids")
        _ (when (and (some? ids) (not (and (sequential? ids) (every? string? ids))))
            (throw (tool-error "invalid-argument" "argument" "invoice_ids" "expected" "array of invoice ids")))
        {:keys [db posted skipped]}
        (if (some? ids)
          (reduce (fn [acc id]
                    (let [{db' :db :keys [skipped]} (invoice/post (:db acc) id)]
                      (if skipped
                        (update acc :skipped conj {:id id :reason skipped})
                        (-> acc (assoc :db db') (update :posted conj id)))))
                  {:db db :posted [] :skipped []}
                  ids)
          (invoice/post-all db))]
    {"posted" posted
     "skipped" (mapv (fn [{:keys [id reason]}]
                       {"id" id "reason" (name reason)
                        "message" (get invoice/blocker-label reason "請求書がありません")})
                     skipped)
     "checks" (checks-out db)
     "ledger" (ledger-out db)}))

;; ───────── tool の宣言 ─────────

(def ^:private input-schema
  {"text" {"type" "string" "description" "The file as text (UTF-8), up to 5 MiB."}
   "bytes_base64" {"type" "string" "description" "The file's bytes in base64 (use this for Shift_JIS files), up to 5 MiB decoded."}})

(def ^:private ledger-schema
  {"type" "object" "description" "A kaikei.ledger.v1 object, as returned by kaikei_import."})

(def ^:private currency-schema
  {"type" "string" "enum" (vec (sort (keys core/currency-exponent))) "default" "JPY"
   "description" "Ledger currency when the file does not say (Xero responses, QBO without CurrencyRef, Xero/QBO CSV)."})

(def tools
  [{"name" "kaikei_import"
    "description" (str "Read a journal export (MoneyForward 仕訳帳 CSV, freee 仕訳 CSV, 弥生インポート形式, "
                       "QuickBooks Online Account/JournalEntry JSON or journal CSV, Xero Accounts/Journals/ManualJournals JSON "
                       "or manual journal CSV, or a kaikei ledger) into a kaikei ledger with checks. "
                       "Pure: nothing is sent, stored or fetched; it does not call any accounting API.")
    "inputSchema" {"type" "object"
                   "properties" (merge input-schema
                                       {"format" {"type" "string" "enum" (vec (cons "auto" ingest/format-ids)) "default" "auto"}
                                        "encoding" {"type" "string" "enum" ["auto" "utf-8" "shift_jis"] "default" "auto"}
                                        "currency" currency-schema
                                        "date_order" {"type" "string" "enum" ["mdy" "dmy"]
                                                      "description" "Numeric date order in QBO/Xero CSV; guessed when omitted."}})
                   "additionalProperties" false}
    "run" import-tool}
   {"name" "kaikei_validate"
    "description" (str "Check a kaikei ledger: whether the balance sheet balances, which accounts have no class "
                       "(they are left out of P/L and B/S, never guessed), and which entries are invalid "
                       "(unbalanced, negative, missing account, bad date).")
    "inputSchema" {"type" "object" "properties" {"ledger" ledger-schema} "required" ["ledger"]
                   "additionalProperties" false}
    "run" validate-tool}
   {"name" "kaikei_report"
    "description" (str "Trial balance, profit and loss or balance sheet for a period, as kaikei JSON or shaped like the "
                       "QuickBooks Online Report or Xero Reports API responses. Class mapping and the staged-profit and "
                       "retained-earnings rules are kaikei's, not a vendor's internal calculation.")
    "inputSchema" {"type" "object"
                   "properties" {"ledger" ledger-schema
                                 "report" {"type" "string" "enum" export/reports}
                                 "shape" {"type" "string" "enum" export/shapes "default" "kaikei"}
                                 "from" {"type" "string" "description" "Period start, YYYY-MM-DD."}
                                 "to" {"type" "string" "description" "Period end (balance sheet date), YYYY-MM-DD."}}
                   "required" ["ledger" "report" "from" "to"]
                   "additionalProperties" false}
    "run" report-tool}
   {"name" "kaikei_export"
    "description" (str "Write a kaikei ledger in one of the import formats. Shift_JIS output comes back as bytes_base64, "
                       "UTF-8 as text. Fields the format cannot hold are listed in notes. Pure: writes no file.")
    "inputSchema" {"type" "object"
                   "properties" {"ledger" ledger-schema
                                 "format" {"type" "string" "enum" ingest/format-ids}
                                 "encoding" {"type" "string" "enum" enc/encodings
                                             "description" "Defaults per format (Shift_JIS for 弥生・MF・freee)."}
                                 "output_date_order" {"type" "string" "enum" common/date-orders
                                                      "description" "Date order for QBO/Xero CSV (default mdy for QBO, dmy for Xero)."}}
                   "required" ["ledger" "format"]
                   "additionalProperties" false}
    "run" export-tool}
   {"name" "kaikei_convert"
    "description" "kaikei_import followed by kaikei_export in one call: convert a journal file from one format to another."
    "inputSchema" {"type" "object"
                   "properties" (merge input-schema
                                       {"from" {"type" "string" "enum" (vec (cons "auto" ingest/format-ids)) "default" "auto"}
                                        "to" {"type" "string" "enum" ingest/format-ids}
                                        "input_encoding" {"type" "string" "enum" ["auto" "utf-8" "shift_jis"] "default" "auto"}
                                        "encoding" {"type" "string" "enum" enc/encodings}
                                        "currency" currency-schema
                                        "date_order" {"type" "string" "enum" ["mdy" "dmy"]}
                                        "output_date_order" {"type" "string" "enum" common/date-orders}})
                   "required" ["to"]
                   "additionalProperties" false}
    "run" convert-tool}
   {"name" "kaikei_invoice_totals"
    "description" (str "Per-rate totals of an invoice: for each tax rate, the consideration, the consumption tax rounded once per "
                       "invoice per rate (as a Japanese qualified invoice requires, 消費税法施行令 70 条の 10) and the total, "
                       "plus each line's share of the tax. No ledger needed; use it to draft an invoice.")
    "inputSchema" {"type" "object"
                   "properties" {"lines" {"type" "array"
                                          "items" {"type" "object"
                                                   "properties" {"description" {"type" "string"}
                                                                 "amount" {"type" ["number" "string"] "description" "Line amount in currency units (tax-exclusive or inclusive per tax_mode)."}
                                                                 "rate" {"type" ["number" "string"] "description" "Tax rate in percent, e.g. 10 or 8."}
                                                                 "reduced" {"type" "boolean" "description" "Japanese reduced rate (軽減税率)."}
                                                                 "category" {"type" "string" "enum" categories "default" "taxable"}}
                                                   "required" ["amount"]}}
                                 "tax_mode" {"type" "string" "enum" ["exclusive" "inclusive" "none"] "default" "exclusive"}
                                 "rounding" {"type" "string" "enum" ["floor" "half-up" "ceil"] "default" "floor"}
                                 "currency" currency-schema}
                   "required" ["lines"]
                   "additionalProperties" false}
    "run" invoice-totals-tool}
   {"name" "kaikei_invoice_check"
    "description" (str "Check the invoices in a kaikei ledger: missing qualified-invoice contents (issuer name and registration "
                       "number form, date, description, tax rate, per-rate tax, recipient), differences between the stated tax "
                       "and one rounding per rate, the transitional deduction percent for purchases from unregistered sellers, "
                       "and whether each invoice can be posted. Does not query the NTA or certify anything.")
    "inputSchema" {"type" "object" "properties" {"ledger" ledger-schema} "required" ["ledger"]
                   "additionalProperties" false}
    "run" invoice-check-tool}
   {"name" "kaikei_invoice_post"
    "description" (str "Post invoices in a kaikei ledger as journal entries (accounts receivable / sales / output tax, or the "
                       "purchase side) and return the updated ledger. Posts every issued or paid invoice not yet posted, or "
                       "only invoice_ids. Skips drafts, voids, invoices with withholding, and invoices already in the ledger "
                       "(e.g. from Xero Journals). Pure: returns a new ledger; nothing is stored.")
    "inputSchema" {"type" "object"
                   "properties" {"ledger" ledger-schema
                                 "invoice_ids" {"type" "array" "items" {"type" "string"}}
                                 "accounting" {"type" "string" "enum" ["tax-excluded" "tax-included"]
                                               "description" "Overrides the ledger's setting (default tax-excluded: tax goes to 仮受消費税・仮払消費税)."}}
                   "required" ["ledger"]
                   "additionalProperties" false}
    "run" invoice-post-tool}])

(def ^:private tool-by-name (into {} (map (juxt #(get % "name") identity)) tools))

;; ───────── JSON-RPC ─────────

(defn- result [id r] {"jsonrpc" "2.0" "id" id "result" r})

(defn- rpc-error [id code message]
  {"jsonrpc" "2.0" "id" id "error" {"code" code "message" message}})

(defn- to-json [v]
  #?(:cljs (.stringify js/JSON (clj->js v))
     :clj (pr-str v)))

(defn call-tool
  "tools/call の result。入力の不正は isError の結果にする。"
  [tool args]
  (try
    (let [out ((get tool "run") (or args {}))]
      {"content" [{"type" "text" "text" (to-json out)}]
       "structuredContent" out
       "isError" false})
    (catch #?(:cljs :default :clj Exception) e
      (if-let [err (::tool-error (ex-data e))]
        {"content" [{"type" "text" "text" (to-json err)}] "isError" true}
        {"content" [{"type" "text" "text" (to-json {"error" "internal-error" "detail" (ex-message e)})}]
         "isError" true}))))

(defn handle
  "JSON-RPC の 1 通（文字列キーの map）→ 応答の map。通知（id の無いもの）は nil。"
  [msg]
  (let [id (get msg "id")
        method (get msg "method")
        params (get msg "params" {})
        notification? (not (contains? msg "id"))]
    (cond
      notification? nil
      (= method "initialize")
      (result id {"protocolVersion" (let [v (get params "protocolVersion")]
                                      (if (and (string? v) (not (text/blank? v))) v default-protocol-version))
                  "capabilities" {"tools" {}}
                  "serverInfo" {"name" server-name "version" server-version}})
      (= method "ping") (result id {})
      (= method "tools/list")
      (result id {"tools" (mapv #(dissoc % "run") tools)})
      (= method "tools/call")
      (let [tool (tool-by-name (get params "name"))
            args (get params "arguments" {})]
        (cond
          (nil? tool) (rpc-error id -32602 (str "Unknown tool: " (get params "name")))
          (not (map? args)) (rpc-error id -32602 "arguments must be an object")
          :else (result id (call-tool tool args))))
      :else (rpc-error id -32601 (str "Method not found: " method)))))

(defn handle-line
  "stdin の 1 行 → 書き出す 1 行（JSON 文字列）か nil。空行は無視、読めない行は
  JSON-RPC の parse error（id null）にする。"
  [line]
  (when-not (text/blank? line)
    (let [msg (try (json/parse line) (catch #?(:cljs :default :clj Exception) _ ::bad))]
      (cond
        (= msg ::bad) (to-json (rpc-error nil -32700 "Parse error"))
        (not (map? msg)) (to-json (rpc-error nil -32600 "Invalid Request"))
        :else (some-> (handle msg) to-json)))))
